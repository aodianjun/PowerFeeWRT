#!/bin/sh /etc/rc.common
# powerfee-chat —— 微信 ClawBot 电量查询桥接（procd 服务）
#
# 安装:
#   cp powerfee-chat.py  /usr/bin/powerfee-chat   && chmod 755 /usr/bin/powerfee-chat
#   cp powerfee-chat.init /etc/init.d/powerfee-chat && chmod 755 /etc/init.d/powerfee-chat
#   cp powerfee-chat.conf.example /etc/powerfee-chat.conf && chmod 600 /etc/powerfee-chat.conf
#   /etc/init.d/powerfee-chat enable && /etc/init.d/powerfee-chat start
#
# 日志: logger -t powerfee-chat（logread -e powerfee-chat）
# 配置改动后: /etc/init.d/powerfee-chat reload

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/powerfee-chat
CONF=/etc/powerfee-chat.conf
PYTHON=/usr/bin/python3

start_service() {
	[ -x "$PROG" ] || { logger -t powerfee-chat "启动失败: 缺少可执行文件 $PROG"; return 1; }
	[ -f "$CONF" ] || { logger -t powerfee-chat "启动失败: 缺少配置文件 $CONF"; return 1; }
	procd_open_instance
	procd_set_param command "$PYTHON" "$PROG" --daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_set_param file "$CONF"
	procd_close_instance
}

reload_service() {
	restart
}
