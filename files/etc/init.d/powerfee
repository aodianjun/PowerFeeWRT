#!/bin/sh /etc/rc.common
# 宿舍电量哨兵 · OpenWrt 版 服务脚本
#
# 用 procd 常驻 /usr/bin/powerfee daemon：进程内循环查询，间隔由 UCI
# 的 powerfee.main.interval 决定（改完 uci commit 即生效，不必重启服务）。

START=99
STOP=10
USE_PROCD=1

start_service() {
	mkdir -p /etc/powerfee
	chmod 700 /etc/powerfee

	procd_open_instance
	procd_set_param command /usr/bin/powerfee daemon
	# 进程意外退出时自动拉起（60 秒内崩溃超过 5 次就放弃，避免刷日志）
	procd_set_param respawn 60 10 5
	procd_set_param stdout 0
	# stderr 进 syslog：万一脚本崩了，logread 里能看到原因（正常运行时不会有输出）
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	logger -t powerfee "服务停止"
}

reload_service() {
	logger -t powerfee "配置已重载（下一轮查询生效）"
}
