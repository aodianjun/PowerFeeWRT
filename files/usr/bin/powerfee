	# report_html_body <天数> <level> <余额>
	local _days="$1" _level="$2" _bal="$3" _ts _color _icon _status _chart_html _today_line
	_color=$(level_color "$_level")
	_icon=$(level_icon "$_level")
	_status=$(level_text "$_level")
	_ts=$(date '+%Y-%m-%d %H:%M:%S %Z')
	if [ -n "$REPORT_TODAY" ]; then
		_today_line="$REPORT_TODAY<span style=\"font-size:15px;font-weight:400;color:#5f6368\"> $API_UNIT</span><span style=\"font-size:13px;font-weight:400;color:#80868b\">（截至 $(date +%H:%M)，本地采样）</span>"
	else
		_today_line="—<span style=\"font-size:13px;font-weight:400;color:#80868b\">（今天还没有采样点）</span>"
	fi
	_chart_html=$(mail_chart_block_html "最近 $_days 天用电量")

	printf '%s' "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head>
<body style=\"margin:0;padding:16px;background:#f1f3f4;font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif\">
<div style=\"max-width:640px;margin:0 auto;background:#fff;border-radius:12px;overflow:hidden;border:1px solid #dadce0\">
<div style=\"background:$_color;padding:18px 20px;color:#fff\">
<div style=\"font-size:15px;opacity:.92\">📊 每日用电报告</div>
<div style=\"font-size:19px;font-weight:700;margin-top:6px\">$ROOM_DISPLAY</div>
</div>
<div style=\"padding:18px 20px\">
<div style=\"font-size:13px;color:#5f6368\">今日用量</div>
<div style=\"font-size:36px;font-weight:700;color:$_color;line-height:1.15;margin-top:2px\">$_today_line</div>
<table style=\"border-collapse:collapse;margin-top:12px;font-size:14px\">
<tr><td style=\"padding:6px 12px 6px 0;color:#5f6368;white-space:nowrap\">当前余额</td><td style=\"padding:6px 0;color:#202124;font-weight:600\">${_bal:-—} $API_UNIT（$_icon $_status）</td></tr>
<tr><td style=\"padding:6px 12px 6px 0;color:#5f6368;white-space:nowrap\">告警阈值</td><td style=\"padding:6px 0;color:#202124;font-weight:600\">$THRESHOLD $API_UNIT</td></tr>
<tr><td style=\"padding:6px 12px 6px 0;color:#5f6368;white-space:nowrap\">近 $_days 天</td><td style=\"padding:6px 0;color:#202124;font-weight:600\">${REPORT_SUMMARY_LINE:-—}</td></tr>
<tr><td style=\"padding:6px 12px 6px 0;color:#5f6368;white-space:nowrap\">数据来源</td><td style=\"padding:6px 0;color:#202124;font-weight:600\">${REPORT_SOURCE_TEXT:-—}</td></tr>
<tr><td style=\"padding:6px 12px 6px 0;color:#5f6368;white-space:nowrap\">生成时间</td><td style=\"padding:6px 0;color:#202124;font-weight:600\">$_ts</td></tr>
</table>
$_chart_html
</div>
<div style=\"padding:12px 20px;background:#f8f9fa;border-top:1px solid #dadce0;color:#80868b;font-size:12px\">
由 $(dev_name) 自动发送 · 宿舍电量哨兵 OpenWrt 版 v$VERSION<br>数据来自学校电费查询接口与路由器本地采样（只读查询，不做任何写操作）
</div></div></body></html>"
}

mail_alert() {
	# mail_alert <reason> <level> <余额> <日均> <天数> [补充说明] [失效小时数]
	# 通知推送与邮件同源：每个 reason 都走一遍（notify 段有自己的开关，
	# 「邮件关、通知开」也是合法组合）。推送失败只写日志，不影响下面的邮件发送。
	notify_send "$1" "$2" "$3" "$4" "$5" "$6" "$7"
	mail_send_alert "$1" "$2" "$3" "$4" "$5" "$6" "$7"
}

mail_send_alert() {
	# 只发邮件（不含推送）：mail_alert 与 mail-account test 共用
	# 参数同 mail_alert
	local _reason="$1" _level="$2" _bal="$3" _daily="$4" _days="$5" _note="$6" _hours="$7"
	local _ts _subject _eml _rc
	if [ "$MAIL_ENABLED" != "1" ]; then
		log "邮件未启用，跳过发送（原因 $_reason）"
		return 0
	fi
	[ -n "$MAIL_TO" ] || { log "未配置收件人（mail.to），跳过发送"; return 1; }
	# 发件账号有问题时已经回退到 mail 段：把原因写进日志，
	# 否则「明明配了账号却从默认邮箱发出去」会很难查
	[ -n "$MAIL_ACCT_ISSUE" ] && log "发件账号回退：$MAIL_ACCT_ISSUE"
	[ -n "$_note" ] || _note=$(mail_note "$_reason" "$_level" "$_bal" "$_hours")
	_ts=$(date '+%Y-%m-%d %H:%M:%S %Z')
	_subject=$(mail_subject "$_reason" "$_level" "$_bal" "$_hours")
	# 用量曲线：余额告警邮件带上（一眼看出趋势）；test / stale 不带（别每封都撑大）。
	# quick=1：接口超时压到 10 秒，失败就算了，绝不让画图拖慢/拖垮发信。
	mail_chart_reset
	if mail_chart_wanted "$_reason"; then
		report_chart_prepare "$REPORT_DAYS" 1 || true
	fi
	_eml=$(mktemp /tmp/powerfee.eml.XXXXXX)
	mail_build "$_eml" "$_subject" \
		"$(mail_text_body "$_level" "$_bal" "$_daily" "$_days" "$_ts" "$_note")" \
		"$(mail_html_body "$_level" "$_bal" "$_daily" "$_days" "$_ts" "$_note")" \
		"$MAIL_CHART_PNG"
	mail_send "$_eml"
	_rc=$?
	rm -f "$_eml"
	# 曲线用的临时目录（report_chart_prepare 建的）在这里收尾
	usage_tmp_clean
	return $_rc
}

# ============================================================================
# 通知推送（webhook，可接到微信 / QQ 机器人等）
#
# 与邮件完全同源：mail_alert 每次被调用都会走 notify_send（不管邮件开关如何），
# 所以 low / repeat-low / warn / recovered / stale / stale-ok / force / test
# 每个原因都会推一条；开关只看 notify 段自己的 enabled，与 mail 段互相独立。
#
# 模板占位符单遍替换（替换出来的内容不会被二次替换），值统一做 JSON 安全转义
# （反斜杠/引号/换行/制表符），中文原样透传。
# 另有 {chart}：多行文本曲线（报告推送用；换行转义成 JSON 的 \n，只适合 JSON 请求体）。
# ============================================================================

mask_secret() {
	# 密钥 -> 前 4 位 + …（已隐藏）。太短或含非 ASCII 就整个隐掉
	# （避免把多字节字符从中间截断成乱码）。
	# 注意：方括号表达式里不能出现未加引号的空格（ash 会把它当词分隔符，整段语法就废了），
	# 所以这里用 [a-zA-Z0-9._-] 取反来判"含奇怪字符"。
	local _s="$1"
	case "$_s" in
	'' | *[!a-zA-Z0-9._-]*) printf '…（已隐藏）'; return 0 ;;
	esac
	[ ${#_s} -ge 12 ] || { printf '…（已隐藏）'; return 0; }
	printf '%s…（已隐藏）' "$(printf '%s' "$_s" | cut -c1-4)"
}

mask_url() {
	# mask_url <url>：人类可见输出（status / 日志 / notify-test）里的 URL 掩码 ——
	# Server酱 的 key 段（…/<key>.send）与查询串里的 key= 值只留前 4 位。
	# 机器可读的掩码在 push.py 里（push status 的 url_masked），这里只管别把密钥
	# 写进日志或终端。识别不出密钥形态时原样返回。
	local _u="$1" _k _pre _rest
	case "$_u" in
	*.send)
		_k="${_u%.send}"
		_k="${_k##*/}"
		case "$_k" in
		*/*) ;;
		*)
			_pre="${_u%/*}"
			printf '%s/%s.send\n' "$_pre" "$(mask_secret "$_k")"
			return 0
			;;
		esac
		;;
	esac
	case "$_u" in
	*key=*)
		_pre="${_u%%key=*}"
		_rest="${_u#*key=}"
		case "$_rest" in
		*"&"*)
			_k="${_rest%%&*}"
			_rest="&${_rest#*&}"
			;;
		*)
			_k="$_rest"
			_rest=""
			;;
		esac
		printf '%s\n' "${_pre}key=$(mask_secret "$_k")${_rest}"
		return 0
		;;
	esac
	printf '%s\n' "$_u"
}

notify_text() {
	# 单行摘要（{text} 占位符与 json brief 共用）；设计上不含引号/换行/反斜杠，
	# 可直接嵌进 JSON 字符串。参数：<reason> <level> <余额> <日均> <天数> <失效小时数>
	local _reason="$1" _level="$2" _bal="$3" _daily="$4" _days="$5" _hours="$6"
	local _icon _tail
	_icon=$(level_icon "$_level")
	case "$_reason" in
	stale) echo "❗ 宿舍电量监控异常：已 ${_hours:-?} 小时未取到数据"; return 0 ;;
	stale-ok) echo "✅ 宿舍电量监控已恢复"; return 0 ;;
	test)
		# 测试消息也带上当前状态（房间 + 余额 + 阈值）：收到它既验证通道，也能直接看到数据。
		# 取不到电量时给兜底措辞，绝不让测试消息因此发不出去；约束同 {text}：单行、无引号/反斜杠。
		# 先判房间：没设房间时状态里的余额是上一个房间的陈旧值，不拿出来展示。
		if [ -z "$ROOM_NUM" ]; then
			echo "🔔 测试通知：宿舍电量哨兵（OpenWrt 版）｜尚未设置房间，无电量数据"
		elif [ -n "$_bal" ] && [ "$_bal" != "—" ] && [ "$_bal" != "-" ]; then
			echo "🔔 测试通知：宿舍电量哨兵（OpenWrt 版）｜$ROOM_DISPLAY 剩余 $_bal $API_UNIT（阈值 $THRESHOLD $API_UNIT）"
		else
			echo "🔔 测试通知：宿舍电量哨兵（OpenWrt 版）｜$ROOM_DISPLAY（尚未取到电量数据）"
		fi
		return 0
		;;
	recovered) echo "✅ 宿舍电量已恢复：$ROOM_DISPLAY 剩余 $_bal $API_UNIT"; return 0 ;;
	report)
		# 每日用电报告（单行；曲线走 {chart} 占位符，见 notify_send 的说明）
		echo "📊 每日用电报告：$ROOM_DISPLAY 今日 ${REPORT_TODAY:-—} $API_UNIT${REPORT_SUMMARY_LINE:+（$REPORT_SUMMARY_LINE）}"
		return 0
		;;
	esac
	_tail="阈值 $THRESHOLD $API_UNIT"
	if [ -n "$_days" ] && [ "$_days" != "-" ]; then
		_tail="$_tail，约可用 $_days 天"
	fi
	case "$_reason" in
	warn | *-\>*warn) echo "🔔 宿舍电量接近阈值：$ROOM_DISPLAY 剩余 $_bal $API_UNIT（$_tail）" ;;
	force) echo "$_icon 宿舍电量当前状态：$ROOM_DISPLAY 剩余 $_bal $API_UNIT（$_tail）" ;;
	*) echo "$_icon 宿舍电费不足：$ROOM_DISPLAY 仅剩 $_bal $API_UNIT（$_tail）" ;;
	esac
}

notify_urlenc() {
	# 百分号编码：保留 A-Za-z0-9 与 -_.~=&（= 和 & 继续充当查询串分隔符），
	# 其余字节（空格/引号/中文/emoji…）编码成 %XX。busybox awk 没有 ord()，
	# 用 sprintf("%c") 建 1~255 的反查表拿字节值（真机实测按字节工作）。
	printf '%s' "$1" | awk '
	BEGIN { for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i }
	{
		out = ""
		for (i = 1; i <= length($0); i++) {
			c = substr($0, i, 1)
			if (c ~ /[A-Za-z0-9_.~=&-]/) out = out c
			else if (c in ord) out = out sprintf("%%%02X", ord[c])
		}
		printf "%s", out
	}'
}

notify_render() {
	# notify_render <模板文件> <值文件>
	# 值文件每行 key=value（值里允许再出现 =）；模板里的 {key} 单遍替换，
	# 未知占位符原样保留。所有值先做 JSON 安全转义再填入。
	# 转义逐字符做（同 jesc 的注释：busybox awk 的 gsub 替换串会吃反斜杠）。
	awk '
	function esc(s,   i, c, out) {
		out = ""
		for (i = 1; i <= length(s); i++) {
			c = substr(s, i, 1)
			if (c == "\\") out = out "\\\\"
			else if (c == "\"") out = out "\\\""
			else if (c == "\t") out = out "\\t"
			else if (c == "\r") out = out "\\r"
			else out = out c
		}
		return out
	}
	NR == FNR {
		p = index($0, "=")
		if (p > 0) val[substr($0, 1, p - 1)] = esc(substr($0, p + 1))
		next
	}
	{
		line = $0
		out = ""
		while (match(line, /\{[a-z_]+\}/)) {
			out = out substr(line, 1, RSTART - 1)
			key = substr(line, RSTART + 1, RLENGTH - 2)
			if (key in val) out = out val[key]
			else out = out substr(line, RSTART, RLENGTH)
			line = substr(line, RSTART + RLENGTH)
		}
		print out line
	}
	' "$2" "$1"
}

notify_send() {
	# notify_send <reason> <level> <余额> <日均> <天数> [补充说明] [失效小时数]
	# 成功返回 0；未启用（notify.enabled=0）时静默跳过返回 0；失败写日志返回 1。
	#
	# 顺带把「这次推送的 HTTP 码与服务端正文」留在 NOTIFY_LAST_CODE / NOTIFY_LAST_RESP
	# 两个全局里（故意不 local）：有些服务端（Server酱、企业微信）出错时是
	# HTTP 200 + 正文里报错，cmd_notify_test / push.py 需要正文才能判断与转述。
	local _reason="$1" _level="$2" _bal="$3" _daily="$4" _days="$5" _note="$6" _hours="$7"
	local _ts _text _title _method _url _body _vfile _tfile _rfile _rc _code _resp _enc

	NOTIFY_LAST_CODE=""
	NOTIFY_LAST_RESP=""

	[ "$NOTIFY_ENABLED" = "1" ] || return 0
	if [ -z "$NOTIFY_URL" ]; then
		log "通知未发送（原因 $_reason）：未配置 notify.url"
		return 1
	fi

	# 缺失值统一成空串（compute_stats 的「算不出」标记 "-" 不往模板里塞）
	[ "$_daily" = "-" ] && _daily=""
	[ "$_days" = "-" ] && _days=""
	_ts=$(date '+%Y-%m-%d %H:%M:%S')
	_text=$(notify_text "$_reason" "$_level" "$_bal" "$_daily" "$_days" "$_hours")
	_title=$(mail_subject "$_reason" "$_level" "$_bal" "$_hours")

	# 值先写成 key=value 文件（值里的换行换成空格），再由 awk 单遍替换，
	# 避免把值当模板二次解析，也避免 shell 层面对特殊字符的转义问题。
	_vfile=$(mktemp /tmp/powerfee.nv.XXXXXX)
	_tfile=$(mktemp /tmp/powerfee.nt.XXXXXX)
	_rfile=$(mktemp /tmp/powerfee.nr.XXXXXX)
	{
		printf 'text=%s\n' "$(printf '%s' "$_text" | tr '\n\r' '  ')"
		printf 'title=%s\n' "$(printf '%s' "$_title" | tr '\n\r' '  ')"
		printf 'room=%s\n' "$(printf '%s' "$ROOM_DISPLAY" | tr '\n\r' '  ')"
		printf 'balance=%s\n' "$(printf '%s' "$_bal" | tr '\n\r' '  ')"
		printf 'unit=%s\n' "$(printf '%s' "$API_UNIT" | tr '\n\r' '  ')"
		printf 'level=%s\n' "$(printf '%s' "$_level" | tr '\n\r' '  ')"
		printf 'reason=%s\n' "$(printf '%s' "$_reason" | tr '\n\r' '  ')"
		printf 'daily=%s\n' "$(printf '%s' "$_daily" | tr '\n\r' '  ')"
		printf 'days_left=%s\n' "$(printf '%s' "$_days" | tr '\n\r' '  ')"
		printf 'time=%s\n' "$_ts"
		# 注意不要写成 "$(dev_name | tr ...)"：管道后的 tr 会把 dev_name 结尾的
		# 换行变成空格，命令替换又只去换行不去空格，值会多个尾随空格
		printf 'device=%s\n' "$(dev_name)"
	} >"$_vfile"
	printf '%s\n' "$NOTIFY_BODY" >"$_tfile"
	_body=$(notify_render "$_tfile" "$_vfile")
	rm -f "$_vfile" "$_tfile"
	# {chart}：多行文本曲线（可选；报告推送用）。单独一遍替换，把图里的换行
	# 转义成 JSON 的 \n（值文件是逐行的，塞不进真换行）。JSON 请求体里能正常
	# 显示成多行；GET 通道会原样带上 \n 两个字符（不推荐在 GET 模板里用 {chart}）。
	if [ -n "$NOTIFY_CHART_FILE" ] && [ -f "$NOTIFY_CHART_FILE" ]; then
		_body=$(printf '%s' "$_body" | awk -v cf="$NOTIFY_CHART_FILE" '
		function esc(s,   i, c, out) {
			out = ""
			for (i = 1; i <= length(s); i++) {
				c = substr(s, i, 1)
				if (c == "\\") out = out "\\\\"
				else if (c == "\"") out = out "\\\""
				else out = out c
			}
			return out
		}
		BEGIN {
			chart = ""
			n = 0
			while ((getline line < cf) > 0) {
				if (n++) chart = chart "\\n"
				chart = chart esc(line)
			}
			close(cf)
		}
		{
			line = $0
			out = ""
			while ((i = index(line, "{chart}")) > 0) {
				out = out substr(line, 1, i - 1) chart
				line = substr(line, i + 7)
			}
			print out line
		}')
	fi

	_method=$(printf '%s' "$NOTIFY_METHOD" | tr 'a-z' 'A-Z')
	_url="$NOTIFY_URL"
	if [ "$_method" = "GET" ]; then
		# GET：渲染结果做百分号编码后当 query string 拼到 url 后面。
		# 必须编码：{text} 里有空格/中文/emoji，curl 遇到空格会直接判 URL 非法
		# （退出码 3）；= 与 & 保留，继续充当参数分隔符。
		if [ -n "$_body" ]; then
			_enc=$(notify_urlenc "$_body")
			case "$_url" in
			*\?*) _url="$_url&$_enc" ;;
			*) _url="$_url?$_enc" ;;
			esac
		fi
		# -g（--globoff）：url 里可能带 { }，curl 默认会把它们当 URL 通配符解析
		# （退出码 3），加 -g 才能原样发出去
		if [ -n "$NOTIFY_TOKEN" ]; then
			_code=$(curl -g -s -m "$NOTIFY_TIMEOUT" -o "$_rfile" -w '%{http_code}' \
				-H "$NOTIFY_TOKEN_HEADER: $NOTIFY_TOKEN" "$_url" 2>/dev/null)
		else
			_code=$(curl -g -s -m "$NOTIFY_TIMEOUT" -o "$_rfile" -w '%{http_code}' "$_url" 2>/dev/null)
		fi
	else
		if [ -n "$NOTIFY_TOKEN" ]; then
			_code=$(curl -s -m "$NOTIFY_TIMEOUT" -o "$_rfile" -w '%{http_code}' \
				-X POST -H "Content-Type: $NOTIFY_CONTENT_TYPE" \
				-H "$NOTIFY_TOKEN_HEADER: $NOTIFY_TOKEN" \
				--data "$_body" "$_url" 2>/dev/null)
		else
			_code=$(curl -s -m "$NOTIFY_TIMEOUT" -o "$_rfile" -w '%{http_code}' \
				-X POST -H "Content-Type: $NOTIFY_CONTENT_TYPE" \
				--data "$_body" "$_url" 2>/dev/null)
		fi
	fi
	_rc=$?
	if [ "$_rc" != "0" ]; then
		_resp=$(head -c 200 "$_rfile" 2>/dev/null | tr -d '\r\n')
		NOTIFY_LAST_RESP=$(head -c 400 "$_rfile" 2>/dev/null | tr -d '\r\n')
		rm -f "$_rfile"
		log "通知推送失败（原因 $_reason）：curl 退出码 $_rc（$_method $(mask_url "$NOTIFY_URL")）${_resp:+：$_resp}"
		return 1
	fi
	case "$_code" in
	2*) ;;
	*)
		_resp=$(head -c 200 "$_rfile" 2>/dev/null | tr -d '\r\n')
		NOTIFY_LAST_CODE="$_code"
		NOTIFY_LAST_RESP=$(head -c 400 "$_rfile" 2>/dev/null | tr -d '\r\n')
		rm -f "$_rfile"
		log "通知推送失败（原因 $_reason）：HTTP $_code（$_method $(mask_url "$NOTIFY_URL")）${_resp:+：$_resp}"
		return 1
		;;
	esac
	NOTIFY_LAST_CODE="$_code"
	NOTIFY_LAST_RESP=$(head -c 400 "$_rfile" 2>/dev/null | tr -d '\r\n')
	_resp=$(head -c 200 "$_rfile" 2>/dev/null | tr -d '\r\n')
	rm -f "$_rfile"
	# 成功也把正文带上：Server酱 / 企业微信 出错时是 HTTP 200 + 正文报错，
	# 只写「HTTP 200」会让日志看起来像成功（push status 的 last_push 也读这行）
	log "通知已推送（原因 $_reason）：HTTP $_code${_resp:+：$_resp}"
	return 0
}

# ============================================================================
# 核心：查一次（多房间时：一次请求，逐房间判定与提醒）
# ============================================================================

room_refresh_name() {
	# 接口返回的展示名与配置不一致时刷新配置（1.0.x 对单房间也这么做）。
	# 参数：<接口campus> <接口building> <接口name> <配置campus> <配置building> <配置name> <main|段名>
	# 返回 0 = 有字段被刷新（调用方需要同步内存里的值）
	local _c="$1" _b="$2" _n="$3" _cc="$4" _cb="$5" _cn="$6" _sec="$7" _pre _changed=0
	[ -n "$_n" ] || return 1
	if [ "$_sec" = "main" ]; then _pre="powerfee.main"; else _pre="powerfee.$_sec"; fi
	# 接口没返回的字段不动（避免把用户手工填的楼栋/校区刷成空）
	if [ -n "$_c" ] && [ "$_c" != "$_cc" ]; then pf_uci -q set "$_pre.campus=$_c"; _changed=1; fi
	if [ -n "$_b" ] && [ "$_b" != "$_cb" ]; then pf_uci -q set "$_pre.building=$_b"; _changed=1; fi
	if [ "$_n" != "$_cn" ]; then pf_uci -q set "$_pre.room=$_n"; _changed=1; fi
	[ "$_changed" = "1" ] || return 1
	pf_uci -q commit powerfee
	log_room "房间展示名已刷新为：$_b $_n"
	return 0
}

check_room_fail() {
	# 一个房间的失败记账 + 监控失效（stale）告警
	# 参数：<now> <consec_fail> <poll_count> <last_ok_at> <stale_alerted> <错误信息>
	local _now="$1" _cf="$2" _pc="$3" _lok="$4" _sa="$5" _err="$6" _elapsed
	_cf=$((_cf + 1))
	state_set last_level unknown last_error "$_err" consec_fail "$_cf" poll_count $((_pc + 1))
	log_room "查询失败（连续 $_cf 次）：$_err"
	# 监控失效告警：避免「以为在看，其实早瞎了」
	if [ "$NOTIFY_ERROR" = "1" ] && [ -n "$_lok" ] && [ "$_lok" != "0" ]; then
		_elapsed=$(( (_now - _lok) / 3600 ))
		if [ "$_elapsed" -ge "$STALE_HOURS" ] && [ "$_sa" != "1" ]; then
			if mail_alert stale unknown "" "-" "-" "" "$_elapsed"; then
				state_set stale_alerted 1 last_alert_at "$_now" last_alert_reason stale
			fi
		fi
	fi
}

check_one_room() {
	# 一个房间的完整一轮：取值 → 判定 → 落状态 → 提醒。
	# 收件人与推送通道取自「当前房间」全局（room_apply_env 设好），
	# 所以每个房间只发给自己的收件人/通道。
	# 参数：<force> <now> <fetch_ok>
	local _force="$1" _now="$2" _fetch_ok="$3"
	local _prev_level _prev_alert_at _last_ok_at _poll_count _consec_fail _stale_alerted
	local _err _balance _level _reason _stats _daily _days _fc _fb _fn _fbal _fid
	[ "$R_ENABLED" = "1" ] || return 0

	_prev_level=$(state_get last_level)
	# 新房间/新装的第一次查询：状态里没有档位，按 unknown 处理
	# （否则提醒原因会写成「->low」而不是界面能识别的「unknown->low」）
	[ -n "$_prev_level" ] || _prev_level=unknown
	_prev_alert_at=$(state_get last_alert_at)
	_last_ok_at=$(state_get last_ok_at)
	_poll_count=$(state_get poll_count)
	[ -n "$_poll_count" ] || _poll_count=0
	_consec_fail=$(state_get consec_fail)
	[ -n "$_consec_fail" ] || _consec_fail=0
	_stale_alerted=$(state_get stale_alerted)
	[ -n "$_stale_alerted" ] || _stale_alerted=0

	if [ "$_fetch_ok" != "1" ]; then
		check_room_fail "$_now" "$_consec_fail" "$_poll_count" "$_last_ok_at" "$_stale_alerted" "$FETCH_ERR"
		return 1
	fi

	# ---- 取值（一次遍历取回该房间的所有字段）----
	# ROOM_TMP 由 cmd_check 建好；这里兜一层，免得将来别处调用时写出空路径
	[ -n "$ROOM_TMP" ] || ROOM_TMP=$(mktemp /tmp/powerfee.room.XXXXXX)
	room_fields_line "$R_NUM" >"$ROOM_TMP"
	IFS="$TAB" read -r _fc _fb _fn _fbal _fid <"$ROOM_TMP"

	if [ -z "$_fbal" ]; then
		# 区分「房间不在列表里」和「房间在但没余额字段」——两者的处理完全不同
		if [ -n "$_fid" ]; then
			_err="房间 $R_NUM（$R_DISPLAY）没有余额字段（field_balance=${API_FIELD_BALANCE}），可能未接入电表"
		else
			_err="房间 $R_NUM（$R_DISPLAY）不在接口返回的列表里，编号可能变了（用 powerfee rooms 重新搜）"
		fi
		state_set last_level unknown last_error "$_err" poll_count $((_poll_count + 1))
		log_room "$_err"
		return 1
	fi
	if ! echo "$_fbal" | grep -Eq '^-?[0-9]+(\.[0-9]+)?$'; then
		_err="余额字段格式异常：$_fbal"
		state_set last_error "$_err" last_level unknown poll_count $((_poll_count + 1))
		log_room "$_err"
		return 1
	fi
	_balance="$_fbal"
	_level=$(level_of "$_balance" "$R_THRESHOLD" "$WARN_RATIO")

	# 房间名若被改过，顺手刷新配置里的展示名
	if room_refresh_name "$_fc" "$_fb" "$_fn" "$R_CAMPUS" "$R_BUILDING" "$R_NAME" "$R_SECTION"; then
		R_CAMPUS="$_fc"
		R_BUILDING="$_fb"
		R_NAME="$_fn"
		R_DISPLAY=$(room_display_of)
		room_campus_suffix_set
		room_apply_env
	fi

	# ---- 判定 ----
	if [ "$_force" = "1" ]; then
		_reason="force"
	else
		_reason=$(decide_notify "$_prev_level" "$_prev_alert_at" "$_level" "$_now" \
			"$COOLDOWN" "$NOTIFY_WARN" "$NOTIFY_RECOVERY")
	fi

	# ---- 落状态 ----
	history_append "$_now" "$_balance"
	state_set last_balance "$_balance" last_level "$_level" last_ok_at "$_now" \
		last_error "" consec_fail 0 poll_count $((_poll_count + 1)) stale_alerted 0

	_stats=$(compute_stats "$HISTORY_FILE" "$_balance" "$_now")
	_daily=$(echo "$_stats" | awk '{print $1}')
	_days=$(echo "$_stats" | awk '{print $2}')

	# 监控从失效中恢复：补一条「已恢复」
	if [ "$_stale_alerted" = "1" ] && [ "$NOTIFY_ERROR" = "1" ] && [ "$_reason" = "" ]; then
		if mail_alert stale-ok "$_level" "$_balance" "$_daily" "$_days"; then
			state_set last_alert_at "$_now" last_alert_reason stale-ok
			_prev_alert_at="$_now"
			log_room "监控已恢复：$_balance $API_UNIT"
		fi
	fi

	# ---- 告警 ----
	if [ -n "$_reason" ]; then
		if mail_alert "$_reason" "$_level" "$_balance" "$_daily" "$_days"; then
			state_set last_alert_at "$_now" last_alert_reason "$_reason"
		fi
	fi

	log_room "查询成功：$_balance $API_UNIT（$_level）$([ -n "$_reason" ] && echo "，提醒 $_reason")"
	return 0
}

cmd_check() {
	local _force="$1" _now _rc=0 _id _valid=0

	[ "$MAIN_ENABLED" = "1" ] || { log "配置里已关闭监控（main.enabled=0）"; return 0; }

	# ---- 查询时段（active_hours）----
	if [ "$_force" != "1" ]; then
		if ! in_active_window; then
			active_pause_mark
			CHECK_SKIPPED=1
			log "不在查询时段（active_hours=$ACTIVE_HOURS），本轮不查询（powerfee check --force 可强制查一次）"
			return 0
		fi
	fi
	active_pause_resume

	# ---- 房间 ----
	if [ "$ROOM_COUNT" -eq 0 ]; then
		if [ -z "$MAIN_ROOM_NUM" ]; then
			log "尚未选择宿舍房间，跳过查询（用 powerfee set-room <房间号> 设置）"
			return 0
		fi
	else
		for _id in $ROOM_IDS; do
			room_load "$_id" && _valid=$((_valid + 1))
		done
		if [ "$_valid" -eq 0 ]; then
			log "多房间模式下没有任何有效房间（config room 段缺少 num），跳过查询"
			return 0
		fi
		rooms_migrate_legacy
	fi

	_now=$(now_epoch)
	ROOM_TMP=$(mktemp /tmp/powerfee.room.XXXXXX)

	# ---- 查询（多个房间合并成一次请求）----
	if fetch_rooms; then
		_FETCH_OK=1
		FETCH_ERR=""
	else
		_FETCH_OK=0
		FETCH_ERR=$(head -2 "$ERR_TMP" | tr '\n' ' ')
		_rc=1
	fi

	rooms_each check_one_room "$_force" "$_now" "$_FETCH_OK"

	rm -f "$ROOM_TMP"
	return $_rc
}

# ============================================================================
# 命令
# ============================================================================

cmd_status() {
	local _bal _level _err _stats _daily _days _reason _kind _id _ok _pc _n=0 _sf
	echo "宿舍电量哨兵 · OpenWrt 版 v$VERSION"
	echo "--------------------------------"
	if [ "$ROOM_COUNT" -gt 0 ]; then
		# ---- 多房间模式：逐房间列出余额与状态 ----
		echo "监控房间    ：$ROOM_COUNT 个（多房间模式）"
		for _id in $ROOM_IDS; do
			if ! room_load "$_id"; then
				echo "  房间 $_id ：（缺少 num 编号，未生效；用 powerfee room-set $_id num <编号> 补上）"
				continue
			fi
			_n=$((_n + 1))
			room_apply_env
			room_state_load
			_bal="$RS_BALANCE"
			_level="$RS_LEVEL"
			_err="$RS_ERR"
			echo "  房间 #$_n  ：$ROOM_DISPLAY${CAMPUS_SUFFIX:+（$CAMPUS_SUFFIX）}  [编号 $ROOM_NUM]  ← $_id$([ "$R_ENABLED" = "1" ] || echo "（已停用）")"
			echo "      余额  ：${_bal:-—} $API_UNIT（$(level_icon "$_level") $(level_text "$_level")，阈值 $THRESHOLD $API_UNIT）"
			if [ -n "$RS_DAILY" ]; then
				echo "      用量  ：约 $RS_DAILY $API_UNIT/天，预计可用 $RS_DAYS 天"
			fi
			echo "      查询  ：$(fmt_time "$RS_OK_AT")，累计 ${RS_POLL:-0} 次$([ -n "$_err" ] && echo "（最近一次失败：$_err）")"
			echo "      送达  ：$(room_delivery_text)"
			[ -n "$RS_ALERT_REASON" ] && echo "      提醒  ：$(fmt_time "$RS_ALERT_AT")（$RS_ALERT_REASON）"
		done
		rooms_select_default
	else
		if [ -z "$MAIN_ROOM_NUM" ]; then
			echo "房间        ：（未设置）—— powerfee rooms 搜索，powerfee set-room <房间号> 设置"
			echo "              多房间：powerfee room-add <房间号>（每个房间独立收件人/推送）"
		else
			room_state_load
			_bal="$RS_BALANCE"
			_level="$RS_LEVEL"
			_err="$RS_ERR"
			echo "房间        ：$ROOM_DISPLAY${CAMPUS_SUFFIX:+（$CAMPUS_SUFFIX）}  [编号 $ROOM_NUM]"
			echo "当前余额    ：${_bal:-—} $API_UNIT"
			echo "状态        ：$(level_icon "$_level") $(level_text "$_level")（阈值 $THRESHOLD $API_UNIT / 预警区 $THRESHOLD × $WARN_RATIO）"
			if [ -n "$RS_DAILY" ]; then
				echo "日均用量    ：约 $RS_DAILY $API_UNIT/天"
			fi
			if [ -n "$RS_DAYS" ]; then
				echo "预计可用    ：约 $RS_DAYS 天"
			fi
			echo "上次查询    ：$(fmt_time "$RS_OK_AT")$([ -n "$_err" ] && echo "（最近一次失败：$_err）")"
			_reason="$RS_ALERT_REASON"
			[ -n "$_reason" ] && echo "上次提醒    ：$(fmt_time "$RS_ALERT_AT")（$_reason）"
			echo "累计查询    ：${RS_POLL:-0} 次"
			echo "送达        ：$(room_delivery_text)"
		fi
	fi
	echo "查询时段    ：$(active_window_text)"
	echo "查询间隔    ：$([ "$INTERVAL" -ge 60 ] && echo "$((INTERVAL / 60)) 分钟" || echo "$INTERVAL 秒")"
	if [ "$MAIL_ENABLED" = "1" ]; then
		_kind=$(mailer_available)
		echo "邮件提醒    ：已启用 → $(echo "$MAIL_TO" | tr -d ' ' | tr ',' ' ')（$MAIL_HOST:$MAIL_PORT $MAIL_SECURITY，投递方式 ${_kind:-无}）"
	else
		echo "邮件提醒    ：未启用（mail.enabled=0）"
	fi
	if [ "$NOTIFY_ENABLED" = "1" ]; then
		echo "通知推送    ：已启用 → $(printf '%s' "$NOTIFY_METHOD" | tr 'a-z' 'A-Z') $(mask_url "$NOTIFY_URL")"
	else
		echo "通知推送    ：未启用（notify.enabled=0）"
	fi
	if [ "$MAIL_ACCT_COUNT" -gt 0 ] || [ "$PUSH_ACCT_COUNT" -gt 0 ]; then
		echo "命名账号    ：发件 $MAIL_ACCT_COUNT 个$([ "$MAIL_ACCT_COUNT" -gt 0 ] && echo "（$(echo "$MAIL_ACCT_IDS" | tr ' ' '、')）") ｜ 推送 $PUSH_ACCT_COUNT 个$([ "$PUSH_ACCT_COUNT" -gt 0 ] && echo "（$(echo "$PUSH_ACCT_IDS" | tr ' ' '、')）")"
		echo "              （每个房间用哪个账号见上面的「送达」行；powerfee mail-account list / push-account list 看详情）"
	fi
	if [ -n "$ACCT_ISSUE_MSGS" ]; then
		echo "账号告警    ：以下引用有问题，已回退到默认段（提醒不会消失）"
		printf '%s' "$ACCT_ISSUE_MSGS" | tr '\t' '\n' | while IFS='|' read -r _k _n _m; do
			[ -n "$_k" ] && echo "  - [$_k] $_m"
		done
	fi
	[ -x /etc/init.d/powerfee ] && echo "服务状态    ：$(/etc/init.d/powerfee status 2>/dev/null || echo 未知)"
}

room_delivery_text() {
	# 「这个房间的提醒发给谁」的一句话描述（status / room-list 用）。
	# 没启用的通道也把配置显示出来（方便看出「配了但没开」这种常见状态）；
	# 1.2.0 起同时显示发件账号与推送账号（默认段显示「默认段」），
	# 账号有问题（不存在/停用/缺字段，已回退）时把原因附在末尾。
	local _t="" _mail _push _acc _issue _ch
	_acc="默认段"
	[ -n "$MAIL_ACCOUNT_EFFECTIVE" ] && _acc="$MAIL_ACCOUNT_EFFECTIVE"
	if [ -n "$MAIL_TO" ]; then
		if [ "$MAIL_ENABLED" = "1" ]; then
			_mail="邮件 → $_acc → $(echo "$MAIL_TO" | tr -d ' ')"
		else
			_mail="邮件 → 未启用（$_acc → $(echo "$MAIL_TO" | tr -d ' ')）"
		fi
	else
		_mail="邮件 → 未配置收件人"
	fi
	_acc="默认段"
	[ -n "$NOTIFY_ACCOUNT_EFFECTIVE" ] && _acc="$NOTIFY_ACCOUNT_EFFECTIVE"
	_ch=$(notify_channel_name "$NOTIFY_CHANNEL")
	if [ -n "$NOTIFY_URL" ]; then
		if [ "$NOTIFY_ENABLED" = "1" ]; then
			_push="推送 → $_acc/$_ch → $(printf '%s' "$NOTIFY_METHOD" | tr 'a-z' 'A-Z') $(mask_url "$NOTIFY_URL")"
		else
			_push="推送 → 未启用（$_acc/$_ch → $(printf '%s' "$NOTIFY_METHOD" | tr 'a-z' 'A-Z') $(mask_url "$NOTIFY_URL")）"
		fi
	else
		_push="推送 → 未配置地址"
	fi
	_t="$_mail ｜ $_push"
	_issue=""
	[ -n "$MAIL_ACCT_ISSUE" ] && _issue="$MAIL_ACCT_ISSUE"
	[ -n "$NOTIFY_ACCT_ISSUE" ] && _issue="${_issue:+$_issue；}$NOTIFY_ACCT_ISSUE"
	[ -n "$_issue" ] && _t="$_t ｜ 账号问题：$_issue"
	printf '%s' "$_t"
}

cmd_rooms() {
	# cmd_rooms [关键词]：列出房间（按配置的字段映射解析）
	local _keyword="$1" _rows _rc
	fetch_rooms || { cat "$ERR_TMP" >&2; return 1; }
	_rows=$(jsonfilter -i "$API_TMP" -e "$API_ROOMS_PATH" 2>/dev/null)
	if [ -z "$_rows" ]; then
		echo "接口返回里没有房间列表（检查 api.rooms_path=${API_ROOMS_PATH} 是否指向房间数组）" >&2
		return 1
	fi
	printf '%s\n' "$_rows" | awk -v kw="$_keyword" \
		-v fc="$API_FIELD_CAMPUS" -v fb="$API_FIELD_BUILDING" \
		-v fr="$API_FIELD_NAME" -v fv="$API_FIELD_BALANCE" -v unit="$API_UNIT" "$AWK_JGET"'
		{
			c = jget($0, fc); b = jget($0, fb); r = jget($0, fr); v = jget($0, fv)
			if (kw != "" && index(r, kw) == 0 && index(b, kw) == 0 && index(c, kw) == 0) next
			n++
			printf "%-6s %-16s %-12s %9s %s\n", c, b, r, v, unit
		}
		END { if (n == 0) exit 3 }
	'
	_rc=$?
	if [ "$_rc" = "3" ]; then
		echo "没有匹配「$_keyword」的房间（换个更短的关键词，或 powerfee rooms 看全部）"
		return 1
	fi
}

cmd_set_room() {
	local _query="$1" _obj _num _campus _building _room _bal
	[ -n "$_query" ] || die "用法：powerfee set-room <房间号，如 A101>"
	if [ "$ROOM_COUNT" -gt 0 ]; then
		echo "当前是多房间模式（已有 $ROOM_COUNT 个 config room 段），set-room 只作用于单房间模式。" >&2
		echo "请改用：powerfee room-add <房间号>（新增房间），powerfee room-set <段名> num <编号>（改编号）" >&2
		echo "要回到单房间模式：先 powerfee room-remove <段名> 删掉全部 config room 段" >&2
		return 1
	fi
	fetch_rooms || { cat "$ERR_TMP" >&2; return 1; }
	# 先按房间名匹配，再退回按编号匹配
	_obj=$(room_obj "$_query" "$API_FIELD_NAME")
	[ -n "$_obj" ] || _obj=$(room_obj "$_query" "$API_FIELD_ID")
	if [ -z "$_obj" ]; then
		echo "没有找到房间「$_query」。以下为模糊匹配结果："
		cmd_rooms "$_query"
		return 1
	fi
	_num=$(room_field_of "$_obj" id)
	_campus=$(room_field_of "$_obj" campus)
	_building=$(room_field_of "$_obj" building)
	_room=$(room_field_of "$_obj" name)
	_bal=$(room_field_of "$_obj" balance)

	pf_uci -q set powerfee.main.room_num="$_num"
	pf_uci -q set powerfee.main.campus="$_campus"
	pf_uci -q set powerfee.main.building="$_building"
	pf_uci -q set powerfee.main.room="$_room"
	pf_uci -q commit powerfee
	state_clear

	echo "已设置监控房间：$_building $_room（$_campus）"
	echo "编号=$_num，当前余额 $_bal $API_UNIT"
	echo "上一个房间的运行状态与历史已清空（与另两个客户端换房间的行为一致）"
	echo "提示：powerfee check 可立即查一次，之后由服务按间隔自动查询"
}

# ---- 多房间管理（config room 段）--------------------------------------------

room_write_kv() {
	# room_write_kv <段名> <key=value> [key=value ...]：批量写房间字段，只 commit 一次
	local _id="$1" _kv _key _val
	[ -n "$_id" ] || { echo "缺少段名" >&2; return 1; }
	shift
	[ $# -gt 0 ] || { echo "没有要写入的字段" >&2; return 1; }
	for _kv in "$@"; do
		case "$_kv" in
		*=*) ;;
		*)
			echo "参数要写成 键=值 的形式：$_kv" >&2
			return 1
			;;
		esac
		_key="${_kv%%=*}"
		_val="${_kv#*=}"
		case "$_key" in
		num | label | campus | building | room | threshold | mail_to | mail_account | notify_account | notify_url | notify_token | notify_enabled | enabled) ;;
		*)
			echo "不支持的键：$_key（可用：num label campus building room threshold mail_to mail_account notify_account notify_url notify_token notify_enabled enabled）" >&2
			return 1
			;;
		esac
		pf_uci -q set "powerfee.$_id.$_key=$_val" || { echo "写入失败：powerfee.$_id.$_key" >&2; return 1; }
	done
	pf_uci -q commit powerfee || { echo "uci commit powerfee 失败" >&2; return 1; }
	return 0
}

cmd_room_list() {
	# 列出已配置的监控房间（含每个房间的余额、状态、收件人与推送通道）
	local _id _n=0
	if [ "$ROOM_COUNT" -eq 0 ]; then
		if [ -n "$MAIN_ROOM_NUM" ]; then
			echo "当前是单房间模式（没有 config room 段）：$MAIN_ROOM_DISPLAY  [编号 $MAIN_ROOM_NUM]"
			echo "想给多个房间分别设置收件人 / 推送通道：powerfee room-add <房间号>"
		else
			echo "还没有配置任何房间。"
			echo "单房间：powerfee set-room <房间号>；多房间：powerfee room-add <房间号>"
			echo "搜索房间：powerfee rooms <关键词>"
		fi
		return 0
	fi
	echo "已配置 $ROOM_COUNT 个监控房间："
	for _id in $ROOM_IDS; do
		if ! room_load "$_id"; then
			echo "  [$_id]（缺少 num 编号，未生效；powerfee room-set $_id num <编号>）"
			continue
		fi
		_n=$((_n + 1))
		room_apply_env
		room_state_load
		echo "  [$R_SECTION] $ROOM_DISPLAY${CAMPUS_SUFFIX:+（$CAMPUS_SUFFIX）}  [编号 $R_NUM]$([ "$R_ENABLED" = "1" ] || echo "（已停用）")"
		echo "      余额 ${RS_BALANCE:-—} $API_UNIT（$(level_icon "$RS_LEVEL") $(level_text "$RS_LEVEL")，阈值 $R_THRESHOLD $API_UNIT）· 上次查询 $(fmt_time "$RS_OK_AT") · 累计 ${RS_POLL:-0} 次"
		echo "      送达 $(room_delivery_text)"
		[ -n "$RS_ERR" ] && echo "      最近一次失败：$RS_ERR"
	done
	rooms_select_default
	return 0
}

# ---- 批量添加（room-add 多个目标；只拉取一次房间列表）------------------------
#
# 关键性能约定：一次接口请求（响应可能有近 1 MB）匹配任意多个目标 ——
# cmd_room_add_many 里只调用一次 fetch_rooms（selftest 用源码断言钉住这一点），
# 绝不要改成「每个房间拉一次」。

room_seg_bump() {
	# room_seg_bump <段名>：末尾数字 +1（room2 -> room3、room9 -> room10）；
	# 没有末尾数字就追加 2（dorm -> dorm2）。纯函数，selftest 直接测。
	local _b="$1" _num _pre
	_num="${_b##*[!0-9]}"
	if [ -z "$_num" ]; then
		printf '%s2' "$_b"
		return 0
	fi
	_pre="${_b%"$_num"}"
	_num=$(dec_of "$_num")
	printf '%s%s' "$_pre" "$((_num + 1))"
}

room_seg_pick() {
	# room_seg_pick <段名前缀，空 = roomN> <第几个目标 n，从 1 起> <已占用的段名（空格分隔）>
	# 打印可用的段名；没有可用名返回 1。纯函数（不读 uci），selftest 直接测。
	# 前缀为空：取第一个空闲的 roomN（与单个添加一致）。
	# 有前缀：第 1 个目标用前缀本身（占用与否由调用方报错），之后逐个递增并跳过已占用的名字。
	local _base="$1" _n="$2" _taken=" $3 " _cand _k
	if [ -z "$_base" ]; then
		_k=1
		while [ "$_k" -le 100 ]; do
			_cand="room$_k"
			case "$_taken" in
			*" $_cand "*) _k=$((_k + 1)) ;;
			*) printf '%s' "$_cand"; return 0 ;;
			esac
		done
		return 1
	fi
	_cand="$_base"
	_k=1
	while [ "$_k" -lt "$_n" ]; do
		_cand=$(room_seg_bump "$_cand")
		_k=$((_k + 1))
	done
	if [ "$_n" -gt 1 ]; then
		_k=0
		while [ "$_k" -lt 100 ]; do
			case "$_taken" in
			*" $_cand "*) _cand=$(room_seg_bump "$_cand"); _k=$((_k + 1)) ;;
			*) break ;;
			esac
		done
	fi
	printf '%s' "$_cand"
	return 0
}

rooms_match_line() {
	# rooms_match_line <房间元素文件（jsonfilter 输出，一行一个元素）> <目标编号或房间名>
	# 先按编号（api.field_id）匹配，没有再按房间名（api.field_name）—— 与界面单个添加一致。
	# 打印匹配到的那一行；没匹配到打印空。纯函数（不读接口/uci），selftest 直接测。
	local _file="$1" _want="$2"
	awk -v want="$_want" -v fi="$API_FIELD_ID" -v fr="$API_FIELD_NAME" "$AWK_JGET"'
		{
			if (done) next
			if (jget($0, fi) == want) { print; done = 1; next }
			if (!fb && jget($0, fr) == want) { fb_line = $0; fb = 1 }
		}
		END { if (!done && fb) print fb_line }' "$_file" 2>/dev/null
}

room_add_scan() {
	# room_add_scan <参数…>：数出有几个「目标」（非选项参数），并记录是否出现 --batch。
	# 结果放全局 PF_ADD_TARGETS / PF_ADD_BATCH（cmd_room_add 与 json 分发共用）。
	PF_ADD_TARGETS=0
	PF_ADD_BATCH=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--id | --num | --label | --mail-to | --notify-url | --notify-token | --threshold) shift ;;
		--batch) PF_ADD_BATCH=1 ;;
		*) PF_ADD_TARGETS=$((PF_ADD_TARGETS + 1)) ;;
		esac
		[ $# -gt 0 ] && shift
	done
	return 0
}

room_add_report() {
	# room_add_report <结果文件> <目标> <编号> <段名> <ok|skip|fail> <说明>
	# 往结果文件追加一行 JSON（给 json room-add 的 results[] 用）；文件为空表示不写。
	local _f="$1" _t="$2" _num="$3" _id="$4" _st="$5" _msg="$6" _ok _skip
	[ -n "$_f" ] || return 0
	case "$_st" in fail) _ok=false ;; *) _ok=true ;; esac
	case "$_st" in skip) _skip=true ;; *) _skip=false ;; esac
	printf '{"target":%s,"num":%s,"id":%s,"ok":%s,"skipped":%s,"message":%s}\n' \
		"$(json_str "$_t")" "$(json_str "$_num")" "$(json_str "$_id")" \
		"$_ok" "$_skip" "$(json_str "$_msg")" >>"$_f"
}

room_add_results_json() {
	# 把批量结果文件拼成 JSON 数组（最后一行是 added=… 汇总行，不算结果）
	local _f="$1"
	if [ -z "$_f" ] || [ ! -s "$_f" ]; then
		printf '[]'
		return 0
	fi
	printf '['
	awk '{ lines[NR] = $0 } END { for (i = 1; i < NR; i++) { if (i > 1) printf ","; printf "%s", lines[i] } }' "$_f"
	printf ']'
}

room_add_summary() {
	# room_add_summary <成功> <跳过> <失败>：打印汇总行并返回退出码
	# （全部成功/只有跳过 -> 0；有失败 -> 1）。纯函数，selftest 直接测。
	printf '汇总：成功 %s 个，跳过 %s 个，失败 %s 个（共 %s 个）\n' \
		"$1" "$2" "$3" "$(( $1 + $2 + $3 ))"
	[ "$3" -eq 0 ] && return 0
	return 1
}

cmd_room_add_many() {
	# room-add <目标1> [<目标2> …] [选项]：批量添加（cmd_room_add 在目标数 > 1 或带 --batch 时转到这里）
	# 一次接口请求匹配全部目标；每个房间独立写 config room 段；已在监控的按编号去重跳过；
	# 逐房间报告，最后汇总。部分失败不整体失败（能加的都加上）。
	# 退出码：全部成功 0；有失败（没找到 / 段名被占 / 写配置失败）非 0。
	local _id_base="" _label="" _mail_to="" _notify_url="" _notify_token="" _threshold=""
	local _n=$# _t _line _num _campus _building _room _bal _id _disp _sec _skipwhy
	local _ok=0 _skip=0 _fail=0 _i=0 _taken="" _added="" _lines="" _owned=""
	local _results="${PF_ADD_RESULTS_FILE:-}"
	while [ "$_n" -gt 0 ]; do
		# 选项可以与目标混排：处理过的目标会被轮转到参数表末尾，顺序不变
		case "$1" in
		--id | --label | --mail-to | --notify-url | --notify-token | --threshold)
			if [ "$_n" -lt 2 ]; then
				echo "选项 $1 缺少值" >&2
				return 1
			fi
			case "$1" in
			--id) _id_base="$2" ;;
			--label) _label="$2" ;;
			--mail-to) _mail_to="$2" ;;
			--notify-url) _notify_url="$2" ;;
			--notify-token) _notify_token="$2" ;;
			--threshold) _threshold="$2" ;;
			esac
			shift
			_n=$((_n - 1))
			;;
		--num)
			echo "批量添加不支持 --num：把编号直接当参数传（--num 只用于单个目标）" >&2
			return 1
			;;
		--batch) ;;
		-h | --help)
			cat <<EOF
用法：powerfee room-add <编号1> [<编号2> …] [选项]

一次把多个房间加入监控：只请求接口一次，每个房间独立写一个 config room 段。
选项与单个添加相同（对所有目标生效）：

  --id <段名>          段名前缀：第一个房间用它，之后自动递增（room2 -> room3、dorm -> dorm2）；
                       不指定则每个房间各取第一个空闲的 roomN
  --label <展示名>     邮件/通知里显示的房名（默认用「楼栋 房间」）
  --mail-to <邮箱>     收件人（多个用逗号分隔；默认继承 mail.to）
  --notify-url <地址>  推送地址（默认继承 notify.url）
  --notify-token <令牌> 推送令牌（默认继承 notify.token）
  --threshold <度>     告警阈值（默认继承 main.threshold）

逐行报告每个房间的结果（成功 / 跳过：已在监控 / 失败），最后一行汇总；
全部成功退出码 0，有失败非 0。已经在监控里的房间（编号相同）会跳过，不会重复建段。
EOF
			return 0
			;;
		--*)
			echo "未知选项：$1" >&2
			return 1
			;;
		*) set -- "$@" "$1" ;;
		esac
		[ $# -gt 0 ] && shift
		_n=$((_n - 1))
	done
	if [ $# -eq 0 ]; then
		echo "用法：powerfee room-add <编号1> [<编号2> …] [--id 段名] [--mail-to 邮箱] …" >&2
		return 1
	fi
	# ---- 一次拉取：所有目标都在这一份响应里匹配 ----
	fetch_rooms || { cat "$ERR_TMP" >&2; return 1; }
	_lines=$(mktemp /tmp/powerfee.rooms.XXXXXX 2>/dev/null)
	[ -n "$_lines" ] || _lines="/tmp/powerfee.rooms.$$"
	jsonfilter -i "$API_TMP" -e "$API_ROOMS_PATH" >"$_lines" 2>/dev/null
	if [ ! -s "$_lines" ]; then
		echo "接口返回里没有房间列表（检查 api.rooms_path=$API_ROOMS_PATH 是否指向房间数组）" >&2
		rm -f "$_lines"
		return 1
	fi
	_taken=$(pf_uci -q show powerfee 2>/dev/null | sed -n 's/^powerfee\.\([^.]*\)=room$/\1/p' | tr '\n' ' ')
	_owned=$(room_nums_taken)
	_i=0
	for _t in "$@"; do
		[ -n "$_t" ] || continue
		_i=$((_i + 1))
		# ① 已经在监控？（先按目标字符串比编号，匹配到接口数据后再按编号比一次）
		_sec=""
		_skipwhy=""
		if [ -n "$(room_num_taken "$_t" "$_owned")" ]; then
			_skipwhy=owned
			_sec=$(room_num_owner "$_t")
		elif [ -n "$(room_num_taken "$_t" "$_added")" ]; then
			_skipwhy=dup
		fi
		if [ -n "$_skipwhy" ]; then
			_skip=$((_skip + 1))
			if [ "$_skipwhy" = "owned" ]; then
				echo "跳过：$_t 已在监控（config room ${_sec:-已配置}）"
				room_add_report "$_results" "$_t" "$_t" "$_sec" skip "已在监控（config room ${_sec:-已配置}）"
			else
				echo "跳过：$_t 已在监控（本次批量已添加）"
				room_add_report "$_results" "$_t" "$_t" "" skip "已在监控（本次批量已添加）"
			fi
			continue
		fi
		# ② 在本次响应里匹配（先编号，再房间名）
		_line=$(rooms_match_line "$_lines" "$_t")
		if [ -z "$_line" ]; then
			_fail=$((_fail + 1))
			echo "失败：$_t 没有找到（接口里没有这个编号/房间名）"
			room_add_report "$_results" "$_t" "" "" fail "没有找到（接口里没有这个编号/房间名）"
			continue
		fi
		_num=$(room_field_of "$_line" id)
		if [ -z "$_num" ]; then
			_fail=$((_fail + 1))
			echo "失败：$_t 没能确定房间编号（检查 api.field_id 配置）"
			room_add_report "$_results" "$_t" "" "" fail "没能确定房间编号（检查 api.field_id 配置）"
			continue
		fi
		_campus=$(room_field_of "$_line" campus)
		_building=$(room_field_of "$_line" building)
		_room=$(room_field_of "$_line" name)
		_bal=$(room_field_of "$_line" balance)
		# ③ 匹配到的编号已经在监控？（同一批里重复给的目标也在这里挡掉）
		_sec=""
		_skipwhy=""
		if [ -n "$(room_num_taken "$_num" "$_owned")" ]; then
			_skipwhy=owned
			_sec=$(room_num_owner "$_num")
		elif [ -n "$(room_num_taken "$_num" "$_added")" ]; then
			_skipwhy=dup
		fi
		if [ -n "$_skipwhy" ]; then
			_skip=$((_skip + 1))
			if [ "$_skipwhy" = "owned" ]; then
				echo "跳过：$_t 已在监控（config room ${_sec:-已配置}，编号 $_num）"
				room_add_report "$_results" "$_t" "$_num" "$_sec" skip "已在监控（config room ${_sec:-已配置}）"
			else
				echo "跳过：$_t 已在监控（本次批量已添加）"
				room_add_report "$_results" "$_t" "$_num" "" skip "已在监控（本次批量已添加）"
			fi
			continue
		fi
		# ④ 段名：默认取第一个空闲的 roomN；--id 时递增，绝不覆盖已有段
		_id=$(room_seg_pick "$_id_base" "$_i" "$_taken") || {
			_fail=$((_fail + 1))
			echo "失败：$_t 找不到可用的段名（room1..room100 都被占用，用 --id 指定）"
			room_add_report "$_results" "$_t" "$_num" "" fail "找不到可用的段名（room1..room100 都被占用）"
			continue
		}
		case " $_taken " in
		*" $_id "*)
			_fail=$((_fail + 1))
			echo "失败：$_t 段名 $_id 已存在（换一个 --id，或先删掉旧段）"
			room_add_report "$_results" "$_t" "$_num" "" fail "段名 $_id 已存在"
			continue
			;;
		esac
		# ⑤ 写这个房间自己的段（写失败只影响这一个房间，其他房间照加）
		if ! pf_uci -q set "powerfee.$_id=room"; then
			_fail=$((_fail + 1))
			echo "失败：$_t 写入配置失败（uci set powerfee.$_id=room）"
			room_add_report "$_results" "$_t" "$_num" "" fail "写入配置失败（uci set powerfee.$_id=room）"
			continue
		fi
		pf_uci -q set "powerfee.$_id.num=$_num"
		[ -n "$_campus" ] && pf_uci -q set "powerfee.$_id.campus=$_campus"
		[ -n "$_building" ] && pf_uci -q set "powerfee.$_id.building=$_building"
		[ -n "$_room" ] && pf_uci -q set "powerfee.$_id.room=$_room"
		[ -n "$_label" ] && pf_uci -q set "powerfee.$_id.label=$_label"
		[ -n "$_threshold" ] && pf_uci -q set "powerfee.$_id.threshold=$_threshold"
		[ -n "$_mail_to" ] && pf_uci -q set "powerfee.$_id.mail_to=$_mail_to"
		[ -n "$_notify_url" ] && pf_uci -q set "powerfee.$_id.notify_url=$_notify_url"
		[ -n "$_notify_token" ] && pf_uci -q set "powerfee.$_id.notify_token=$_notify_token"
		if ! pf_uci -q commit powerfee; then
			# 提交失败：把刚 staged 的段删掉，别让它漏进下一次 commit
			pf_uci -q delete "powerfee.$_id"
			_fail=$((_fail + 1))
			echo "失败：$_t 保存配置失败（uci commit powerfee）"
			room_add_report "$_results" "$_t" "$_num" "$_id" fail "保存配置失败（uci commit powerfee）"
			continue
		fi
		_taken="$_taken $_id"
		_added="$_added $_num"
		_ok=$((_ok + 1))
		_disp="$_room"
		[ -n "$_building" ] && _disp="$_building $_room"
		[ -n "$_disp" ] || _disp="$_t"
		echo "成功：$_disp  [编号 $_num]（config room $_id）"
		[ -n "$_bal" ] && echo "      当前余额 $_bal $API_UNIT"
		room_add_report "$_results" "$_t" "$_num" "$_id" ok "已添加（config room $_id）"
	done
	rm -f "$_lines"
	if [ "$_ok" -gt 0 ]; then
		# 重新加载配置（新房间可见）并做老数据迁移（第一个房间继承单房间模式的 state/历史）
		load_config
		rooms_migrate_legacy
	fi
	if [ -n "$_results" ]; then
		printf 'added=%s skipped=%s failed=%s total=%s\n' \
			"$_ok" "$_skip" "$_fail" "$((_ok + _skip + _fail))" >>"$_results"
	fi
	room_add_summary "$_ok" "$_skip" "$_fail"
	return $?
}

cmd_room_add() {
	# room-add <房间号或关键词> [选项]：单个添加（老行为，一字不改）
	# room-add <编号1> [<编号2> …] [选项]：批量添加（转 cmd_room_add_many；只请求一次接口）
	room_add_scan "$@"
	if [ "$PF_ADD_TARGETS" -gt 1 ] || [ -n "$PF_ADD_BATCH" ]; then
		cmd_room_add_many "$@"
		return $?
	fi
	# room-add <房间号或关键词> [--id 段名] [--num 编号] [--label 展示名]
	#     [--mail-to 邮箱] [--notify-url 地址] [--notify-token 令牌] [--threshold 度]
	local _query="" _id="" _label="" _mail_to="" _notify_url="" _notify_token="" _threshold="" _num_arg=""
	local _obj _num _campus _building _room _bal _i
	while [ $# -gt 0 ]; do
		case "$1" in
		--id) _id="${2:-}"; shift ;;
		--num) _num_arg="${2:-}"; shift ;;
		--label) _label="${2:-}"; shift ;;
		--mail-to) _mail_to="${2:-}"; shift ;;
		--notify-url) _notify_url="${2:-}"; shift ;;
		--notify-token) _notify_token="${2:-}"; shift ;;
		--threshold) _threshold="${2:-}"; shift ;;
		-h | --help)
			cat <<EOF
用法：powerfee room-add <房间号或关键词> [选项]
      powerfee room-add <编号1> [<编号2> …] [选项]   # 批量：一次添加多个（只请求接口一次）

  --id <段名>          指定 config 段名（默认 room1、room2…；批量时后续目标自动递增）
  --num <编号>         直接给接口里的房间编号（跳过搜索；只用于单个目标）
  --label <展示名>     邮件/通知里显示的房名（默认用「楼栋 房间」）
  --mail-to <邮箱>     该房间的收件人（多个用逗号分隔；默认继承 mail.to）
  --notify-url <地址>  该房间的推送地址（默认继承 notify.url）
  --notify-token <令牌> 该房间的推送令牌（默认继承 notify.token）
  --threshold <度>     该房间的告警阈值（默认继承 main.threshold）

添加后即可 powerfee check 查一次；收件人与通道可用 powerfee room-set 继续调整。
批量添加逐行报告每个房间的结果（成功 / 跳过：已在监控 / 失败）并汇总；
已经在监控里的房间会跳过，不会重复建段。
EOF
			return 0
			;;
		*) 
			if [ -n "$_query" ]; then
				echo "多余的参数：$1（含空格的展示名要用引号括起来，如 --label '1号楼 A101'）" >&2
				return 1
			fi
			_query="$1"
			;;
		esac
		[ $# -gt 0 ] && shift
	done
	if [ -z "$_num_arg" ] && [ -z "$_query" ]; then
		die "用法：powerfee room-add <房间号或关键词> [--id 段名] [--mail-to 邮箱] [--notify-url 地址]"
	fi
	if [ -n "$_num_arg" ]; then
		_num="$_num_arg"
		_campus=""
		_building=""
		_room=""
		_bal=""
		# 尽量从接口补全展示名（拿不到不阻塞添加）
		if [ -n "$API_URL" ] && fetch_rooms 2>/dev/null; then
			_obj=$(room_obj "$_num" "$API_FIELD_ID")
			if [ -n "$_obj" ]; then
				_campus=$(room_field_of "$_obj" campus)
				_building=$(room_field_of "$_obj" building)
				_room=$(room_field_of "$_obj" name)
				_bal=$(room_field_of "$_obj" balance)
			fi
		fi
	else
		fetch_rooms || { cat "$ERR_TMP" >&2; return 1; }
		# 先按房间名匹配，再退回按编号匹配（与 set-room 一致）
		_obj=$(room_obj "$_query" "$API_FIELD_NAME")
		[ -n "$_obj" ] || _obj=$(room_obj "$_query" "$API_FIELD_ID")
		if [ -z "$_obj" ]; then
			echo "没有找到房间「$_query」。以下为模糊匹配结果："
			cmd_rooms "$_query"
			return 1
		fi
		_num=$(room_field_of "$_obj" id)
		_campus=$(room_field_of "$_obj" campus)
		_building=$(room_field_of "$_obj" building)
		_room=$(room_field_of "$_obj" name)
		_bal=$(room_field_of "$_obj" balance)
	fi
	[ -n "$_num" ] || die "没能确定房间编号（检查 api.field_id 配置）"
	if [ -z "$_id" ]; then
		_i=1
		while [ "$_i" -le 100 ]; do
			_id="room$_i"
			pf_uci -q get "powerfee.$_id" >/dev/null 2>&1 || break
			_id=""
			_i=$((_i + 1))
		done
		[ -n "$_id" ] || die "找不到可用的段名（room1..room100 都被占用），用 --id 指定一个"
	fi
	if pf_uci -q get "powerfee.$_id" >/dev/null 2>&1; then
		die "段名 $_id 已存在（用 powerfee room-list 查看，或换一个 --id）"
	fi
	pf_uci -q set "powerfee.$_id=room" || die "写入配置失败：uci set powerfee.$_id=room"
	pf_uci -q set "powerfee.$_id.num=$_num"
	[ -n "$_campus" ] && pf_uci -q set "powerfee.$_id.campus=$_campus"
	[ -n "$_building" ] && pf_uci -q set "powerfee.$_id.building=$_building"
	[ -n "$_room" ] && pf_uci -q set "powerfee.$_id.room=$_room"
	[ -n "$_label" ] && pf_uci -q set "powerfee.$_id.label=$_label"
	[ -n "$_threshold" ] && pf_uci -q set "powerfee.$_id.threshold=$_threshold"
	[ -n "$_mail_to" ] && pf_uci -q set "powerfee.$_id.mail_to=$_mail_to"
	[ -n "$_notify_url" ] && pf_uci -q set "powerfee.$_id.notify_url=$_notify_url"
	[ -n "$_notify_token" ] && pf_uci -q set "powerfee.$_id.notify_token=$_notify_token"
	pf_uci -q commit powerfee || die "uci commit powerfee 失败"
	# 重新加载配置：config_get 读的是内存里的 UCI，不重载就看不到刚写入的房间
	load_config
	rooms_migrate_legacy
	if room_load "$_id"; then
		room_apply_env
		echo "已添加监控房间：$R_DISPLAY${R_CAMPUS:+（$R_CAMPUS）}  [编号 $R_NUM]（config room '$_id'）"
		[ -n "$_bal" ] && echo "当前余额 $_bal $API_UNIT"
		echo "该房间的提醒会发到：$(room_delivery_text)"
		echo "提示：powerfee room-set $_id mail_to <邮箱> / mail_account <发件账号> / notify_account <推送账号> 可单独调整"
	else
		echo "已添加 config room '$_id'（编号 $_num）"
	fi
	return 0
}

cmd_room_remove() {
	# room-remove <段名或编号>：删除房间（连同它的状态与历史）
	local _arg="$1" _id _sf="" _hf="" _disp=""
	[ -n "$_arg" ] || die "用法：powerfee room-remove <段名或房间编号>"
	if [ "$ROOM_COUNT" -eq 0 ]; then
		die "当前是单房间模式，没有 config room 段可删（清空房间用 powerfee set-room 换一个，或 uci delete powerfee.main.room_num）"
	fi
	_id=$(room_resolve_id "$_arg") || die "没有找到房间：$_arg（用 powerfee room-list 查看段名）"
	if room_load "$_id"; then
		_sf="$R_STATE_FILE"
		_hf="$R_HISTORY_FILE"
		_disp="$R_DISPLAY"
	fi
	pf_uci -q delete "powerfee.$_id" || die "删除失败：powerfee.$_id"
	pf_uci -q commit powerfee || die "uci commit powerfee 失败"
	[ -n "$_sf" ] && rm -f "$_sf"
	[ -n "$_hf" ] && rm -f "$_hf"
	load_config
	echo "已删除房间 $_id${_disp:+（$_disp）}及其状态与历史"
	[ "$ROOM_COUNT" -eq 0 ] && echo "现在没有 config room 段了：回到单房间模式（用 main.room_num，状态文件 state / history.csv）"
	return 0
}

cmd_room_set() {
	# room-set <段名或编号> <键> <值>（清空某字段：把值写成空串 ''，三个参数都要给）
	local _arg="$1" _key="$2" _val="$3" _id _obj _campus _building _room
	if [ $# -lt 3 ] || [ -z "$_arg" ] || [ -z "$_key" ]; then
		die "用法：powerfee room-set <段名或编号> <键> <值>（要清空某个字段就把值写成空串 ''）"
	fi
	if [ "$ROOM_COUNT" -eq 0 ]; then
		die "当前是单房间模式，没有 config room 段（先用 powerfee room-add 添加一个房间）"
	fi
	_id=$(room_resolve_id "$_arg") || die "没有找到房间：$_arg（用 powerfee room-list 查看段名）"
	room_write_kv "$_id" "$_key=$_val" || return 1
	# 改编号时顺手从接口刷新展示名（拿不到就跳过，不影响已写入的编号）
	if [ "$_key" = "num" ] && [ -n "$_val" ] && [ -n "$API_URL" ]; then
		if fetch_rooms 2>/dev/null; then
			_obj=$(room_obj "$_val" "$API_FIELD_ID")
			if [ -n "$_obj" ]; then
				_campus=$(room_field_of "$_obj" campus)
				_building=$(room_field_of "$_obj" building)
				_room=$(room_field_of "$_obj" name)
				if [ -n "$_campus" ] || [ -n "$_building" ] || [ -n "$_room" ]; then
					[ -n "$_campus" ] && pf_uci -q set "powerfee.$_id.campus=$_campus"
					[ -n "$_building" ] && pf_uci -q set "powerfee.$_id.building=$_building"
					[ -n "$_room" ] && pf_uci -q set "powerfee.$_id.room=$_room"
					pf_uci -q commit powerfee
				fi
			fi
		fi
	fi
	load_config
	# 引用了还不存在的账号名时给句明白话（不阻止写入：账号可以稍后再建；
	# 解析时会回退到默认段并记日志/状态，不会让提醒消失）
	if [ "$_key" = "mail_account" ] && [ -n "$_val" ] && ! acct_section_exists mail_account "$_val"; then
		echo "警告：发件账号「$_val」还不存在，该房间会先回退到 mail 段（powerfee mail-account add $_val 建）"
	fi
	if [ "$_key" = "notify_account" ] && [ -n "$_val" ] && ! acct_section_exists push_account "$_val"; then
		echo "警告：推送账号「$_val」还不存在，该房间会先回退到 notify 段（powerfee push-account add $_val 建）"
	fi
	if room_load "$_id"; then
		echo "已设置：$_id.$_key=$_val（当前房间：$R_DISPLAY [编号 $R_NUM]）"
	else
		echo "已设置：$_id.$_key=$_val（注意：该房间还没有 num 编号，不会被监控）"
	fi
	return 0
}

# ---- 命名账号管理（mail-account / push-account，1.2.0）-----------------------

acct_cmd_name() {
	# 类型 -> 命令行名字（提示文案里用）
	case "$1" in
	mail_account) printf 'mail-account' ;;
	*) printf 'push-account' ;;
	esac
}

acct_type_ids() {
	case "$1" in
	mail_account) printf '%s' "$MAIL_ACCT_IDS" ;;
	*) printf '%s' "$PUSH_ACCT_IDS" ;;
	esac
}

acct_count() {
	case "$1" in
	mail_account) printf '%s' "$MAIL_ACCT_COUNT" ;;
	*) printf '%s' "$PUSH_ACCT_COUNT" ;;
	esac
}

acct_inherit_text() {
	# 列出该账号里留空（= 继承默认段）的字段
	local _type="$1" _name="$2" _k _out=""
	for _k in $(acct_keys "$_type"); do
		case "$_k" in enabled) continue ;; esac
		[ -n "$(room_get "$_name" "$_k" "")" ] || _out="$_out $_k"
	done
	[ -n "$_out" ] || { printf '无（每个字段都自己填了）'; return 0; }
	printf '留空继承默认段：%s' "${_out# }"
}

acct_inherit_json() {
	# 留空（继承默认段）的字段名数组
	local _type="$1" _name="$2" _k _first=1
	printf '['
	for _k in $(acct_keys "$_type"); do
		case "$_k" in enabled) continue ;; esac
		if [ -z "$(room_get "$_name" "$_k" "")" ]; then
			[ "$_first" = "1" ] || printf ','
			_first=0
			printf '%s' "$(json_str "$_k")"
		fi
	done
	printf ']'
}

acct_issues_json() {
	# 账号问题清单（status / json 用）：[{"kind":"mail","name":"qq_main","message":"…"}]
	local _k _n _m _first=1
	printf '['
	printf '%s' "$ACCT_ISSUE_MSGS" | tr '\t' '\n' | while IFS='|' read -r _k _n _m; do
		[ -n "$_k" ] || continue
		if [ "$_first" = "1" ]; then _first=0; else printf ','; fi
		printf '{"kind":%s,"name":%s,"message":%s}' "$(json_str "$_k")" "$(json_str "$_n")" "$(json_str "$_m")"
	done
	printf ']'
}

acct_used_by() {
	# 该账号被哪些房间引用（空格分隔的段名；没有则输出空串）
	local _type="$1" _name="$2" _id _out=""
	for _id in $ROOM_IDS; do
		room_load "$_id" || continue
		if [ "$_type" = "mail_account" ]; then
			[ "$R_MAIL_ACCOUNT" = "$_name" ] && _out="$_out $_id"
		else
			[ "$R_NOTIFY_ACCOUNT" = "$_name" ] && _out="$_out $_id"
		fi
	done
	printf '%s' "${_out# }"
}

acct_used_by_json() {
	local _type="$1" _name="$2" _id _first=1 _hit
	printf '['
	for _id in $ROOM_IDS; do
		room_load "$_id" || continue
		_hit=""
		if [ "$_type" = "mail_account" ]; then
			[ "$R_MAIL_ACCOUNT" = "$_name" ] && _hit=1
		else
			[ "$R_NOTIFY_ACCOUNT" = "$_name" ] && _hit=1
		fi
		[ -n "$_hit" ] || continue
		[ "$_first" = "1" ] || printf ','
		_first=0
		printf '%s' "$(json_str "$_id")"
	done
	printf ']'
}

acct_json_array() {
	# acct_json_array <mail_account|push_account>：账号数组 JSON。
	# 密钥类字段只回「是否已设置」+ 掩码（照 mask_secret / mask_url / key_set 的做法），
	# 真值绝不出现在输出里。raw = 段里实际写的值（空 = 继承，给表单回显用），
	# effective = 继承解析后的有效值（给人看）。
	# 注意：内部会调用 mail_env_apply / notify_env_apply（会改 MAIL_*/NOTIFY_* 全局），
	# 结束时用 room_reapply_current 恢复「当前房间」。
	local _type="$1" _ids _a _first=1 _en _usable _issue
	if [ "$_type" = "mail_account" ]; then _ids="$MAIL_ACCT_IDS"; else _ids="$PUSH_ACCT_IDS"; fi
	printf '['
	for _a in $_ids; do
		[ "$_first" = "1" ] || printf ','
		_first=0
		if [ "$_type" = "mail_account" ]; then
			_en=$(room_get "$_a" enabled "$D_MAIL_ACCT_ENABLED")
			mail_env_apply "$_a"
			_issue="$MAIL_ACCT_ISSUE"
		else
			_en=$(room_get "$_a" enabled "$D_PUSH_ACCT_ENABLED")
			notify_env_apply "$_a" "" ""
			_issue="$NOTIFY_ACCT_ISSUE"
		fi
		_usable=""
		[ -z "$_issue" ] && [ "$_en" = "1" ] && _usable=1
		printf '{"name":%s,"enabled":%s,"usable":%s,"issue":%s,"used_by":%s' \
			"$(json_str "$_a")" "$(json_bool "$_en")" "$(json_bool "$_usable")" \
			"$(json_str "$_issue")" "$(acct_used_by_json "$_type" "$_a")"
		if [ "$_type" = "mail_account" ]; then
			printf ',"raw":{"transport":%s,"host":%s,"port":%s,"security":%s,"user_set":%s,"password_set":%s,"from":%s,"from_name":%s,"tls_verify":%s}' \
				"$(json_str "$(room_get "$_a" transport "")")" \
				"$(json_str "$(room_get "$_a" host "")")" \
				"$(json_num "$(room_get "$_a" port "")")" \
				"$(json_str "$(room_get "$_a" security "")")" \
				"$(json_bool "$([ -n "$(room_get "$_a" user "")" ] && echo 1)")" \
				"$(json_bool "$([ -n "$(room_get "$_a" password "")" ] && echo 1)")" \
				"$(json_str "$(room_get "$_a" from "")")" \
				"$(json_str "$(room_get "$_a" from_name "")")" \
				"$(json_str "$(room_get "$_a" tls_verify "")")"
			printf ',"effective":{"transport":%s,"host":%s,"port":%s,"security":%s,"user_set":%s,"user_hint":%s,"password_set":%s,"from":%s,"from_name":%s,"tls_verify":%s,"sender":%s}' \
				"$(json_str "$MAIL_TRANSPORT")" "$(json_str "$MAIL_HOST")" "$(json_num "$MAIL_PORT")" \
				"$(json_str "$MAIL_SECURITY")" \
				"$(json_bool "$([ -n "$MAIL_USER" ] && echo 1)")" "$(json_str "$(mask_secret "$MAIL_USER")")" \
				"$(json_bool "$([ -n "$MAIL_PASSWORD" ] && echo 1)")" \
				"$(json_str "$MAIL_FROM")" "$(json_str "$MAIL_FROM_NAME")" \
				"$(json_bool "$MAIL_TLS_VERIFY")" "$(json_str "${MAIL_FROM:-$MAIL_USER}")"
			printf ',"inherit":%s}' "$(acct_inherit_json mail_account "$_a")"
		else
			printf ',"raw":{"channel":%s,"url_masked":%s,"method":%s,"content_type":%s,"body":%s,"token_set":%s,"token_header":%s,"timeout":%s,"bot_id":%s}' \
				"$(json_str "$(room_get "$_a" channel "")")" \
				"$(json_str "$(mask_url "$(room_get "$_a" url "")")")" \
				"$(json_str "$(room_get "$_a" method "")")" \
				"$(json_str "$(room_get "$_a" content_type "")")" \
				"$(json_str "$(room_get "$_a" body "")")" \
				"$(json_bool "$([ -n "$(room_get "$_a" token "")" ] && echo 1)")" \
				"$(json_str "$(room_get "$_a" token_header "")")" \
				"$(json_num "$(room_get "$_a" timeout "")")" \
				"$(json_str "$(room_get "$_a" bot_id "")")"
			printf ',"effective":{"channel":%s,"channel_name":%s,"url_masked":%s,"method":%s,"content_type":%s,"body":%s,"token_set":%s,"token_header":%s,"timeout":%s,"bot_id":%s}' \
				"$(json_str "$NOTIFY_CHANNEL")" "$(json_str "$(notify_channel_name "$NOTIFY_CHANNEL")")" \
				"$(json_str "$(mask_url "$NOTIFY_URL")")" \
				"$(json_str "$(printf '%s' "$NOTIFY_METHOD" | tr 'a-z' 'A-Z')")" \
				"$(json_str "$NOTIFY_CONTENT_TYPE")" "$(json_str "$NOTIFY_BODY")" \
				"$(json_bool "$([ -n "$NOTIFY_TOKEN" ] && echo 1)")" \
				"$(json_str "$NOTIFY_TOKEN_HEADER")" "$(json_num "$NOTIFY_TIMEOUT")" \
				"$(json_str "$(room_get "$_a" bot_id "")")"
			printf ',"inherit":%s}' "$(acct_inherit_json push_account "$_a")"
		fi
	done
	printf ']'
	room_reapply_current
}

acct_write_kv() {
	# acct_write_kv <类型> <段名> <键=值> [...]：批量写账号字段，只 commit 一次
	local _type="$1" _id="$2" _kv _key _val
	shift 2
	[ $# -gt 0 ] || { echo "没有要写入的字段" >&2; return 1; }
	acct_section_exists "$_type" "$_id" || { echo "没有找到 $(_acct_label "$_type")账号：$_id" >&2; return 1; }
	for _kv in "$@"; do
		case "$_kv" in
		*=*) ;;
		*)
			echo "参数要写成 键=值 的形式：$_kv" >&2
			return 1
			;;
		esac
		_key="${_kv%%=*}"
		_val="${_kv#*=}"
		if ! acct_key_ok "$_type" "$_key"; then
			echo "不支持的键：$_key（可用：$(acct_keys "$_type")）" >&2
			return 1
		fi
		pf_uci -q set "powerfee.$_id.$_key=$_val" || { echo "写入失败：powerfee.$_id.$_key" >&2; return 1; }
	done
	pf_uci -q commit powerfee || { echo "uci commit powerfee 失败" >&2; return 1; }
	return 0
}

_acct_label() {
	case "$1" in
	mail_account) printf '发件' ;;
	*) printf '推送' ;;
	esac
}

acct_add() {
	# acct_add <类型> <名> [--channel <通道>]
	local _type="$1" _name="$2" _cmd _ch="" _d
	_cmd=$(acct_cmd_name "$_type")
	[ -n "$_name" ] || {
		echo "用法：powerfee $_cmd add <名>$([ "$_type" = push_account ] && echo ' [--channel serverchan|wecom|clawbot|custom]')" >&2
		return 1
	}
	shift 2 || return 1
	while [ $# -gt 0 ]; do
		case "$1" in
		--channel) _ch="${2:-}"; shift ;;
		*)
			echo "多余的参数：$1" >&2
			return 1
			;;
		esac
		[ $# -gt 0 ] && shift
	done
	acct_name_valid "$_name" || { echo "账号名只能用字母、数字、下划线：$_name" >&2; return 1; }
	if pf_uci -q get "powerfee.$_name" >/dev/null 2>&1; then
		echo "段名 $_name 已存在（用 powerfee $_cmd list 查看，或换个名字）" >&2
		return 1
	fi
	if [ -n "$_ch" ]; then
		case "$_ch" in
		serverchan | wecom | clawbot | custom | webhook) ;;
		*)
			echo "不支持的通道：$_ch（可用：serverchan wecom clawbot custom）" >&2
			return 1
			;;
		esac
		[ "$_ch" = "webhook" ] && _ch="custom"
	fi
	pf_uci -q set "powerfee.$_name=$_type" || { echo "写入配置失败：uci set powerfee.$_name=$_type" >&2; return 1; }
	pf_uci -q set "powerfee.$_name.enabled=1"
	if [ -n "$_ch" ]; then
		pf_uci -q set "powerfee.$_name.channel=$_ch"
		# 通道自带一套默认值（与 push.py 的通道选择器一致），省得逐项手填
		case "$_ch" in
		serverchan) pf_uci -q set "powerfee.$_name.body=$(push_body_default serverchan)" ;;
		wecom) pf_uci -q set "powerfee.$_name.body=$(push_body_default wecom)" ;;
		clawbot) pf_uci -q set "powerfee.$_name.token_header=Authorization" ;;
		esac
	fi
	pf_uci -q commit powerfee || { echo "uci commit powerfee 失败" >&2; return 1; }
	load_config
	echo "已添加$(_acct_label "$_type")账号：$_name$([ -n "$_ch" ] && echo "（通道 $_ch）")"
	if [ "$_type" = "mail_account" ]; then
		echo "接着填参数：powerfee mail-account set $_name host <SMTP服务器> / user <邮箱> / password <授权码>"
		echo "绑到房间  ：powerfee room-set <房间段名> mail_account $_name"
	else
		echo "接着填参数：powerfee push-account set $_name token <密钥>（serverchan 可只填 token；clawbot 填 bot_id）"
		echo "绑到房间  ：powerfee room-set <房间段名> notify_account $_name"
	fi
	return 0
}

acct_set() {
	# acct_set <类型> <名> <键> <值>
	local _type="$1" _name="$2" _key="$3" _val="$4" _cmd
	_cmd=$(acct_cmd_name "$_type")
	if [ $# -lt 4 ] || [ -z "$_name" ] || [ -z "$_key" ]; then
		echo "用法：powerfee $_cmd set <名> <键> <值>（要清空某字段就把值写成空串 ''）" >&2
		echo "可用键：$(acct_keys "$_type")" >&2
		return 1
	fi
	acct_write_kv "$_type" "$_name" "$_key=$_val" || return 1
	load_config
	if [ "$_type" = "mail_account" ]; then
		mail_env_apply "$_name"
		if [ -n "$MAIL_ACCT_ISSUE" ]; then
			echo "已设置：$_name.$_key（注意：$MAIL_ACCT_ISSUE）"
		else
			echo "已设置：$_name.$_key（发件方 ${MAIL_FROM:-$MAIL_USER} @ $MAIL_HOST:$MAIL_PORT $MAIL_SECURITY）"
		fi
	else
		notify_env_apply "$_name" "" ""
		if [ -n "$NOTIFY_ACCT_ISSUE" ]; then
			echo "已设置：$_name.$_key（注意：$NOTIFY_ACCT_ISSUE）"
		else
			echo "已设置：$_name.$_key（通道 $(notify_channel_name "$NOTIFY_CHANNEL") → $(printf '%s' "$NOTIFY_METHOD" | tr 'a-z' 'A-Z') $(mask_url "$NOTIFY_URL")）"
		fi
	fi
	room_reapply_current
	return 0
}

acct_remove() {
	# acct_remove <类型> <名>
	local _type="$1" _name="$2" _refs="" _id _cmd
	_cmd=$(acct_cmd_name "$_type")
	[ -n "$_name" ] || { echo "用法：powerfee $_cmd remove <名>" >&2; return 1; }
	acct_section_exists "$_type" "$_name" || { echo "没有找到$(_acct_label "$_type")账号：$_name（powerfee $_cmd list 查看）" >&2; return 1; }
	_refs=$(acct_used_by "$_type" "$_name")
	pf_uci -q delete "powerfee.$_name" || { echo "删除失败：powerfee.$_name" >&2; return 1; }
	pf_uci -q commit powerfee || { echo "uci commit powerfee 失败" >&2; return 1; }
	load_config
	echo "已删除$(_acct_label "$_type")账号：$_name"
	if [ -n "$_refs" ]; then
		echo "注意：房间（$_refs）仍引用该账号，会回退到默认段继续发提醒（powerfee status 会标出来）"
	fi
	return 0
}

acct_list() {
	# acct_list <类型>：列出账号（密钥只回掩码/是否已设置）
	local _type="$1" _ids _a _n=0 _en _refs
	_ids=$(acct_type_ids "$_type")
	if [ -z "$_ids" ]; then
		if [ "$_type" = "mail_account" ]; then
			echo "还没有发件账号（config mail_account 段）。"
			echo "  添加：powerfee mail-account add <名>，再 set <名> host/user/password …"
			echo "  不添加也能用：房间不写 mail_account 时用 mail 段的默认发件账号。"
		else
			echo "还没有推送账号（config push_account 段）。"
			echo "  添加：powerfee push-account add <名> --channel serverchan|wecom|clawbot|custom"
			echo "  不添加也能用：房间不写 notify_account 时用 notify 段的默认通道。"
		fi
		return 0
	fi
	echo "$(_acct_label "$_type")账号（$_type）共 $(acct_count "$_type") 个："
	for _a in $_ids; do
		_n=$((_n + 1))
		_refs=$(acct_used_by "$_type" "$_a")
		[ -n "$_refs" ] || _refs="（没有房间在用）"
		if [ "$_type" = "mail_account" ]; then
			_en=$(room_get "$_a" enabled "$D_MAIL_ACCT_ENABLED")
			mail_env_apply "$_a"
			printf '  %d) %-16s %s  ← %s\n' "$_n" "$_a" \
				"$([ "$_en" = "1" ] && echo 已启用 || echo 已停用)" "$_refs"
			echo "     发件方 ：${MAIL_FROM:-$MAIL_USER}（$MAIL_HOST:$MAIL_PORT $MAIL_SECURITY，投递方式 $(mailer_available)）"
			echo "     认证   ：user $([ -n "$MAIL_USER" ] && mask_secret "$MAIL_USER" || echo 未设置) ｜ password $([ -n "$MAIL_PASSWORD" ] && echo 已设置 || echo 未设置)"
			echo "     $(acct_inherit_text "$_type" "$_a")"
			[ -n "$MAIL_ACCT_ISSUE" ] && echo "     问题   ：$MAIL_ACCT_ISSUE（已回退到 mail 段）"
		else
			_en=$(room_get "$_a" enabled "$D_PUSH_ACCT_ENABLED")
			notify_env_apply "$_a" "" ""
			printf '  %d) %-16s %s  ← %s\n' "$_n" "$_a" \
				"$([ "$_en" = "1" ] && echo 已启用 || echo 已停用)" "$_refs"
			echo "     通道   ：$(notify_channel_name "$NOTIFY_CHANNEL")（$NOTIFY_CHANNEL）｜ $(printf '%s' "$NOTIFY_METHOD" | tr 'a-z' 'A-Z') $(mask_url "$NOTIFY_URL")"
			echo "     鉴权   ：token $([ -n "$NOTIFY_TOKEN" ] && echo 已设置 || echo 未设置) → 请求头 $NOTIFY_TOKEN_HEADER"
			echo "     $(acct_inherit_text "$_type" "$_a")"
			[ -n "$NOTIFY_ACCT_ISSUE" ] && echo "     问题   ：$NOTIFY_ACCT_ISSUE（已回退到 notify 段）"
		fi
	done
	room_reapply_current
	return 0
}

acct_test_mail() {
	# acct_test_mail <账号名> [房间]：用指定发件账号发一封测试邮件（收件人取该房间的 mail_to）
	local _name="$1" _room="$2" _id _bal _level _stats _save
	[ -n "$_name" ] || { echo "用法：powerfee mail-account test <账号名> [房间]" >&2; return 1; }
	acct_section_exists mail_account "$_name" || { echo "没有找到发件账号：$_name（powerfee mail-account list 查看）" >&2; return 1; }
	if [ -n "$_room" ]; then
		_id=$(room_resolve_id "$_room") || { echo "没有找到房间：$_room（powerfee room-list 查看段名）" >&2; return 1; }
		room_load "$_id" || { echo "房间 $_id 配置无效（缺少 num）" >&2; return 1; }
		room_apply_env
	fi
	mail_env_apply "$_name"
	# 账号名是用户显式指定的：这里不做回退，有问题就直接说清楚
	[ -z "$MAIL_ACCT_ISSUE" ] || { echo "发件账号 $_name 不可用：$MAIL_ACCT_ISSUE" >&2; return 1; }
	[ -n "$MAIL_TO" ] || { echo "没有收件人（该房间 mail_to 与 mail.to 都为空）" >&2; return 1; }
	_bal=$(state_get last_balance)
	_level=$(state_get last_level)
	[ -n "$_level" ] || _level=ok
	_stats=$(compute_stats "$HISTORY_FILE" "${_bal:-0}" "$(now_epoch)")
	# 测试是用户显式发起的：邮件总开关（mail.enabled）关着也照发一封，但提示一句
	_save="$MAIL_ENABLED"
	if [ "$_save" != "1" ]; then
		echo "提示：mail.enabled=0（自动提醒已关闭），本次是手动测试，照发一封。"
		MAIL_ENABLED=1
	fi
	if mail_send_alert test "$_level" "${_bal:-—}" "$(echo "$_stats" | awk '{print $1}')" "$(echo "$_stats" | awk '{print $2}')"; then
		MAIL_ENABLED="$_save"
		echo "测试邮件已发送：$_name → $(echo "$MAIL_TO" | tr -d ' ')"
		return 0
	fi
	MAIL_ENABLED="$_save"
	echo "发送失败（账号 $_name），原因见：powerfee log" >&2
	return 1
}

acct_test_push() {
	# acct_test_push <账号名> [房间]：用指定推送账号推一条测试消息
	# （给了房间时，房间级 notify_url / notify_token 仍按契约覆盖账号的同名字段）
	local _name="$1" _room="$2" _id _bal _level _stats _save _rurl="" _rtok=""
	[ -n "$_name" ] || { echo "用法：powerfee push-account test <账号名> [房间]" >&2; return 1; }
	acct_section_exists push_account "$_name" || { echo "没有找到推送账号：$_name（powerfee push-account list 查看）" >&2; return 1; }
	if [ -n "$_room" ]; then
		_id=$(room_resolve_id "$_room") || { echo "没有找到房间：$_room（powerfee room-list 查看段名）" >&2; return 1; }
		room_load "$_id" || { echo "房间 $_id 配置无效（缺少 num）" >&2; return 1; }
		room_apply_env
		_rurl="$R_NOTIFY_URL"
		_rtok="$R_NOTIFY_TOKEN"
	fi
	notify_env_apply "$_name" "$_rurl" "$_rtok"
	[ -z "$NOTIFY_ACCT_ISSUE" ] || { echo "推送账号 $_name 不可用：$NOTIFY_ACCT_ISSUE" >&2; return 1; }
	[ -n "$NOTIFY_URL" ] || { echo "没有推送地址（该账号没写 url，notify.url 也为空）" >&2; return 1; }
	_bal=$(state_get last_balance)
	_level=$(state_get last_level)
	[ -n "$_level" ] || _level=ok
	_stats=$(compute_stats "$HISTORY_FILE" "${_bal:-0}" "$(now_epoch)")
	# 同 mail-account test：测试是显式发起的，notify.enabled=0 也照推一条，但提示一句
	_save="$NOTIFY_ENABLED"
	if [ "$_save" != "1" ]; then
		echo "提示：notify.enabled=0（该房间的自动推送已关闭），本次是手动测试，照推一条。"
		NOTIFY_ENABLED=1
	fi
	if notify_send test "$_level" "${_bal:-—}" "$(echo "$_stats" | awk '{print $1}')" "$(echo "$_stats" | awk '{print $2}')"; then
		NOTIFY_ENABLED="$_save"
		echo "测试通知已推送：$_name/$(notify_channel_name "$NOTIFY_CHANNEL") → $(printf '%s' "$NOTIFY_METHOD" | tr 'a-z' 'A-Z') $(mask_url "$NOTIFY_URL")"
		[ -n "$NOTIFY_LAST_RESP" ] && echo "服务端返回：$NOTIFY_LAST_RESP"
		return 0
	fi
	NOTIFY_ENABLED="$_save"
	if [ -n "$NOTIFY_LAST_RESP" ]; then
		echo "推送失败（HTTP ${NOTIFY_LAST_CODE:-?}）：$NOTIFY_LAST_RESP" >&2
	else
		echo "推送失败：连不上服务端或没有响应（详见 powerfee log）" >&2
	fi
	return 1
}

cmd_mail_account() {
	local _sub="$1"
	[ $# -gt 0 ] && shift
	case "$_sub" in
	list) acct_list mail_account ;;
	add) acct_add mail_account "$@" ;;
	set) acct_set mail_account "$@" ;;
	remove) acct_remove mail_account "$@" ;;
	test) acct_test_mail "$@" ;;
	"" | -h | --help)
		cat <<EOF
用法：powerfee mail-account <子命令>

  list                        列出发件账号（发件方 / 认证 / 继承情况，密钥只回掩码）
  add <名>                    新增发件账号（段名只能用字母数字下划线）
  set <名> <键> <值>          改字段：$(acct_keys mail_account)
                              留空 = 继承 mail 段（清空某字段把值写成空串 ''）
  remove <名>                 删除发件账号
  test <名> [房间]            用该账号发一封测试邮件（收件人取房间 mail_to）

绑到房间：powerfee room-set <房间段名> mail_account <名>
说明：账号只描述「发件方」，收件人仍由房间的 mail_to 决定；
      mail.enabled=0 时整条邮件通道关闭（账号不能绕过总开关）。
EOF
		return 0
		;;
	*)
		echo "未知的 mail-account 子命令：$_sub" >&2
		return 1
		;;
	esac
}

cmd_push_account() {
	local _sub="$1"
	[ $# -gt 0 ] && shift
	case "$_sub" in
	list) acct_list push_account ;;
	add) acct_add push_account "$@" ;;
	set) acct_set push_account "$@" ;;
	remove) acct_remove push_account "$@" ;;
	test) acct_test_push "$@" ;;
	"" | -h | --help)
		cat <<EOF
用法：powerfee push-account <子命令>

  list                        列出推送账号（通道 / 地址掩码 / 令牌是否已设置）
  add <名> [--channel <通道>] 新增推送账号（serverchan|wecom|clawbot|custom）
  set <名> <键> <值>          改字段：$(acct_keys push_account)
                              留空 = 继承 notify 段；channel=clawbot 且 url 为空时用本机 ClawBot API
  remove <名>                 删除推送账号
  test <名> [房间]            推一条测试消息（房间级 notify_url/token 仍会覆盖账号）

绑到房间：powerfee room-set <房间段名> notify_account <名>
EOF
		return 0
		;;
	*)
		echo "未知的 push-account 子命令：$_sub" >&2
		return 1
		;;
	esac
}

cmd_history() {
	# history [房间段名|编号] [条数]；第一个参数是数字时按老用法当条数
	local _a="$1" _b="$2" _n _id _t _v _stats
	case "$_a" in
	'') _n="20" ;;
	*[!0-9]*)
		# 第一个参数不是数字：当成房间（段名或编号）
		_id=$(room_resolve_id "$_a") || die "没有找到房间：$_a（用 powerfee room-list 查看段名）"
		room_load "$_id" || die "房间 $_id 配置无效（缺少 num）"
		room_apply_env
		_n="$_b"
		;;
	*) _n="$_a" ;;
	esac
	case "$_n" in '' | *[!0-9]*) _n=20 ;; esac
	[ -f "$HISTORY_FILE" ] || die "还没有历史采样（服务每查询一次记一个点）"
	echo "最近 $_n 条采样（共 $(wc -l <"$HISTORY_FILE" | tr -d ' ') 条）$([ "$ROOM_COUNT" -gt 0 ] && echo " ｜ 房间 $ROOM_DISPLAY [编号 $ROOM_NUM]"):"
	tail -n "$_n" "$HISTORY_FILE" | while IFS=, read -r _t _v; do
		printf '  %s  %s %s\n' "$(fmt_time "$_t")" "$_v" "$API_UNIT"
	done
	_stats=$(compute_stats "$HISTORY_FILE" "$(state_get last_balance)" "$(now_epoch)")
	echo "日均 $(echo "$_stats" | awk '{print $1}') $API_UNIT/天，预计可用 $(echo "$_stats" | awk '{print $2}') 天"
}

cmd_test_mail() {
	local _bal _level _stats _room="$1" _id
	if [ -n "$_room" ]; then
		_id=$(room_resolve_id "$_room") || die "没有找到房间：$_room（用 powerfee room-list 查看段名）"
		room_load "$_id" || die "房间 $_id 配置无效（缺少 num）"
		room_apply_env
	fi
	[ "$MAIL_ENABLED" = "1" ] || die "邮件未启用：uci set powerfee.mail.enabled=1 && uci commit powerfee"
	[ -n "$MAIL_TO" ] || die "未配置收件人：uci set powerfee.mail.to='you@example.com'"
	_bal=$(state_get last_balance)
	_level=$(state_get last_level)
	[ -n "$_level" ] || _level=ok
	_stats=$(compute_stats "$HISTORY_FILE" "${_bal:-0}" "$(now_epoch)")
	if mail_alert test "$_level" "${_bal:-—}" "$(echo "$_stats" | awk '{print $1}')" "$(echo "$_stats" | awk '{print $2}')"; then
		echo "测试邮件已发送，请查收（收件人 $MAIL_TO）"
	else
		echo "发送失败，原因见：powerfee log" >&2
		return 1
	fi
}

cmd_notify_test() {
	# 发一条测试通知（与邮件 test 同源：走 notify_send，reason=test）
	# 失败时把服务端原文一起打出来：Server酱 / 企业微信 出错是 HTTP 200 + 正文报错，
	# 只回一句「失败」等于什么都没说。
	local _bal _level _stats _room="$1" _id
	if [ -n "$_room" ]; then
		_id=$(room_resolve_id "$_room") || die "没有找到房间：$_room（用 powerfee room-list 查看段名）"
		room_load "$_id" || die "房间 $_id 配置无效（缺少 num）"
		room_apply_env
	fi
	[ "$NOTIFY_ENABLED" = "1" ] || die "通知未启用：uci set powerfee.notify.enabled=1 && uci commit powerfee"
	[ -n "$NOTIFY_URL" ] || die "未配置推送地址：uci set powerfee.notify.url='https://...'"
	_bal=$(state_get last_balance)
	_level=$(state_get last_level)
	[ -n "$_level" ] || _level=ok
	_stats=$(compute_stats "$HISTORY_FILE" "${_bal:-0}" "$(now_epoch)")
	if notify_send test "$_level" "${_bal:-—}" "$(echo "$_stats" | awk '{print $1}')" "$(echo "$_stats" | awk '{print $2}')"; then
		echo "测试通知已推送（$(printf '%s' "$NOTIFY_METHOD" | tr 'a-z' 'A-Z') $(mask_url "$NOTIFY_URL")）"
		[ -n "$NOTIFY_LAST_RESP" ] && echo "服务端返回：$NOTIFY_LAST_RESP"
		return 0
	fi
	if [ -n "$NOTIFY_LAST_RESP" ]; then
		echo "推送失败（HTTP ${NOTIFY_LAST_CODE:-?}）：$NOTIFY_LAST_RESP" >&2
	else
		echo "推送失败：连不上服务端或没有响应（详见 powerfee log）" >&2
	fi
	echo "完整日志见：powerfee log" >&2
	return 1
}

cmd_log() {
	local _n="${1:-40}"
	if [ -f "$LOG_FILE" ]; then
		tail -n "$_n" "$LOG_FILE"
	else
		logread -e powerfee 2>/dev/null | tail -n "$_n"
	fi
}

# ---- 每日用电量（powerfee usage）与定时报告（powerfee report）----------------

room_select_for_usage() {
	# room_select_for_usage <房间参数>：把「当前房间」切到指定房间（空 = 默认房间）
	local _id
	if [ -n "$1" ]; then
		_id=$(room_resolve_id "$1") || { echo "没有找到房间：$1（用 powerfee room-list 查看段名）" >&2; return 1; }
		room_load "$_id" || { echo "房间 $_id 配置无效（缺少 num）" >&2; return 1; }
		room_apply_env
		return 0
	fi
	if [ "$ROOM_COUNT" -eq 0 ]; then
		room_legacy_prepare
		room_apply_env
	fi
	[ -n "$ROOM_NUM" ] || {
		echo "还没有设置房间（powerfee set-room <房间号> 或 powerfee room-add <房间号>）" >&2
		return 1
	}
	return 0
}

usage_help_text() {
	cat <<EOF
用法：powerfee usage [房间] [选项]

  房间                   段名或编号（默认当前房间；多房间见 powerfee room-list）
  --days N               最近 N 天（默认 $REPORT_DAYS；1~92）
  --month YYYY-MM        某个自然月（如 2026-10）
  --date YYYY-MM-DD      只看某一天（打印那天的用量）
  --png <路径>           把曲线写成 PNG 文件（ASCII 标题，可当图片发出去）

数据来源：配了 api.daily_url 就取学校逐日接口（历史月走缓存、当月每次重取；
月末缺的那天用下个月首日数据恢复，拿不到就断开不画）；接口没配/取不到时
自动退回本地采样估算（history.<房间>.csv，按「午夜前最后一点 / 午夜后第一点」
归日，充值跳变剔除）。

例：
  powerfee usage                      最近 7 天曲线 + 摘要
  powerfee usage --days 30            最近 30 天
  powerfee usage --month 2026-09      整个 9 月
  powerfee usage --date 2026-10-05    10 月 5 日用了多少
  powerfee usage --png /tmp/usage.png
EOF
}

cmd_usage() {
	local _room_arg="" _days="" _month="" _date="" _png="" _mode="" _val="" _rc=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--days) _days="${2:-}"; shift ;;
		--month) _month="${2:-}"; shift ;;
		--date) _date="${2:-}"; shift ;;
		--png)
			# 人工 CLI 的 --png 是**输出路径**（与 json usage 的 --png 开关不同，别混）。
			# 缺路径或后面跟的是另一个选项 -> 明确报错，不静默不写、也不把选项当路径。
			case "${2:-}" in
			'' | -*)
				echo "--png 需要一个输出路径，例如：powerfee usage --png /tmp/usage.png" >&2
				return 1
				;;
			esac
			_png="$2"
			shift
			;;
		-h | --help) usage_help_text; return 0 ;;
		-*)
			echo "未知选项：$1" >&2
			usage_help_text >&2
			return 1
			;;
		*)
			if [ -n "$_room_arg" ]; then
				echo "多余的参数：$1（房间只能给一个）" >&2
				return 1
			fi
			_room_arg="$1"
			;;
		esac
		[ $# -gt 0 ] && shift
	done
	if [ -n "$_month" ]; then
		_mode=month; _val="$_month"
	elif [ -n "$_date" ]; then
		_mode=date; _val="$_date"
	else
		_mode=days; _val="${_days:-$REPORT_DAYS}"
	fi
	usage_validate_window "$_mode" "$_val" || return 1
	room_select_for_usage "$_room_arg" || return 1
	usage_tmp_init || die "建不了临时目录（/tmp 不可写？）"
	if ! usage_prepare "$_mode" "$_val"; then
		usage_tmp_clean
		echo "没有取到逐日用量数据（逐日接口与本地采样都不可用）" >&2
		echo "  提示：配好 api.daily_url，或先让服务跑出一些采样（powerfee check）" >&2
		return 1
	fi
	usage_render text "$_mode" "$_val" --width 48 --height 10 \
		--title "$(usage_window_label "$_mode" "$_val")"
	_rc=$?
	if [ "$_rc" != "0" ]; then
		echo "曲线渲染失败（原因见 powerfee log）" >&2
	fi
	if [ -n "$_png" ]; then
		if usage_png_write "$_mode" "$_val" "$_png"; then
			echo ""
			echo "曲线已写入：$_png"
		else
			echo "PNG 写入失败：$(head -1 "$ERR_TMP" 2>/dev/null)" >&2
			_rc=1
		fi
	fi
	usage_tmp_clean
	return $_rc
}

report_help_text() {
	cat <<EOF
用法：powerfee report [房间] [--days N]

发一份「今日用量 + 最近 N 天曲线」的报告（邮件 + 推送，走房间自己的
收件人 / 发件账号 / 推送账号，与告警同一套账号体系）：
  * 邮件：HTML 卡片 + 内联 PNG 曲线（multipart/related，直接显示，不是附件）
  * 推送：单行摘要；请求体模板里写 {chart} 会额外带上文本曲线（JSON 通道）

不加房间参数 = 给所有启用的房间各发一份。--days 默认 $REPORT_DAYS。
定时发送：uci set powerfee.main.report_time='21:00'（留空 = 不发）。
EOF
}

report_one_room() {
	# report_one_room <天数>：给「当前房间」发一份报告（邮件 + 推送）
	# 返回 0 = 至少有一个通道发出去了（两个都没启用则返回 1 并记日志）
	local _days="$1" _eml _subj _level _bal _mail_ok="" _push_ok="" _rc=1
	[ "$R_ENABLED" = "1" ] || { log_room "报告：房间已停用，跳过"; return 0; }
	REPORT_DAYS_N="$_days"
	_bal=$(state_get last_balance)
	_level=$(state_get last_level)
	[ -n "$_level" ] || _level=unknown
	usage_tmp_init
	report_chart_prepare "$_days" || true
	if [ "$MAIL_ENABLED" = "1" ] && [ -n "$MAIL_TO" ]; then
		_subj=$(mail_subject report "$_level" "${_bal:-—}" "")
		_eml=$(mktemp /tmp/powerfee.eml.XXXXXX)
		mail_build "$_eml" "$_subj" \
			"$(report_text_body "$_days" "$_level" "$_bal")" \
			"$(report_html_body "$_days" "$_level" "$_bal")" \
			"$MAIL_CHART_PNG"
		mail_send "$_eml" && _mail_ok=1
		rm -f "$_eml"
	else
		log_room "报告邮件未发：邮件未启用（mail.enabled=0）或没有收件人"
	fi
	if [ "$NOTIFY_ENABLED" = "1" ] && [ -n "$NOTIFY_URL" ]; then
		NOTIFY_CHART_FILE=""
		if [ -n "$REPORT_TEXT_CHART" ]; then
			NOTIFY_CHART_FILE="$USAGE_TMP/chart.txt"
			printf '%s\n' "$REPORT_TEXT_CHART" >"$NOTIFY_CHART_FILE"
		fi
		notify_send report "$_level" "${_bal:-—}" "" "" && _push_ok=1
		NOTIFY_CHART_FILE=""
	else
		log_room "报告推送未发：推送未启用或没有地址"
	fi
	usage_tmp_clean
	[ -n "$_mail_ok" ] && _rc=0
	[ -n "$_push_ok" ] && _rc=0
	[ "$_rc" = "0" ] || log_room "报告一个通道都没发出去（检查 mail.enabled / notify.enabled 与收件人、地址）"
	return $_rc
}

cmd_report_all() {
	# 给每个房间发一份报告（守护进程的定时报告与 powerfee report 共用）
	local _days="$1" _id _n=0 _ok=0
	if [ "$ROOM_COUNT" -gt 0 ]; then
		for _id in $ROOM_IDS; do
			if ! room_load "$_id"; then
				log "报告：房间配置 $_id 没有 num（编号），已跳过"
				continue
			fi
			[ "$R_ENABLED" = "1" ] || continue
			room_apply_env
			_n=$((_n + 1))
			report_one_room "$_days" && _ok=$((_ok + 1))
		done
		rooms_select_default
	else
		room_legacy_prepare
		room_apply_env
		if [ -n "$MAIN_ROOM_NUM" ]; then
			_n=1
			report_one_room "$_days" && _ok=1
		else
			log "报告：还没有配置房间，跳过"
			return 0
		fi
	fi
	[ "$_n" -gt 0 ] || return 0
	if [ "$_ok" -gt 0 ]; then
		log "报告已发送：$_ok/$_n 个房间"
		return 0
	fi
	log "报告发送失败：$_n 个房间一个都没发出去"
	return 1
}

cmd_report() {
	local _room_arg="" _days="" _rc
	while [ $# -gt 0 ]; do
		case "$1" in
		--days) _days="${2:-}"; shift ;;
		-h | --help) report_help_text; return 0 ;;
		-*)
			echo "未知选项：$1" >&2
			report_help_text >&2
			return 1
			;;
		*)
			if [ -n "$_room_arg" ]; then
				echo "多余的参数：$1（房间只能给一个；不带房间 = 所有房间各发一份）" >&2
				return 1
			fi
			_room_arg="$1"
			;;
		esac
		[ $# -gt 0 ] && shift
	done
	[ -n "$_days" ] || _days="$REPORT_DAYS"
	usage_validate_window days "$_days" || return 1
	if [ -n "$_room_arg" ]; then
		room_select_for_usage "$_room_arg" || return 1
		report_one_room "$_days"
		return $?
	fi
	cmd_report_all "$_days"
}

cmd_wechat() {
	# powerfee wechat <status|qr|enable|test> [...] —— 微信（ClawBot）推送助手
	# 逻辑全在 python3 助手 /usr/lib/powerfee/wechat.py（LuCI「微信推送」页也走这里）：
	# 服务形态「先探原生包、没有再看 Docker 容器」，日志与配置来源同理。
	local _sub="$1"
	case "$_sub" in
	status | qr | enable | test) ;;
	"" | -h | --help)
		cat <<EOF
用法：powerfee wechat <子命令>

  status                  显示微信服务状态（JSON：装没装/在跑没跑/绑定没绑定/推送配置）
  qr [--json|--out 文件]  输出登录二维码（默认 PNG 到 stdout；--json 输出 base64）
  enable [--bot <bot_id>] 一键写入推送配置（uci + commit）并发送一条测试消息
  test                    只发送一条测试消息

说明：需要 python3；二维码来自服务日志（原生包日志 / syslog / docker logs）。
EOF
		return 0
		;;
	*)
		echo "未知的 wechat 子命令：$_sub" >&2
		return 1
		;;
	esac
	command -v python3 >/dev/null 2>&1 || {
		echo "powerfee: 需要 python3（apk add python3 / opkg install python3-light）" >&2
		return 1
	}
	[ -f "$WECHAT_PY" ] || { echo "powerfee: 缺少 $WECHAT_PY" >&2; return 1; }
	shift
	exec python3 "$WECHAT_PY" "$_sub" "$@"
}

cmd_push() {
	# powerfee push <status|set-serverchan|set-wecom|set-webhook|set-clawbot|off|test>
	# 推送通道管理器（Server酱 / 企业微信 / ClawBot / 自定义 webhook / 关闭），
	# 逻辑全在 python3 助手 /usr/lib/powerfee/push.py —— LuCI「微信推送」页顶部
	# 的通道选择器走的就是这里。
	local _sub="$1"
	case "$_sub" in
	status | set-serverchan | set-wecom | set-webhook | set-clawbot | off | test) ;;
	"" | -h | --help)
		cat <<EOF
用法：powerfee push <子命令>

  status                  当前推送通道与开关状态（JSON，只回掩码，不回密钥）
  set-serverchan <SendKey>    Server酱：写配置 + commit + 立刻发测试消息
  set-wecom <url>             企业微信群机器人：同上
  set-webhook <url> [method] [content_type] [body]
                              自定义 webhook：同上（body 缺省 {"text":"{text}"}）
  set-clawbot [--bot <id>]    切回 ClawBot 通道（读 auth.json 写 url/token）
  off                     关掉推送（notify.enabled=0，通道配置保留）
  test                    只发一条测试消息，不改配置

说明：需要 python3；五个通道走同一条流水线（写 UCI → commit → 发测试），
      测试失败会把服务端原文带回来（Server酱 / 企业微信是 HTTP 200 + 正文报错）。
EOF
		return 0
		;;
	*)
		echo "未知的 push 子命令：$_sub" >&2
		return 1
		;;
	esac
	command -v python3 >/dev/null 2>&1 || {
		echo "powerfee: 需要 python3（apk add python3 / opkg install python3-light）" >&2
		return 1
	}
	[ -f "$PUSH_PY" ] || { echo "powerfee: 缺少 $PUSH_PY" >&2; return 1; }
	shift
	exec python3 "$PUSH_PY" "$_sub" "$@"
}

# ---- 机器可读输出（给 LuCI 界面用）-----------------------------------------

# ---- 不 fork 的转义助手（热路径专用）------------------------------------------
# $(json_str ...) 每次都要 fork 一个子 shell（本机约 1.5 ms），而 status / room-list
# 一次要拼几百个字段 —— 那是它们主要的耗时来源（exec 反而只是小头）。
# 热路径改成先算进下面三个全局，再用 printf 直接引用，零 fork：
#   jstr <值> -> $JF  带引号的 JSON 字符串
#   jnum <值> -> $JN  数字，或 null
#   jbool <值> -> $JB true / false（只有恰好 "1" 算 true，与 json_bool 一致）
jstr() {
	JF="${1//\\/\\\\}"
	JF="${JF//\"/\\\"}"
	JF="${JF//$'\r'/}"
	JF="${JF//$'\n'/}"
	JF="\"$JF\""
}

jnum() {
	case "$1" in
	'' | *[!0-9.eE+-]*) JN=null ;;
	*) JN="$1" ;;
	esac
}

jbool() {
	[ "$1" = "1" ] && JB=true || JB=false
}

json_str() {
	# 字符串 -> JSON 字符串字面量（转义反斜杠与引号，去掉 CR/LF）
	# 纯 shell 实现：这是最热的函数，原来每个字段要起 sed + tr 两个进程。
	# 参数展开的顺序与原 sed|tr 一致（先转义 \，再转义 "，最后去 CR/LF）。
	jstr "$1"
	printf '%s' "$JF"
}

json_num() {
	# 能当数字用就原样输出，否则 null
	jnum "$1"
	printf '%s' "$JN"
}

json_bool() {
	jbool "$1"
	printf '%s' "$JB"
}

room_json_obj() {
	# 输出「当前房间」的 JSON 对象（先 room_apply_env + room_state_load）
	# 注意：notify_url 只回掩码，notify_token 只回「有没有」，密钥不出门；
	# 发件/推送账号回「配的是哪个 + 实际生效的是哪个 + 有没有问题」。
	# 性能：这里原来每个字段都写成 $(json_str ...) —— 每个 $(...) 都要 fork 一个
	# 子 shell（本机约 1.5 ms），一个房间三十多个字段就是几十毫秒，而 status /
	# room-list 每次都要遍历全部房间。改成先转义进全局（JF/JN/JB）再 printf：
	# 纯 shell、零 fork，输出逐字节不变。
	local _tok _upmethod
	[ -n "$NOTIFY_TOKEN" ] && _tok=1 || _tok=0
	_upmethod=$(printf '%s' "$NOTIFY_METHOD" | tr 'a-z' 'A-Z')

	printf '{'
	jstr "$R_ID"; printf '"id":%s' "$JF"
	jstr "$R_SECTION"; printf ',"section":%s' "$JF"
	jstr "$ROOM_NUM"; printf ',"num":%s' "$JF"
	jstr "$R_LABEL"; printf ',"label":%s' "$JF"
	jstr "$ROOM_DISPLAY"; printf ',"display":%s' "$JF"
	jstr "$CAMPUS"; printf ',"campus":%s' "$JF"
	jstr "$BUILDING"; printf ',"building":%s' "$JF"
	jstr "$ROOM"; printf ',"room":%s' "$JF"

	jbool "$R_ENABLED"; printf ',"enabled":%s' "$JB"
	jnum "$THRESHOLD"; printf ',"threshold":%s' "$JN"
	jnum "$RS_BALANCE"; printf ',"balance":%s' "$JN"
	jstr "$RS_LEVEL"; printf ',"level":%s' "$JF"
	jstr "$API_UNIT"; printf ',"unit":%s' "$JF"

	jnum "$RS_OK_AT"; printf ',"last_ok_at":%s' "$JN"
	jstr "$RS_ERR"; printf ',"last_error":%s' "$JF"
	jnum "$RS_ALERT_AT"; printf ',"last_alert_at":%s' "$JN"
	jstr "$RS_ALERT_REASON"; printf ',"last_alert_reason":%s' "$JF"
	jnum "$RS_POLL"; printf ',"poll_count":%s' "$JN"

	jnum "$RS_DAILY"; printf ',"daily":%s' "$JN"
	jnum "$RS_DAYS"; printf ',"days_left":%s' "$JN"
	jstr "$MAIL_TO"; printf ',"mail_to":%s' "$JF"
	jstr "$(mask_url "$NOTIFY_URL")"; printf ',"notify_url":%s' "$JF"
	jbool "$_tok"; printf ',"notify_token_set":%s' "$JB"
	jbool "$NOTIFY_ENABLED"; printf ',"notify_enabled":%s' "$JB"

	jstr "$R_MAIL_ACCOUNT"; printf ',"mail_account":%s' "$JF"
	jstr "$MAIL_ACCOUNT_EFFECTIVE"; printf ',"mail_account_effective":%s' "$JF"
	jstr "${MAIL_FROM:-$MAIL_USER}"; printf ',"mail_sender":%s' "$JF"
	jstr "$MAIL_ACCT_ISSUE"; printf ',"mail_account_issue":%s' "$JF"

	jstr "$R_NOTIFY_ACCOUNT"; printf ',"notify_account":%s' "$JF"
	jstr "$NOTIFY_ACCOUNT_EFFECTIVE"; printf ',"notify_account_effective":%s' "$JF"
	jstr "$NOTIFY_CHANNEL"; printf ',"notify_channel":%s' "$JF"
	jstr "$(notify_channel_name "$NOTIFY_CHANNEL")"; printf ',"notify_channel_name":%s' "$JF"
	jstr "$_upmethod"; printf ',"notify_method":%s' "$JF"
	jstr "$NOTIFY_ACCT_ISSUE"; printf ',"notify_account_issue":%s' "$JF"
	printf '}'
}

rooms_json_array() {
	# 已配置房间的 JSON 数组（单房间模式：main.* 合成的一个元素；没房间时是 []）
	local _id _first=1
	printf '['
	if [ "$ROOM_COUNT" -eq 0 ]; then
		if [ -n "$MAIN_ROOM_NUM" ]; then
			room_legacy_prepare
			room_state_load
			room_json_obj
		fi
	else
		for _id in $ROOM_IDS; do
			if ! room_load "$_id"; then
				[ "$_first" = "1" ] || printf ','
				printf '{"id":%s,"section":%s,"num":"","display":"","enabled":false,"missing_num":true}' \
					"$(json_str "$_id")" "$(json_str "$_id")"
				_first=0
				continue
			fi
			room_apply_env
			room_state_load
			[ "$_first" = "1" ] || printf ','
			room_json_obj
			_first=0
		done
		rooms_select_default
	fi
	printf ']'
}

cmd_json() {
	local _what="$1"
	shift
	local _arg="$1" _limit="$2"
	local _bal _level _ok _err _alert_at _alert_reason _stats _daily _days _running _kind
	local _before _rc _msg _out _pass _rows _id
	local _text _reason _n _total _lines
	local _rf _sum _added _skipped _failed _kv
	case "$_what" in
	status)
		_bal=$(state_get last_balance)
		_level=$(state_get last_level)
		[ -n "$_level" ] || _level=unknown
		_ok=$(state_get last_ok_at)
		_err=$(state_get last_error)
		_alert_at=$(state_get last_alert_at)
		_alert_reason=$(state_get last_alert_reason)
		_stats="- -"
		[ -f "$HISTORY_FILE" ] && _stats=$(compute_stats "$HISTORY_FILE" "${_bal:-0}" "$(now_epoch)")
		_daily=$(echo "$_stats" | awk '{print $1}')
		_days=$(echo "$_stats" | awk '{print $2}')
		[ "$_daily" = "-" ] && _daily=""
		[ "$_days" = "-" ] && _days=""
		_running=false
		if [ -x /etc/init.d/powerfee ]; then
			[ "$(/etc/init.d/powerfee status 2>/dev/null)" = "running" ] && _running=true
		fi
		# 顶层 mail_* / notify_method 的含义与 1.1.0 一致：默认段（mail / notify）的值；
		# 每个房间的有效账号在 rooms[] 对象里（mail_account_effective / notify_channel…）。
		mail_env_apply ""
		notify_env_apply "" "" ""
		_kind=$(mailer_available)
		# 下面的字段全部走「先转义进全局、再 printf」（jstr/jnum/jbool）：
		# 每个 $(json_* ...) 都是一次 fork，status 顶层三十多个字段就是几十毫秒。
		[ -n "$ROOM_NUM" ] && _cfg=1 || _cfg=""
		[ -n "$API_URL" ] && _apiok=1 || _apiok=""
		[ -n "$_kind" ] && _mready=1 || _mready=""
		if active_hours_valid; then _ahv=1; else _ahv=""; fi
		if in_active_window; then _iaw=1; else _iaw=""; fi
		jstr "$VERSION"; printf '{"version":%s' "$JF"
		jbool "$_cfg"; printf ',"configured":%s' "$JB"
		jstr "$ROOM_NUM"; printf ',"room_num":%s' "$JF"
		jstr "$ROOM_DISPLAY"; printf ',"room_display":%s' "$JF"
		jstr "$CAMPUS"; printf ',"campus":%s' "$JF"
		jstr "$BUILDING"; printf ',"building":%s' "$JF"
		jstr "$ROOM"; printf ',"room":%s' "$JF"
		jnum "$_bal"; printf ',"balance":%s' "$JN"
		jstr "$_level"; printf ',"level":%s' "$JF"
		jstr "$API_UNIT"; printf ',"unit":%s' "$JF"
		jstr "$API_URL"; printf ',"api_url":%s' "$JF"
		jbool "$_apiok"; printf ',"api_configured":%s' "$JB"
		jnum "$THRESHOLD"; printf ',"threshold":%s' "$JN"
		jnum "$WARN_RATIO"; printf ',"warn_ratio":%s' "$JN"
		jnum "$_daily"; printf ',"daily":%s' "$JN"
		jnum "$_days"; printf ',"days_left":%s' "$JN"
		jnum "$_ok"; printf ',"last_ok_at":%s' "$JN"
		jstr "$_err"; printf ',"last_error":%s' "$JF"
		jnum "$_alert_at"; printf ',"last_alert_at":%s' "$JN"
		jstr "$_alert_reason"; printf ',"last_alert_reason":%s' "$JF"
		jnum "$(state_get poll_count)"; printf ',"poll_count":%s' "$JN"
		jnum "$INTERVAL"; printf ',"interval":%s' "$JN"
		jnum "$COOLDOWN"; printf ',"cooldown":%s' "$JN"
		jnum "$STALE_HOURS"; printf ',"stale_hours":%s' "$JN"
		jbool "$NOTIFY_WARN"; printf ',"notify_warn":%s' "$JB"
		jbool "$NOTIFY_RECOVERY"; printf ',"notify_recovery":%s' "$JB"
		jbool "$NOTIFY_ERROR"; printf ',"notify_error":%s' "$JB"
		jbool "$MAIN_ENABLED"; printf ',"enabled":%s' "$JB"
		jbool "$MAIL_ENABLED"; printf ',"mail_enabled":%s' "$JB"
		jstr "$MAIL_TO"; printf ',"mail_to":%s' "$JF"
		jstr "$MAIL_HOST"; printf ',"mail_host":%s' "$JF"
		jnum "$MAIL_PORT"; printf ',"mail_port":%s' "$JN"
		jstr "$MAIL_SECURITY"; printf ',"mail_security":%s' "$JF"
		jstr "$_kind"; printf ',"mail_transport":%s' "$JF"
		jbool "$_mready"; printf ',"mail_ready":%s' "$JB"
		jbool "$NOTIFY_ENABLED"; printf ',"notify_enabled":%s' "$JB"
		jstr "$(printf '%s' "$NOTIFY_METHOD" | tr 'a-z' 'A-Z')"; printf ',"notify_method":%s' "$JF"
		jbool "$NOTIFY_HTTP_ENABLED"; printf ',"http_enabled":%s' "$JB"
		jstr "$ACTIVE_HOURS"; printf ',"active_hours":%s' "$JF"
		jbool "$_ahv"; printf ',"active_hours_valid":%s' "$JB"
		jbool "$_iaw"; printf ',"in_active_window":%s' "$JB"
		jnum "$ROOM_COUNT"; printf ',"room_count":%s' "$JN"
		# 注意：下面这几行**不能**再带前导逗号 —— "rooms" 那行的 %s 后面已经有一个逗号了
		printf ',"rooms":%s,' "$(rooms_json_array)"
		jnum "$MAIL_ACCT_COUNT"; printf '"mail_account_count":%s,' "$JN"
		jnum "$PUSH_ACCT_COUNT"; printf '"push_account_count":%s,' "$JN"
		printf '"mail_accounts":%s,' "$(acct_json_array mail_account)"
		printf '"push_accounts":%s,' "$(acct_json_array push_account)"
		printf '"account_issues":%s,' "$(acct_issues_json)"
		printf '"service_running":%s' "$_running"
		printf '}\n'
		;;
	groups)
		# 校区 -> 楼栋（供界面做级联下拉）
		if ! fetch_rooms; then
			# 界面拿到空响应会很难查，失败也返回合法 JSON
			printf '{"groups":[],"error":%s}\n' "$(json_str "$(head -1 "$ERR_TMP")")"
			return 1
		fi
		_rows=$(jsonfilter -i "$API_TMP" -e "$API_ROOMS_PATH" 2>/dev/null)
		if [ -z "$_rows" ]; then
			# 请求成功但取不到房间数组：多半是 rooms_path 配错了，界面需要看到原因
			printf '{"groups":[],"error":%s}\n' \
				"$(json_str "接口返回里没有房间列表（检查 api.rooms_path=$API_ROOMS_PATH 是否指向房间数组）")"
			return 1
		fi
		printf '%s\n' "$_rows" |
			awk -v fc="$API_FIELD_CAMPUS" -v fb="$API_FIELD_BUILDING" "$AWK_JGET"'
			{
				c = jget($0, fc); b = jget($0, fb)
				if (c == "") c = "（未分类）"
				if (!(c in cseen)) { cseen[c] = 1; camp[++nc] = c }
				bk = c "\034" b
				if (b != "" && !(bk in bseen)) { bseen[bk] = 1; blist[c] = blist[c] "\001" b }
			}
			END {
				printf "{\"groups\":["
				for (i = 1; i <= nc; i++) {
					c = camp[i]
					if (i > 1) printf ","
					printf "{\"campus\":\"%s\",\"buildings\":[", jesc(c)
					n = split(blist[c], arr, "\001"); first = 1
					for (j = 1; j <= n; j++) {
						if (arr[j] == "") continue
						if (!first) printf ","
						first = 0
						printf "\"%s\"", jesc(arr[j])
					}
					printf "]}"
				}
				printf "]}\n"
			}
		'
		;;
	rooms)
		# json rooms [关键词] [最多返回条数]
		if ! fetch_rooms; then
			printf '{"rooms":[],"shown":0,"total":0,"truncated":false,"error":%s}\n' "$(json_str "$(head -1 "$ERR_TMP")")"
			return 1
		fi
		[ -n "$_limit" ] || _limit=500
		_rows=$(jsonfilter -i "$API_TMP" -e "$API_ROOMS_PATH" 2>/dev/null)
		if [ -z "$_rows" ]; then
			printf '{"rooms":[],"shown":0,"total":0,"truncated":false,"error":%s}\n' \
				"$(json_str "接口返回里没有房间列表（检查 api.rooms_path=$API_ROOMS_PATH 是否指向房间数组）")"
			return 1
		fi
		printf '%s\n' "$_rows" |
			awk -v limit="$_limit" -v kw="$_arg" \
				-v fi="$API_FIELD_ID" -v fr="$API_FIELD_NAME" -v fb="$API_FIELD_BUILDING" \
				-v fc="$API_FIELD_CAMPUS" -v fv="$API_FIELD_BALANCE" "$AWK_JGET"'
			BEGIN { printf "{\"rooms\":[" ; n = 0; total = 0 }
			{
				r = jget($0, fr); b = jget($0, fb); c = jget($0, fc)
				if (kw != "" && index(r, kw) == 0 && index(b, kw) == 0 && index(c, kw) == 0) next
				total++
				if (n >= limit) next
				n++
				if (n > 1) printf ","
				printf "{\"id\":\"%s\",\"campus\":\"%s\",\"building\":\"%s\",\"room\":\"%s\",\"balance\":\"%s\"}",
					jesc(jget($0, fi)), jesc(c), jesc(b), jesc(r), jesc(jget($0, fv))
			}
			END { printf "],\"shown\":%d,\"total\":%d,\"truncated\":%s}\n", n, total, (total > n ? "true" : "false") }
		'
		;;
	brief)
		# 单行摘要：与 webhook 的 {text} 同一实现，方便机器人直接转发
		_bal=$(state_get last_balance)
		_level=$(state_get last_level)
		[ -n "$_level" ] || _level=unknown
		case "$_level" in
		low) _reason=low ;;
		warn) _reason=warn ;;
		*) _reason=force ;;
		esac
		_stats="- -"
		[ -f "$HISTORY_FILE" ] && _stats=$(compute_stats "$HISTORY_FILE" "${_bal:-0}" "$(now_epoch)")
		_daily=$(echo "$_stats" | awk '{print $1}')
		_days=$(echo "$_stats" | awk '{print $2}')
		[ "$_daily" = "-" ] && _daily=""
		[ "$_days" = "-" ] && _days=""
		printf '{"ok":true,"text":%s,"balance":%s,"level":%s,"unit":%s}\n' \
			"$(json_str "$(notify_text "$_reason" "$_level" "${_bal:-—}" "$_daily" "$_days" "")")" \
			"$(json_num "$_bal")" "$(json_str "$_level")" "$(json_str "$API_UNIT")"
		;;
	usage)
		# json usage [房间] [--days N] [--month YYYY-MM] [--date YYYY-MM-DD] [--png [路径]]
		# 给机器人/微信桥接用：text 是文本曲线（宽 32、高 8，聊天窗口里不折行），
		# days 是逐日数组，summary 是合计/日均/最高/最低。
		# png_base64 只在显式加 --png 时给 —— 别把 3 KB base64 塞进每次轮询。
		# 这里的 --png 是**开关**；但它也可以像人工 CLI 那样再跟一个输出路径
		# （`json usage --png /tmp/x.png`）：给了就额外把 PNG 写到那个文件，
		# 结果（成功/失败原因）写 stderr —— JSON 形状一个字段都不变。
		local _u_room="" _u_days="" _u_month="" _u_date="" _u_png="" _u_png_out="" _umode="" _uval="" _urc=0
		while [ $# -gt 0 ]; do
			case "$1" in
			--days) _u_days="${2:-}"; [ $# -gt 1 ] && shift ;;
			--month) _u_month="${2:-}"; [ $# -gt 1 ] && shift ;;
			--date) _u_date="${2:-}"; [ $# -gt 1 ] && shift ;;
			--png)
				_u_png=1
				# 后面那个参数只有「像路径」时才吃掉（否则它就是房间参数，别抢）
				if [ $# -gt 1 ] && png_path_like "$2"; then
					_u_png_out="$2"
					shift
				fi
				;;
			--room) _u_room="${2:-}"; [ $# -gt 1 ] && shift ;;
			*)
				[ -n "$_u_room" ] || _u_room="$1"
				;;
			esac
			[ $# -gt 0 ] && shift
		done
		if [ -n "$_u_month" ]; then
			_umode=month; _uval="$_u_month"
		elif [ -n "$_u_date" ]; then
			_umode=date; _uval="$_u_date"
		else
			_umode=days; _uval="${_u_days:-$REPORT_DAYS}"
		fi
		if ! usage_validate_window "$_umode" "$_uval" 2>/dev/null; then
			printf '{"ok":false,"error":%s,"text":%s,"days":[]}\n' \
				"$(json_str "天数/月份/日期格式不对（--days 1~92 / --month YYYY-MM / --date YYYY-MM-DD）")" \
				"$(json_str "（参数不对）")"
			return 1
		fi
		if ! room_select_for_usage "$_u_room" 2>/dev/null; then
			printf '{"ok":false,"error":%s,"text":%s,"days":[]}\n' \
				"$(json_str "还没有设置监控房间")" "$(json_str "（未设置房间）")"
			return 1
		fi
		usage_tmp_init
		if ! usage_prepare "$_umode" "$_uval" 2>/dev/null; then
			usage_tmp_clean
			printf '{"ok":false,"error":%s,"text":%s,"days":[],"source":"","unit":%s}\n' \
				"$(json_str "没有取到逐日用量数据（逐日接口与本地采样都不可用）")" \
				"$(json_str "（无数据）")" "$(json_str "$API_UNIT")"
			return 1
		fi
		usage_render json "$_umode" "$_uval" --width 32 --height 8 \
			--title "$(usage_window_label "$_umode" "$_uval")" \
			${_u_png:+--png-base64} --png-title "Daily usage" \
			--png-unit "$(png_unit_of "$API_UNIT")"
		_urc=$?
		if [ -n "$_u_png_out" ]; then
			# --png 带了路径：顺带把文件写出来。写失败只提示（JSON 结果不变），
			# 因为机器口的主要契约是 stdout 的 JSON，文件是附带的便利。
			if usage_png_write "$_umode" "$_uval" "$_u_png_out"; then
				echo "曲线已写入：$_u_png_out" >&2
			else
				echo "写 PNG 失败：$_u_png_out（$(head -n 1 "$ERR_TMP" 2>/dev/null)）" >&2
			fi
		fi
		usage_tmp_clean
		return $_urc
		;;
	history)
		# json history [条数]：最近采样点 + 日均估算
		_n="$_arg"
		case "$_n" in '' | *[!0-9]*) _n=20 ;; esac
		[ "$_n" -gt 500 ] 2>/dev/null && _n=500
		_total=0
		_stats="- -"
		if [ -f "$HISTORY_FILE" ]; then
			_total=$(wc -l <"$HISTORY_FILE" | tr -d ' ')
			_stats=$(compute_stats "$HISTORY_FILE" "$(state_get last_balance)" "$(now_epoch)")
		fi
		_daily=$(echo "$_stats" | awk '{print $1}')
		_days=$(echo "$_stats" | awk '{print $2}')
		[ "$_daily" = "-" ] && _daily=""
		[ "$_days" = "-" ] && _days=""
		printf '{"ok":true,"unit":%s,"points":' "$(json_str "$API_UNIT")"
		if [ -f "$HISTORY_FILE" ]; then
			tail -n "$_n" "$HISTORY_FILE" | awk -F, '
				BEGIN { printf "[" }
				NF >= 2 && $1 ~ /^[0-9]+$/ {
					n++
					if (n > 1) printf ","
					printf "{\"t\":%s,\"balance\":%s}", $1, ($2 ~ /^-?[0-9.]+$/ ? $2 : "null")
				}
				END { printf "]" }
			'
		else
			printf '[]'
		fi
		printf ',"total":%s,"daily":%s,"days_left":%s}\n' \
			"$(json_num "$_total")" "$(json_num "$_daily")" "$(json_num "$_days")"
		;;
	log)
		# json log [行数]：最近日志（文件不在时退回 syslog）
		_n="$_arg"
		case "$_n" in '' | *[!0-9]*) _n=40 ;; esac
		[ "$_n" -gt 500 ] 2>/dev/null && _n=500
		_lines=""
		if [ -f "$LOG_FILE" ]; then
			_lines=$(tail -n "$_n" "$LOG_FILE")
		else
			_lines=$(logread -e powerfee 2>/dev/null | tail -n "$_n")
		fi
		if [ -n "$_lines" ]; then
			printf '{"ok":true,"lines":['
			printf '%s\n' "$_lines" | awk "$AWK_JGET"'
				{ n++; if (n > 1) printf ","; printf "\"%s\"", jesc($0) }
				END { printf "],\"count\":%d}\n", n }
			'
		else
			printf '{"ok":true,"lines":[],"count":0}\n'
		fi
		;;
	check)
		# 立即查一次，返回结果（供界面「立即查询」按钮）
		# 注意：窗口外会跳过（不查接口），返回里 skipped=true，界面据此提示
		_before=$(state_get last_ok_at)
		CHECK_SKIPPED=""
		cmd_check 0
		_rc=$?
		# 多房间时 cmd_check 把「当前房间」停在最后一个房间上，这里换回默认房间再汇报
		[ "$ROOM_COUNT" -gt 0 ] && rooms_select_default
		_bal=$(state_get last_balance)
		_level=$(state_get last_level)
		[ -n "$_level" ] || _level=unknown
		printf '{"ok":%s,"balance":%s,"level":%s,"reason":%s,"error":%s,"in_active_window":%s,"skipped":%s,"active_hours":%s,"rooms":%s}\n' \
			"$([ "$_rc" = "0" ] && echo true || echo false)" \
			"$(json_num "$_bal")" "$(json_str "$_level")" \
			"$(json_str "$(state_get last_alert_reason)")" "$(json_str "$(state_get last_error)")" \
			"$(json_bool "$(in_active_window && echo 1)")" "$(json_bool "${CHECK_SKIPPED:-}")" \
			"$(json_str "$ACTIVE_HOURS")" "$(rooms_json_array)"
		;;
	room-list)
		# 已配置房间的完整列表（含余额/档位/收件人/发件账号/推送通道；密钥只回掩码）
		printf '{"ok":true,"count":%s,"rooms":%s}\n' "$(json_num "$ROOM_COUNT")" "$(rooms_json_array)"
		;;
	mail-accounts)
		# 命名发件账号（密钥类字段只回「是否已设置」与掩码，真值不出门）
		printf '{"ok":true,"count":%s,"accounts":%s,"issues":%s}\n' \
			"$(json_num "$MAIL_ACCT_COUNT")" "$(acct_json_array mail_account)" "$(acct_issues_json)"
		;;
	push-accounts)
		# 命名推送账号（同上：token 只回是否已设置，地址只回掩码）
		printf '{"ok":true,"count":%s,"accounts":%s,"issues":%s}\n' \
			"$(json_num "$PUSH_ACCT_COUNT")" "$(acct_json_array push_account)" "$(acct_issues_json)"
		;;
	room-add)
		# json room-add <房间号或关键词> [--id 段名] [--mail-to 邮箱] ...
		# 单个目标（且没有 --batch）：保持老输出形状。
		# 多目标 / 带 --batch：批量添加，额外给逐房间的 results[] 与计数
		# （added/skipped/failed/total）；部分失败时 ok=false 且退出码非 0。
		# 注意：cmd_room_add 在子 shell 里跑（$(...)），它改的全局变量不会传回来，
		# 所以这里要重新 load_config 才能看到新房间
		room_add_scan "$@"
		if [ "$PF_ADD_TARGETS" -gt 1 ] || [ -n "$PF_ADD_BATCH" ]; then
			_rf=$(mktemp /tmp/powerfee.add.XXXXXX 2>/dev/null)
			PF_ADD_RESULTS_FILE="$_rf"
			_msg=$(cmd_room_add "$@" 2>&1)
			_rc=$?
			load_config
			_added=0
			_skipped=0
			_failed=0
			_total=0
			if [ -n "$_rf" ] && [ -s "$_rf" ]; then
				_sum=$(tail -n 1 "$_rf")
				case "$_sum" in
				added=*)
					for _kv in $_sum; do
						case "$_kv" in
						added=*) _added="${_kv#added=}" ;;
						skipped=*) _skipped="${_kv#skipped=}" ;;
						failed=*) _failed="${_kv#failed=}" ;;
						total=*) _total="${_kv#total=}" ;;
						esac
					done
					;;
				esac
			fi
			printf '{"ok":%s,"message":%s,"count":%s,"added":%s,"skipped":%s,"failed":%s,"total":%s,"results":%s,"rooms":%s}\n' \
				"$([ "$_rc" = "0" ] && echo true || echo false)" "$(json_str "$_msg")" \
				"$(json_num "$ROOM_COUNT")" "${_added:-0}" "${_skipped:-0}" "${_failed:-0}" "${_total:-0}" \
				"$(room_add_results_json "$_rf")" "$(rooms_json_array)"
			[ -n "$_rf" ] && rm -f "$_rf"
			return $_rc
		fi
		_msg=$(cmd_room_add "$@" 2>&1)
		_rc=$?
		load_config
		printf '{"ok":%s,"message":%s,"count":%s,"rooms":%s}\n' \
			"$([ "$_rc" = "0" ] && echo true || echo false)" "$(json_str "$_msg")" \
			"$(json_num "$ROOM_COUNT")" "$(rooms_json_array)"
		return $_rc
		;;
	room-remove)
		# json room-remove <段名或编号>
		_msg=$(cmd_room_remove "$_arg" 2>&1)
		_rc=$?
		load_config
		printf '{"ok":%s,"message":%s,"count":%s,"rooms":%s}\n' \
			"$([ "$_rc" = "0" ] && echo true || echo false)" "$(json_str "$_msg")" \
			"$(json_num "$ROOM_COUNT")" "$(rooms_json_array)"
		return $_rc
		;;
	room-set)
		# json room-set <段名或编号> <键> <值>
		_msg=$(cmd_room_set "$@" 2>&1)
		_rc=$?
		load_config
		printf '{"ok":%s,"message":%s,"rooms":%s}\n' \
			"$([ "$_rc" = "0" ] && echo true || echo false)" "$(json_str "$_msg")" \
			"$(rooms_json_array)"
		return $_rc
		;;
	room-save)
		# json room-save <段名或编号> <键=值> [<键=值> ...]：批量写一个房间（只 commit 一次）
		_id=$(room_resolve_id "$_arg") || {
			printf '{"ok":false,"error":%s,"rooms":%s}\n' \
				"$(json_str "没有找到房间：$_arg（用 room-list 查看段名）")" "$(rooms_json_array)"
			return 1
		}
		shift
		_msg=$(room_write_kv "$_id" "$@" 2>&1)
		_rc=$?
		load_config
		printf '{"ok":%s,"message":%s,"id":%s,"rooms":%s}\n' \
			"$([ "$_rc" = "0" ] && echo true || echo false)" "$(json_str "$_msg")" \
			"$(json_str "$_id")" "$(rooms_json_array)"
		return $_rc
		;;
	test-mail)
		_bal=$(state_get last_balance)
		_level=$(state_get last_level)
		[ -n "$_level" ] || _level=ok
		_stats=$(compute_stats "$HISTORY_FILE" "${_bal:-0}" "$(now_epoch)")
		_msg=$(mail_alert test "$_level" "${_bal:-—}" "$(echo "$_stats" | awk '{print $1}')" "$(echo "$_stats" | awk '{print $2}')" 2>&1)
		_rc=$?
		printf '{"ok":%s,"message":%s}\n' "$([ "$_rc" = "0" ] && echo true || echo false)" "$(json_str "$_msg")"
		;;
	notify-test)
		_msg=$(cmd_notify_test 2>&1)
		_rc=$?
		printf '{"ok":%s,"message":%s}\n' "$([ "$_rc" = "0" ] && echo true || echo false)" "$(json_str "$_msg")"
		;;
	set-room)
		_msg=$(cmd_set_room "$_arg" 2>&1)
		_rc=$?
		printf '{"ok":%s,"room_num":%s,"room_display":%s,"message":%s}\n' \
			"$([ "$_rc" = "0" ] && echo true || echo false)" \
			"$(json_str "$(pf_uci -q get powerfee.main.room_num)")" \
			"$(json_str "$(pf_uci -q get powerfee.main.building) $(pf_uci -q get powerfee.main.room)")" \
			"$(json_str "$_msg")"
		;;
	selftest)
		_out=$(selftest 2>&1)
		_rc=$?
		_pass=$(echo "$_out" | sed -n 's/^全部通过（\([0-9]*\) 项）$/\1/p')
		printf '{"ok":%s,"passed":%s,"failed":%s}\n' "$([ "$_rc" = "0" ] && echo true || echo false)" \
			"$(json_num "${_pass:-0}")" "$([ "$_rc" = "0" ] && echo 0 || echo 1)"
		;;
	"" | -h | --help)
		echo "用法：powerfee json <子命令>" >&2
		echo "  status | brief | groups | rooms [关键词] [条数] | history [条数] | log [行数] | check" >&2
		echo "  usage [房间] [--days N|--month YYYY-MM|--date YYYY-MM-DD] [--png [路径]]  每日用电量（文本曲线+逐日数组）" >&2
		echo "  test-mail [房间] | notify-test [房间] | set-room <房间号> | selftest" >&2
		echo "  room-list | room-add <房间号> [--id 段名] [--mail-to 邮箱] …" >&2
		echo "             room-add 也可以一次给多个编号（批量添加，只请求接口一次）" >&2
		echo "  room-remove <段名|编号> | room-set <段名|编号> <键> <值> | room-save <段名|编号> <键=值> …" >&2
		echo "  mail-accounts | push-accounts  命名账号列表（密钥只回掩码/是否已设置）" >&2
		return 1
		;;
	*)
		echo "未知的 json 子命令：$_what" >&2
		return 1
		;;
	esac
}

cmd_daemon() {
	local _win=""
	load_config
	if [ -n "$REPORT_TIME" ] && [ -z "$(report_time_norm "$REPORT_TIME")" ]; then
		log "main.report_time='$REPORT_TIME' 格式无效（要 HH:MM，如 21:00），已按「不发报告」处理"
	fi
	if [ "$ROOM_COUNT" -gt 0 ]; then
		log "守护进程启动：间隔 ${INTERVAL}s，多房间模式（$ROOM_COUNT 个房间），查询时段 ${ACTIVE_HOURS:-全天}，定时报告 ${REPORT_TIME:-未启用}"
	else
		log "守护进程启动：间隔 ${INTERVAL}s，房间 $ROOM_DISPLAY（编号 ${ROOM_NUM:-未设置}），查询时段 ${ACTIVE_HOURS:-全天}，定时报告 ${REPORT_TIME:-未启用}"
	fi
	while :; do
		load_config
		if [ "$MAIN_ENABLED" != "1" ]; then
			sleep 300
			continue
		fi
		# 定时报告：到点才动手（独立事件 —— 不查接口、不改告警档位、不动冷却去重）
		report_maybe_send
		if in_active_window; then
			# 回到窗口内：把窗口外的时长从失效判定基准里扣掉（无暂停记录时是空操作）
			active_pause_resume
			if [ "$_win" = "out" ]; then
				log "已回到查询时段（active_hours=$ACTIVE_HOURS），恢复查询"
			fi
			_win="in"
			# 睡眠取「查询间隔」与「距下一次报告时刻」里更小的那个：
			# 报告时间点在查询时段之外时，靠这个把循环叫醒（否则会一觉睡过报告点）
			if cmd_check 0; then
				sleep "$(sleep_with_report_cap "$INTERVAL")"
			else
				sleep "$(sleep_with_report_cap "$RETRY_INTERVAL")"
			fi
		else
			# 窗口外：不查接口，但进程照常活着；每分钟醒一次，到点即恢复。
			# 暂停起点记在 window.state 里，回到窗口时用于顺延 last_ok_at（不误报监控失效）。
			active_pause_mark
			if [ "$_win" != "out" ]; then
				log "已进入非查询时段（active_hours=$ACTIVE_HOURS），暂停查询；窗口外时长不计入监控失效判定"
			fi
			_win="out"
			sleep 60
		fi
	done
}

# ---- 自检（与托盘版 --selftest 同风格）-------------------------------------

selftest() {
	local _pass=0 _fail=0 _now _tmp _i _taken100 _save_fi _save_fn

	check() {
		if [ "$1" = "$2" ]; then
			_pass=$((_pass + 1))
			printf '  PASS  %s\n' "$3"
		else
			_fail=$((_fail + 1))
			printf '  FAIL  %s（期望「%s」，实际「%s」）\n' "$3" "$1" "$2"
		fi
	}

	echo "判定逻辑自检："
	check low "$(level_of 19.99 20 2)" "低于阈值 -> low"
	check low "$(level_of -0.16 20 2)" "负余额 -> low"
	check warn "$(level_of 20 20 2)" "正好等于阈值 -> warn（阈值本身不算不足）"
	check warn "$(level_of 39.99 20 2)" "预警区内 -> warn"
	check ok "$(level_of 40 20 2)" "等于 阈值×2 -> ok"
	check ok "$(level_of 100 20 2)" "充足 -> ok"

	_now=1759824000
	check "" "$(decide_notify ok 0 ok $_now 180 1 1)" "一直是 ok：不提醒"
	check "ok->warn" "$(decide_notify ok 0 warn $_now 180 1 1)" "ok 变 warn：提醒"
	check "" "$(decide_notify ok 0 warn $_now 180 0 1)" "ok 变 warn 但预警静音：不提醒"
	check "warn->low" "$(decide_notify warn 0 low $_now 180 1 1)" "warn 变 low：提醒"
	check "unknown->low" "$(decide_notify unknown 0 low $_now 180 1 1)" "首次查询就是低电量：提醒"
	check "" "$(decide_notify low $((_now - 60)) low $_now 180 1 1)" "持续低电量且未到冷却：不提醒"
	check "repeat-low" "$(decide_notify low $((_now - 10800)) low $_now 180 1 1)" "持续低电量超过冷却：重复提醒"
	check "repeat-low" "$(decide_notify low 0 low $_now 180 1 1)" "从未提醒过的低电量：立即提醒"
	check "recovered" "$(decide_notify low $_now ok $_now 180 1 1)" "充值恢复：提醒一次"
	check "recovered" "$(decide_notify low $_now warn $_now 180 1 1)" "从 low 回到 warn：也算恢复"
	check "" "$(decide_notify low $_now ok $_now 180 1 0)" "恢复提醒关闭：不提醒"
	check "recovered" "$(decide_notify low $_now warn $_now 180 0 1)" "low 回升到 warn：按恢复提醒（与原版一致）"
	check "" "$(decide_notify warn $_now ok $_now 180 1 1)" "warn 回到 ok：不提醒（只对 low 的恢复提醒）"
	check "" "$(decide_notify unknown $_now ok $_now 180 1 1)" "unknown 变 ok：不提醒"

	echo ""
	echo "日均估算自检："
	_tmp=$(mktemp /tmp/powerfee.st.XXXXXX)
	# 三天掉 9.6 度 -> 3.2 度/天；余额 32 -> 10 天
	printf '%s,50\n%s,45.2\n%s,40.4\n' $((_now - 72 * 3600)) $((_now - 36 * 3600)) "$_now" >"$_tmp"
	check "3.20 10.0" "$(compute_stats "$_tmp" 32 "$_now")" "72 小时用 9.6 度：日均 3.20、可用 10.0 天"
	printf '%s,50\n%s,50\n' $((_now - 6 * 3600)) "$_now" >"$_tmp"
	check "0.00 -" "$(compute_stats "$_tmp" 32 "$_now")" "6 小时余额没变化：日均 0、天数算不出"
	printf '%s,50\n' "$_now" >"$_tmp"
	check "- -" "$(compute_stats "$_tmp" 32 "$_now")" "只有一个采样点：算不出"
	printf '%s,50\n%s,48\n' $((_now - 3600)) "$_now" >"$_tmp"
	check "- -" "$(compute_stats "$_tmp" 32 "$_now")" "跨度不足 3 小时：算不出"
	# 10 个点全在 72 小时窗口外 -> 回退用最后 8 个点（跨度 7 小时、掉 7 度 -> 24 度/天）
	: >"$_tmp"
	_i=0
	while [ "$_i" -lt 10 ]; do
		printf '%s,%s\n' $((_now - 100 * 3600 + _i * 3600)) $((50 - _i)) >>"$_tmp"
		_i=$((_i + 1))
	done
	check "24.00 1.3" "$(compute_stats "$_tmp" 32 "$_now")" "全部超出 72 小时窗口：回退用最后 8 个点"
	rm -f "$_tmp"

	echo ""
	echo "查询时段自检（active_window_check：in/out/invalid）："
	check in "$(active_window_check '' '12:00')" "留空 = 全天查询（老配置的行为）"
	check in "$(active_window_check '07:00-23:00' '07:00')" "窗口起点算在时段内"
	check in "$(active_window_check '07:00-23:00' '12:00')" "时段中间"
	check in "$(active_window_check '07:00-23:00' '22:59')" "终点前 1 分钟仍在时段内"
	check out "$(active_window_check '07:00-23:00' '23:00')" "终点不含（23:00 起停止查询）"
	check out "$(active_window_check '07:00-23:00' '06:59')" "起点前 1 分钟在时段外"
	check out "$(active_window_check '07:00-23:00' '00:30')" "深夜在时段外"
	check in "$(active_window_check '22:00-06:00' '23:30')" "跨天段：午夜前（23:30）"
	check in "$(active_window_check '22:00-06:00' '05:59')" "跨天段：午夜后（05:59）"
	check out "$(active_window_check '22:00-06:00' '06:00')" "跨天段：终点不含（06:00）"
	check out "$(active_window_check '22:00-06:00' '12:00')" "跨天段：白天在时段外"
	check in "$(active_window_check '07:00-12:00 14:00-23:00' '09:00')" "多段：第一段内"
	check out "$(active_window_check '07:00-12:00 14:00-23:00' '13:00')" "多段：两段之间"
	check in "$(active_window_check '07:00-12:00 14:00-23:00' '15:00')" "多段：第二段内"
	check in "$(active_window_check ' 07:00-23:00 ' '12:00')" "多余空格不影响解析"
	check in "$(active_window_check '00:00-00:00' '03:00')" "起止相同 = 全天"
	check invalid "$(active_window_check '7:00-23' '12:00')" "缺分钟：识别为无效"
	check invalid "$(active_window_check '25:00-26:00' '12:00')" "小时越界：识别为无效"
	check invalid "$(active_window_check '07:00~23:00' '12:00')" "分隔符写错：识别为无效"
	check invalid "$(active_window_check '07:00-23:00' '12:60')" "分钟越界：识别为无效"
	_save_ah="$ACTIVE_HOURS"
	ACTIVE_HOURS="25:00-26:00"
	check 0 "$(in_active_window 12:00; echo $?)" "无效配置按全天处理（宁可多查，不静默失效）"
	ACTIVE_HOURS="07:00-23:00"
	check 1 "$(in_active_window 23:30; echo $?)" "in_active_window：时段外返回 1"
	check 0 "$(in_active_window 12:00; echo $?)" "in_active_window：时段内返回 0"
	ACTIVE_HOURS="$_save_ah"

	echo ""
	echo "命名账号自检（1.2.0：通道判定 / 地址推导 / 取值优先级）："
	check serverchan "$(notify_channel_of 'https://sctapi.ftqq.com/SCT123456.send')" "Server酱 经典版地址"
	check serverchan "$(notify_channel_of 'https://1234.push.ft07.com/send/sctp1234tabc.send')" "Server酱³ 地址（*.push.ft07.com）"
	check wecom "$(notify_channel_of 'https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=abc')" "企业微信群机器人地址"
	check clawbot "$(notify_channel_of 'http://127.0.0.1:26322/bots/bot1/messages')" "本机 ClawBot API 地址"
	check custom "$(notify_channel_of 'https://example.com/hook')" "其它地址 = 自定义 webhook"
	check none "$(notify_channel_of '')" "没有地址 = 未配置"
	check "https://sctapi.ftqq.com/SCT123456.send" "$(serverchan_url_of SCT123456)" "SendKey -> 经典版推送地址"
	check "https://1234.push.ft07.com/send/sctp1234tabc.send" "$(serverchan_url_of sctp1234tabc)" "Server酱³ 的 key -> 对应域名"
	check "" "$(serverchan_url_of '')" "空 SendKey 不拼地址"
	check "http://127.0.0.1:26322/bots/bot1/messages" "$(clawbot_url_of bot1 26322)" "bot_id + 端口 -> ClawBot 推送地址"
	check '{"title":"{title}","desp":"{text}"}' "$(push_body_default serverchan)" "Server酱 默认请求体"
	check '{"msgtype":"text","text":{"content":"{text}"}}' "$(push_body_default wecom)" "企业微信 默认请求体"
	check '{"text":"{text}"}' "$(push_body_default custom)" "自定义通道默认请求体"
	check "房间值" "$(acct_pick3 房间值 账号值 默认值)" "取值优先级：房间级 > 账号级"
	check "账号值" "$(acct_pick3 '' 账号值 默认值)" "房间级留空 -> 账号级"
	check "默认值" "$(acct_pick3 '' '' 默认值)" "房间与账号都留空 -> 默认段"
	check 0 "$(acct_name_valid qq_main; echo $?)" "账号名 qq_main 合法"
	check 1 "$(acct_name_valid 'bad name'; echo $?)" "账号名含空格被拒（会坏 uci 键路径）"
	check 1 "$(acct_name_valid 'a/b'; echo $?)" "账号名含斜杠被拒"
	check "Server酱" "$(notify_channel_name serverchan)" "通道中文名"
	check "未配置" "$(notify_channel_name '')" "空通道 = 未配置"

	echo ""
	echo "每日用电量自检（1.2.0：月份换算 / 报告时间 / 请求体模板 / 窗口校验）："
	check "2026-10" "$(month_next 2026-09)" "月份 +1"
	check "2027-01" "$(month_next 2026-12)" "月份 +1 跨年"
	check "2026-09" "$(month_prev 2026-10)" "月份 -1"
	check "2026-12" "$(month_prev 2027-01)" "月份 -1 跨年"
	check "8" "$(dec_of 08)" "前导零：08 -> 8（ash 会把 08 当八进制，先剥掉）"
	check "2026-10" "$(month_of_date 2026-10-05)" "日期 -> 月份"
	check "21:00" "$(report_time_norm 21:00)" "报告时间规整"
	check "09:05" "$(report_time_norm 9:5)" "报告时间补零"
	check "" "$(report_time_norm 25:00)" "非法报告时间 -> 空（按不发处理）"
	check "" "$(report_time_norm abc)" "非时间 -> 空"
	check 86400 "$(report_sleep_cap)" "没设报告时间：不截短守护进程的睡眠"
	_save_db="$DAILY_BODY"
	DAILY_BODY="$D_DAILY_BODY"
	check "roomNum=1001&lastDate=2026-10&type=2&pageNum=1&pageSize=31" \
		"$(daily_body_render 1001 2026-10 1 31)" "请求体模板替换（{room}/{month}/{page}/{page_size}）"
	DAILY_BODY="$_save_db"
	check 0 "$(usage_validate_window days 7 >/dev/null 2>&1; echo $?)" "窗口校验：--days 7 合法"
	check 1 "$(usage_validate_window days 0 >/dev/null 2>&1; echo $?)" "窗口校验：--days 0 非法"
	check 1 "$(usage_validate_window month 2026-1 >/dev/null 2>&1; echo $?)" "窗口校验：月份要 YYYY-MM"
	check 0 "$(usage_validate_window date 2026-10-05 >/dev/null 2>&1; echo $?)" "窗口校验：日期 YYYY-MM-DD 合法"
	check kWh "$(png_unit_of 度)" "PNG 单位：非 ASCII（度）-> kWh"
	check V "$(png_unit_of V)" "PNG 单位：ASCII 原样"
	check 0 "$(png_path_like /tmp/usage.png >/dev/null 2>&1; echo $?)" "--png 路径识别：/ 开头（/tmp/usage.png）"
	check 0 "$(png_path_like out.png >/dev/null 2>&1; echo $?)" "--png 路径识别：.png 结尾（out.png）"
	check 1 "$(png_path_like room1 >/dev/null 2>&1; echo $?)" "--png 路径识别：段名（room1）不算路径"
	check 1 "$(png_path_like 1234 >/dev/null 2>&1; echo $?)" "--png 路径识别：房间编号（1234）不算路径"

	echo ""
	echo "JSON 转义自检（1.2.4：热路径改成不 fork 的全局输出 jstr/jnum/jbool）："
	check '"a\"b"' "$(jstr 'a"b'; printf '%s' "$JF")" "jstr：引号转义"
	check '"a\\b"' "$(jstr 'a\b'; printf '%s' "$JF")" "jstr：反斜杠转义"
	check '"ab"' "$(jstr "$(printf 'a\nb')"; printf '%s' "$JF")" "jstr：去掉换行"
	check 'null' "$(jnum abc; printf '%s' "$JN")" "jnum：非数字 -> null"
	check '12.5' "$(jnum 12.5; printf '%s' "$JN")" "jnum：数字原样"
	check 'true' "$(jbool 1; printf '%s' "$JB")" "jbool：1 -> true"
	check 'false' "$(jbool ''; printf '%s' "$JB")" "jbool：空 -> false"

	echo ""
	echo "批量添加自检（1.2.0：一次拉取匹配 / 段名递增不冲突 / 去重与汇总）："
	check "room3" "$(room_seg_bump room2)" "段名递增：room2 -> room3"
	check "room10" "$(room_seg_bump room9)" "段名递增：room9 -> room10"
	check "room9" "$(room_seg_bump room08)" "段名递增：带前导零也不会被当成八进制（room08 -> room9）"
	check "dorm2" "$(room_seg_bump dorm)" "段名没有数字：追加 2（dorm -> dorm2）"
	check "room3" "$(room_seg_pick '' 1 'room1 room2')" "默认段名：跳过已占用（room1/room2 已用 -> room3）"
	check "room2" "$(room_seg_pick '' 2 'room1 room3')" "默认段名：优先补中间的空位"
	check "room2" "$(room_seg_pick room2 1 '')" "--id：第一个目标用指定的段名"
	check "room3" "$(room_seg_pick room2 2 '')" "--id：后续目标在指定段名上递增"
	check "room4" "$(room_seg_pick room2 2 'room3')" "--id：递增时跳过已占用的段名（不覆盖已有段）"
	check "dorm2" "$(room_seg_pick dorm 2 '')" "--id：无数字前缀递增（dorm -> dorm2）"
	_taken100=""
	_i=1
	while [ "$_i" -le 100 ]; do
		_taken100="$_taken100 room$_i"
		_i=$((_i + 1))
	done
	check "" "$(room_seg_pick '' 1 "$_taken100")" "room1..room100 全被占用 -> 没有可用段名"
	# 去重判定：已经在监控里的编号 -> 跳过（不新建段）
	check 1 "$(room_num_taken 1001 ' 1001 2002')" "去重：编号在已监控列表里 -> 命中（跳过）"
	check "" "$(room_num_taken 3003 ' 1001 2002')" "去重：编号不在列表里 -> 空（照常添加）"
	check "" "$(room_num_taken 100 ' 1001 2002')" "去重：子串不算命中（100 不是 1001）"
	check "" "$(room_num_taken '' ' 1001')" "去重：空目标不算命中"
	# 部分失败汇总：计数与退出码
	check "汇总：成功 2 个，跳过 1 个，失败 1 个（共 4 个）" "$(room_add_summary 2 1 1)" \
		"批量汇总：逐房间计数（成功/跳过/失败/总数）"
	check 0 "$(room_add_summary 3 2 0 >/dev/null; echo $?)" "批量退出码：全成功（含跳过）-> 0"
	check 1 "$(room_add_summary 2 0 1 >/dev/null; echo $?)" "批量退出码：有失败 -> 非 0"
	check "汇总：成功 0 个，跳过 0 个，失败 0 个（共 0 个）" "$(room_add_summary 0 0 0)" \
		"批量汇总：空批次也给汇总行"
	# 匹配：先编号、再房间名（同一份响应里可以匹配任意多个目标）
	_tmp=$(mktemp /tmp/powerfee.st.XXXXXX)
	printf '%s\n%s\n%s\n' \
		'{"roomNum": "1001", "room": "A101", "building": "1号楼", "schoolArea": "东区", "powerBalance": "71.01"}' \
		'{"roomNum": "2002", "room": "B202", "building": "2号楼", "schoolArea": "西区", "powerBalance": "45.00"}' \
		'{"roomNum": "777", "room": "1001", "building": "3号楼", "schoolArea": "东区", "powerBalance": "10.00"}' >"$_tmp"
	_save_fi="$API_FIELD_ID"
	_save_fn="$API_FIELD_NAME"
	API_FIELD_ID="roomNum"
	API_FIELD_NAME="room"
	check "2002" "$(room_field_of "$(rooms_match_line "$_tmp" 2002)" id)" "批量匹配：按编号命中"
	check "2002" "$(room_field_of "$(rooms_match_line "$_tmp" B202)" id)" "批量匹配：编号没命中时按房间名命中"
	check "1001" "$(room_field_of "$(rooms_match_line "$_tmp" 1001)" id)" \
		"批量匹配：编号优先（有房间名也叫 1001 时不会误选）"
	check "" "$(rooms_match_line "$_tmp" 9999)" "批量匹配：接口里没有的目标 -> 空（按失败上报）"
	API_FIELD_ID="$_save_fi"
	API_FIELD_NAME="$_save_fn"
	rm -f "$_tmp"
	# 结构断言：批量实现里只能有一次 fetch_rooms —— 一次拉取匹配全部目标
	# （响应可能有近 1 MB，绝不能改成每个房间拉一次；这行断言就是钉住这一点的）
	if [ -r "$0" ]; then
		check 1 "$(sed -n '/^cmd_room_add_many()/,/^}/p' "$0" | grep -c 'fetch_rooms')" \
			"批量添加只调用一次 fetch_rooms（不会每个房间拉一次接口）"
	fi

	echo ""
	if [ "$_fail" = "0" ]; then
		echo "全部通过（$_pass 项）"
		return 0
	fi
	echo "$_fail 项失败 / 共 $((_pass + _fail)) 项"
	return 1
}

usage() {
	cat <<EOF
宿舍电量哨兵 · OpenWrt 版 v$VERSION

用法：powerfee <命令>

  check              查一次余额，必要时发邮件（服务默认每 30 分钟自动执行）
  check --force      无视冷却、档位与查询时段，强制发一封当前状态邮件（验证邮件通道用）
  status             显示当前余额、状态、日均用量与上次提醒（多房间时逐个列出）
  rooms [关键词]      列出学校接口返回的全部房间（可带关键词过滤）
  find <关键词>       按房间号 / 楼栋名搜索
  set-room <房间号>   设置要监控的房间，如 set-room A101（单房间模式）
  room-list           列出已配置的监控房间（余额 / 收件人 / 推送通道）
  room-add <房间号>   添加一个监控房间（每个房间可用 --mail-to / --notify-url 单独设置收件人与通道）
  room-add <编号1> <编号2> …   批量添加多个房间（只请求接口一次；已在监控的按编号跳过，逐房间报告结果）
  room-remove <段名>  删除一个监控房间（连同它的状态与历史）
	room-set <段名> <键> <值>   修改房间字段：num/label/threshold/mail_to/mail_account/notify_account/notify_url/notify_token/notify_enabled/enabled
	mail-account <子命令>  命名发件账号：list / add <名> / set <名> <键> <值> / remove <名> / test <名> [房间]
	                       （每个房间可用不同发件邮箱；房间字段 mail_account 指定用哪个）
	push-account <子命令>  命名推送账号：list / add <名> [--channel 通道] / set / remove / test
	                       （每个房间可用不同推送通道；房间字段 notify_account 指定用哪个）
	test-mail [房间]    发送一封测试邮件
	notify-test [房间]  发一条测试通知（webhook 推送通道）
  push <子命令>       推送通道管理器：Server酱 / 企业微信群机器人 / ClawBot / 自定义
                     （LuCI「微信推送」页顶部的通道选择器用的就是它，见下）
  wechat <子命令>     微信（ClawBot）推送助手：status / qr / enable / test
                     （LuCI「微信推送」页 ClawBot 通道的五步向导用它）
  history [条数]      查看历史采样与日均估算（多房间：history <段名|编号> [条数]）
  usage [房间] [选项]  每日用电量曲线与摘要（--days N / --month YYYY-MM /
                     --date YYYY-MM-DD / --png <路径>；数据优先取逐日接口，
                     取不到自动用本地采样估算，见下）
  report [房间] [--days N]
                     发一份「今日用量 + 最近 N 天曲线」的报告（邮件带内联曲线，
                     推送可带 {chart} 文本曲线；不加房间 = 每个房间各发一份）
  log [行数]          查看运行日志
  json <子命令>       机器可读输出（供 LuCI 界面 / 查询端点调用，见下）
  selftest           运行判定逻辑自检
  daemon             前台常驻运行（由 /etc/init.d/powerfee 调用）

json 子命令：
  json status              当前状态（余额/档位/日均/上次提醒/服务与邮件状态/查询时段/rooms 数组）
  json brief               单行摘要（同 webhook 的 {text}，适合机器人转发）
  json groups              校区 → 楼栋 两级清单（界面级联下拉用）
  json rooms [词] [条数]    房间列表（默认最多 500 条）
  json room-list           已配置房间的列表（含余额/档位/收件人/推送通道，密钥只回掩码）
  json room-add <房间号> [--id 段名] [--mail-to 邮箱] [--notify-url 地址] …
                           多个编号（或加 --batch）= 批量添加：results[] 给逐房间结果与计数
  json room-remove <段名|编号>
  json room-set <段名|编号> <键> <值>
  json room-save <段名|编号> <键=值> [<键=值> …]（批量写，只 commit 一次）
  json mail-accounts       命名发件账号列表（密钥只回掩码 / 是否已设置）
  json push-accounts       命名推送账号列表（同上）
  json history [条数]      最近采样点与日均估算
  json usage [房间] [--days N] [--month YYYY-MM] [--date YYYY-MM-DD] [--png [路径]]
                          每日用电量：text 文本曲线 + days 逐日数组 + summary
                          （--png 才回 png_base64；微信桥接用的就是它。--png 后面
                            再跟一个路径（/ 开头或 .png 结尾）会额外把图写到那个文件）
  json log [行数]          最近运行日志
  json check               立即查一次，返回结果（查询时段外会跳过，返回 skipped=true）
  json test-mail [房间]    发测试邮件
  json notify-test [房间]  发测试通知
  json set-room <房间号>    设置房间（单房间模式）
  json selftest            跑自检

微信推送（ClawBot，与上面的 json 子命令分开）：
  wechat status            服务/绑定/激活/推送配置状态（JSON）
  wechat qr [--json]       服务日志里的登录二维码（PNG 或 base64 JSON）
  wechat enable            一键写推送配置 + commit + 发测试消息
  wechat test              发一条测试消息

推送通道（Server酱 / 企业微信 / ClawBot / 自定义 webhook，与 wechat 分开）：
  push status              当前通道、开关、最近一次推送结果（JSON，密钥只回掩码）
  push set-serverchan <SendKey>   Server酱：写配置 + commit + 发测试
  push set-wecom <url>           企业微信群机器人：同上
  push set-webhook <url> [method] [content_type] [body]   自定义：同上
  push set-clawbot               切回 ClawBot（读 auth.json 写 url/token）
  push off                       关掉推送（enabled=0，配置保留）
  push test                      只发一条测试消息，不改配置

配置：uci show powerfee 或直接编辑 /etc/config/powerfee
定时报告：uci set powerfee.main.report_time='21:00'（留空 = 不发；到点给每个房间
          发一份「今日用量 + 最近 N 天曲线」的报告，N 用 main.report_days，默认 7）
EOF
}

# ============================================================================
# 入口
# ============================================================================

main() {
	local _cmd="$1"
	[ $# -gt 0 ] && shift
	case "$_cmd" in
	check)
		load_config
		if [ "$1" = "--force" ]; then cmd_check 1; else cmd_check 0; fi
		;;
	status) load_config; cmd_status ;;
	rooms) load_config; cmd_rooms "$1" ;;
	find) load_config; cmd_rooms "$1" ;;
	set-room) load_config; cmd_set_room "$1" ;;
	room-list) load_config; cmd_room_list ;;
	room-add) load_config; cmd_room_add "$@" ;;
	room-remove) load_config; cmd_room_remove "$1" ;;
	room-set) load_config; cmd_room_set "$@" ;;
	mail-account) load_config; cmd_mail_account "$@" ;;
	push-account) load_config; cmd_push_account "$@" ;;
	test-mail) load_config; cmd_test_mail "$1" ;;
	notify-test) load_config; cmd_notify_test "$1" ;;
	wechat) cmd_wechat "$@" ;;
	push) cmd_push "$@" ;;
	history) load_config; cmd_history "$1" "$2" ;;
	usage) load_config; cmd_usage "$@" ;;
	report) load_config; cmd_report "$@" ;;
	log) load_config; cmd_log "$1" ;;
	json) load_config; cmd_json "$@" ;;
	selftest) selftest ;;
	daemon) cmd_daemon ;;
	"" | -h | --help | help) usage ;;
	*)
		echo "未知命令：$_cmd" >&2
		usage >&2
		exit 1
		;;
	esac
}

main "$@"
