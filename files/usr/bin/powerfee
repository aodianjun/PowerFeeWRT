#!/bin/sh
# ============================================================================
# 宿舍电量哨兵 · OpenWrt 版（powerfee）
#
# 查询宿舍电费余额，余额低于阈值时发送邮件提醒（并可推送到 HTTP webhook，
# 例如微信 / QQ 机器人）；另提供一个只读 HTTP 查询端点（CGI，见 files/www/cgi-bin）。
# 接口地址与返回字段全部靠 UCI 配置适配（见 README「适配你的学校」），不绑定任何学校。
# 常驻路由器 7×24 运行 —— 这是它相对 Windows 托盘版 / 安卓版的最大优势：
# 电脑关机、手机休眠时它依然在盯着电表。
#
# 与上游 Windows 托盘版（C#）/ Android 版（Kotlin）保持同构的约定：
#   * 状态分档 OK / WARN / LOW / UNKNOWN，判定公式完全相同
#   * 告警去重规则相同：等级变差立即提醒、持续低电量按冷却时间重复提醒、
#     充值恢复后提醒一次
#   * 日均用量与可用天数同样用最近 72 小时采样估算
#   改动其中一处时，另外两个客户端也应同步核对。
#
# 依赖：busybox(ash/awk/sed)、curl、jsonfilter（OpenWrt 自带）；
#       发邮件需要 python3(smtplib) 或 msmtp 之一。
#
# 1.1.0 新增（两处都不改变老配置的行为）：
#   * 查询时段 main.active_hours：只在指定时段内查接口（减少夜间请求）；
#     窗口外不查也不误报「监控失效」（窗口外时长不计入失效判定），
#     powerfee check --force 可无视时段强制查一次。
#   * 多房间：UCI 里可以写多个 config room 段，每个房间有自己的编号、阈值、
#     收件邮箱与推送通道；接口仍只请求一次，结果按房间分发。没有 config room 段时
#     完全按老的单房间模式跑（状态/历史路径都不变）。
#
# 1.2.0 新增：多个发件邮箱账号 / 多个推送账号（同样不改变老配置的行为）
#   * config mail_account '名'：命名发件账号（只描述发件方，不含收件人）；
#     字段留空 = 继承 mail 段的同名字段。
#   * config push_account '名'：命名推送账号（通道 / 地址 / 令牌 / 请求体…）；
#     字段留空 = 继承 notify 段；channel=clawbot 且 url 为空时用本机 ClawBot API。
#   * config room 的 mail_account / notify_account 决定该房间用哪个账号；
#     收件人仍是房间的 mail_to。引用了不存在的账号名会写日志并在 status/json
#     里标出来，同时回退到默认段继续工作（提醒不会静默消失）。
#     取值优先级见「命名账号」一节的注释（与 LuCI / 文档同一份契约）。
#
# 1.2.0 新增（同版本发布）：每日用电量统计 + 曲线
#   * powerfee usage / report / json usage：逐日用量（图/摘要/报告/给机器人）。
#   * 数据来源二选一：api.daily_* 配好的逐日接口（优先），否则退回本地采样估算
#     （history.<房间>.csv，按「午夜前最后一点 / 午夜后第一点」归日，充值跳变剔除）。
#   * 历史月缓存到 <state_dir>/usage.<房间id>.<YYYY-MM>.json（当月每次重取）。
#   * main.report_time 到点发一份「今日用量 + 最近 N 天曲线」的报告（默认关）。
#     报告是独立事件：不改告警档位、不动冷却去重。
#   * 邮件里带上曲线（HTML 图 + PNG 内联，见 mail_build 的 multipart/related）。
#
# 编码注意：ash 的函数没有自己的作用域，所有内部变量一律 local 声明。
# 曾因 mail_alert 里的 _reason="$1" 覆盖了调用方的 _reason，导致恢复邮件
# 重复发送 —— 新增函数时请照此办理。
# ============================================================================

VERSION="1.2.4"

# ---- 路径 ------------------------------------------------------------------
CONF_DIR="/etc/powerfee"
STATE_FILE="$CONF_DIR/state"
HISTORY_FILE="$CONF_DIR/history.csv"
WINDOW_STATE_FILE="$CONF_DIR/window.state"   # 查询时段暂停记账（与房间无关）
REPORT_STATE_FILE="$CONF_DIR/report.state"   # 定时报告的「今天发过没」（与房间无关）
UCI_FILE="/etc/config/powerfee"
API_TMP="/tmp/powerfee.json"
ERR_TMP="/tmp/powerfee.err"
MAIL_PY="/usr/lib/powerfee/mail.py"
WECHAT_PY="/usr/lib/powerfee/wechat.py"
PUSH_PY="/usr/lib/powerfee/push.py"
USAGE_PY="${PF_USAGE_PY:-/usr/lib/powerfee/usage.py}"   # 逐日用量助手（解析/补齐/估算/绘图）
CHART_PY="${PF_CHART_PY:-/usr/lib/powerfee/chart.py}"   # 绘图模块（usage.py 用）
# 上面两个可用环境变量覆盖：隔离测试时把助手放 /tmp，生产路径一个都不碰
# （与 PF_CLAWBOT_AUTH 同一个套路：生产环境不用设置这些变量）。

# ---- 默认值（UCI 里没写时用这些）-------------------------------------------
D_ENABLED=1
D_INTERVAL=1800          # 查询间隔（秒），默认 30 分钟
D_RETRY_INTERVAL=300     # 查询失败后的重试间隔（秒）
D_THRESHOLD=20           # 低于该值（度）告警
D_WARN_RATIO=2           # 低于 阈值×该倍数 进入预警区
D_COOLDOWN=180           # 同一档位的重复提醒间隔（分钟）
D_NOTIFY_WARN=1          # 进入预警区是否也发邮件
D_NOTIFY_RECOVERY=1      # 充值恢复后是否发一次邮件
D_NOTIFY_ERROR=1         # 监控失效（长时间取不到数据）是否发邮件
D_STALE_HOURS=6          # 超过这么多小时没取到数据算监控失效
D_LOG_FILE="$CONF_DIR/powerfee.log"
D_LOG_MAX_KB=128
D_ACTIVE_HOURS=""        # 查询时段（留空 = 全天查询）；如 "07:00-23:00"、"22:00-06:00"
D_STATE_DIR="$CONF_DIR"  # 状态与历史目录（一般不用改；测试/多实例时可指到别处）
D_REPORT_TIME=""         # 每天几点发「今日用量 + 曲线」报告（留空 = 不发）；如 "21:00"
D_REPORT_DAYS=7          # 报告/告警邮件里的曲线天数

# ---- 查询接口（通用：任何学校的电费接口都靠这段配置适配）-------------------
# 默认全空：不指向任何学校，装好后由用户填自己学校的接口。
D_API_URL=""             # 完整接口地址（含查询参数）
D_API_METHOD="POST"      # POST | GET
D_API_CONTENT_TYPE="application/x-www-form-urlencoded"
D_API_BODY=""            # POST 的请求体，如 PARAM=XXXX
D_API_TIMEOUT=40
D_API_DNS_SERVERS="223.5.5.5 119.29.29.29"   # 本机 DNS 解不出接口域名时的备用 DNS
D_API_ROOMS_PATH="@.obj[*]"                   # jsonfilter 表达式：房间数组（每个元素一行）
D_API_OK_PATH=""                              # 成功标志的 jsonfilter 表达式；留空=不检查
D_API_OK_VALUE="true"
D_API_MSG_PATH=""                             # 错误信息的 jsonfilter 表达式
D_API_FIELD_ID="roomNum"                      # 房间唯一编号字段
D_API_FIELD_NAME="room"                       # 房间名字段（用户搜索/看到的名字）
D_API_FIELD_BUILDING="building"
D_API_FIELD_CAMPUS="schoolArea"
D_API_FIELD_BALANCE="powerBalance"
D_API_UNIT="度"
D_API_UNIT_FIELD="du"                         # 余额单位的字段名（接口返回优先，拿不到用 api.unit）

# ---- 逐日用量接口（1.2.0；留空 = 不启用，自动退回本地采样估算）--------------
# 与 api.* 同风格：怎么请求 + 怎么在返回里找字段，全部靠这段配置适配。
# 模板占位符：{room} 房间号 {month} YYYY-MM {page} 页码 {page_size} 每页天数
D_DAILY_URL=""           # 例：https://你的学校/user/powerfee/getDailyDetails
D_DAILY_BODY='roomNum={room}&lastDate={month}&type=2&pageNum={page}&pageSize={page_size}'
D_DAILY_METHOD="POST"    # POST | GET
D_DAILY_CONTENT_TYPE="application/x-www-form-urlencoded"
D_DAILY_TIMEOUT=30
D_DAILY_PAGE_SIZE=31     # {page_size} 的取值；一个月最多 31 天，一页就够
D_DAILY_PATH="@.obj.dailyDetailsInfos[*]"    # 逐日明细数组（每个元素一行）
D_DAILY_OK_PATH="@.ret"                      # 成功标志；留空=不检查
D_DAILY_OK_VALUE="true"
D_DAILY_MSG_PATH="@.msg"
D_DAILY_DATE_FIELD="dateTime"                # 日期字段（YYYY-MM-DD）
D_DAILY_USED_FIELD="dailyUsed"               # 当日用电量（字符串，度）
D_DAILY_TOTAL_FIELD="totalUsed"              # 终身累计（单调递增；跨月补齐要用）
D_DAILY_UNIT_FIELD="dailyUsedUnit"           # 单位字段（拿不到就用 api.unit）

D_MAIL_ENABLED=0
D_MAIL_TRANSPORT="auto"  # auto | python3 | msmtp
D_MAIL_HOST="smtp.qq.com"
D_MAIL_PORT=465
D_MAIL_SECURITY="ssl"    # ssl | starttls | none
D_MAIL_USER=""
D_MAIL_PASSWORD=""
D_MAIL_FROM=""
D_MAIL_FROM_NAME="宿舍电量哨兵"
D_MAIL_TO=""
D_MAIL_TLS_VERIFY=1

# ---- 通知推送（webhook，可推到微信/QQ 机器人等）-----------------------------
D_NOTIFY_ENABLED=0
D_NOTIFY_URL=""                                   # 要推送到的 HTTP 地址
D_NOTIFY_METHOD="POST"                            # POST | GET
D_NOTIFY_CONTENT_TYPE="application/json"
D_NOTIFY_BODY='{"text":"{text}"}'                 # 请求体模板，占位符见 notify_text/notify_render
D_NOTIFY_TOKEN=""                                 # 可选：鉴权令牌
D_NOTIFY_TOKEN_HEADER="Authorization"             # token 放哪个请求头
D_NOTIFY_TIMEOUT=15
D_NOTIFY_HTTP_ENABLED=0                           # 是否开启查询端点（CGI）
D_NOTIFY_HTTP_TOKEN=""                            # 查询端点要求的 token（留空=端点关闭）

# ---- 命名账号（1.2.0）--------------------------------------------------------
# mail_account / push_account 段只描述「发件方」/「推送通道」，本身没有全局默认值：
# 字段留空一律继承 mail / notify 段的同名字段（解析见 mail_env_apply / notify_env_apply）。
D_MAIL_ACCT_ENABLED=1     # mail_account.enabled 缺省值
D_PUSH_ACCT_ENABLED=1     # push_account.enabled 缺省值
D_CLAWBOT_PORT=26322      # ClawBot 本机 API 的默认端口（channel=clawbot 且 url 为空时用）

# ============================================================================
# 基础工具
# ============================================================================

log() {
	# 写 syslog（logread -e powerfee 可见），并按配置追加到文件
	local _msg="$1" _dir _sz
	logger -t powerfee "$_msg" 2>/dev/null
	[ -n "$LOG_FILE" ] || return 0
	_dir=$(dirname "$LOG_FILE")
	[ -d "$_dir" ] || mkdir -p "$_dir"
	if [ "$LOG_MAX_KB" -gt 0 ] && [ -f "$LOG_FILE" ]; then
		_sz=$(wc -c <"$LOG_FILE" 2>/dev/null | tr -d ' ')
		[ -n "$_sz" ] && [ "$_sz" -gt $((LOG_MAX_KB * 1024)) ] && mv -f "$LOG_FILE" "$LOG_FILE.old"
	fi
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$_msg" >>"$LOG_FILE"
}

die() {
	log "错误：$1"
	echo "powerfee: $1" >&2
	exit 1
}

now_epoch() { date +%s; }

dev_name() {
	# busybox 不一定带 hostname，逐级兜底
	local _n
	_n=$(pf_uci -q get system.@system[0].hostname 2>/dev/null)
	[ -n "$_n" ] || _n=$(uname -n 2>/dev/null)
	[ -n "$_n" ] || _n=$(cat /proc/sys/kernel/hostname 2>/dev/null)
	[ -n "$_n" ] || _n="路由器"
	echo "$_n"
}

fmt_time() {
	if [ -z "$1" ] || [ "$1" = "0" ]; then
		echo "—"
	else
		date -d "@$1" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "—"
	fi
}

# awk 公共前奏：jget 从一行 JSON 里按字段名取值（对字段顺序不敏感），jesc 转义成 JSON 字符串。
# busybox awk 可用；各处的 awk 调用都以 "$AWK_JGET" 开头复用这段。
AWK_JGET='function jget(line, key,   pat, i, s, n) {
	pat = "\"" key "\": \""
	i = index(line, pat)
	if (i == 0) return ""
	s = substr(line, i + length(pat))
	n = index(s, "\"")
	if (n == 0) return ""
	return substr(s, 1, n - 1)
}
function jesc(s,   i, c, out) {
	# 逐字符转义。注意：不能用 gsub 的替换串做转义 —— busybox awk 会吃掉
	# 替换串里孤立的反斜杠（gsub(/"/, "\\\"") 的结果是裸引号，不是 \"），
	# 真机实测该写法等于没转义；逐字符拼接用的是字符串字面量规则，行为可靠。
	out = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (c == "\\") out = out "\\\\"
		else if (c == "\"") out = out "\\\""
		else if (c == "\t") out = out "\\t"
		else out = out c
	}
	return out
}
'

# ============================================================================
# 配置读取（这里的变量是全局的，故意不用 local）
# ============================================================================

# 制表符（room_fields_line 的分隔符）。$'...' 是 bash 语法，busybox ash 不认，用 printf。
TAB=$(printf '\t')
# cmd_check 因为「不在查询时段」而跳过时置 1（json check / LuCI 用来区分「没查」与「查了」）
CHECK_SKIPPED=""

# 所有直接调用 uci 的地方一律走这个包装，别直接写 uci。
# 为什么：config_load（/lib/functions.sh）认 UCI_CONFIG_DIR，而裸 uci 命令不认 ——
# 只设环境变量会让「读」被隔离、「写」仍然落到 /etc/config/powerfee。测试或多实例时
# 这会把生产配置改掉（本项目的测试事故就是这么来的）。包一层后读写同源。
# 用显式 if 而不是 ${VAR:+-c "$VAR"}：后者在 ash 里的分词行为不直观（实测会漏掉 -c）。
#
# 测试/多实例注意：uci 的「暂存区」是全局的 /tmp/.uci（`uci set` 先写那里，`commit` 才
# 落盘），`-c` 只改配置目录、改不了暂存区。所以隔离跑测试时要自己保证不留下未提交的
# 暂存文件，否则之后任何一次 commit（包括生产侧的）都会把测试改动冲进 /etc/config。
# 测试脚本的兜底做法：跑之前和跑之后各 `rm -f /tmp/.uci/powerfee`。
pf_uci() {
	if [ -n "$UCI_CONFIG_DIR" ]; then
		uci -c "$UCI_CONFIG_DIR" "$@"
	else
		uci "$@"
	fi
}

load_config() {
	[ -f /lib/functions.sh ] && . /lib/functions.sh
	[ -f "$UCI_FILE" ] && config_load powerfee 2>/dev/null

	config_get MAIN_ENABLED main enabled "$D_ENABLED"
	config_get ROOM_NUM main room_num ""
	config_get CAMPUS main campus ""
	config_get BUILDING main building ""
	config_get ROOM main room ""
	config_get INTERVAL main interval "$D_INTERVAL"
	config_get RETRY_INTERVAL main retry_interval "$D_RETRY_INTERVAL"
	config_get THRESHOLD main threshold "$D_THRESHOLD"
	config_get WARN_RATIO main warn_ratio "$D_WARN_RATIO"
	config_get COOLDOWN main cooldown "$D_COOLDOWN"
	config_get NOTIFY_WARN main notify_warn "$D_NOTIFY_WARN"
	config_get NOTIFY_RECOVERY main notify_recovery "$D_NOTIFY_RECOVERY"
	config_get NOTIFY_ERROR main notify_error "$D_NOTIFY_ERROR"
	config_get STALE_HOURS main stale_hours "$D_STALE_HOURS"
	config_get LOG_FILE main log_file "$D_LOG_FILE"
	config_get LOG_MAX_KB main log_max_kb "$D_LOG_MAX_KB"
	config_get ACTIVE_HOURS main active_hours "$D_ACTIVE_HOURS"
	config_get REPORT_TIME main report_time "$D_REPORT_TIME"
	config_get REPORT_DAYS main report_days "$D_REPORT_DAYS"
	case "$REPORT_DAYS" in '' | *[!0-9]*) REPORT_DAYS="$D_REPORT_DAYS" ;; esac
	[ "$REPORT_DAYS" -gt 0 ] 2>/dev/null || REPORT_DAYS="$D_REPORT_DAYS"

	# 状态目录（默认 /etc/powerfee；一般不用改，测试或多实例时可以指到别处）
	config_get CFG_STATE_DIR main state_dir "$D_STATE_DIR"
	if [ -n "$CFG_STATE_DIR" ] && [ "$CFG_STATE_DIR" != "$CONF_DIR" ]; then
		CONF_DIR="$CFG_STATE_DIR"
		STATE_FILE="$CONF_DIR/state"
		HISTORY_FILE="$CONF_DIR/history.csv"
		WINDOW_STATE_FILE="$CONF_DIR/window.state"
		REPORT_STATE_FILE="$CONF_DIR/report.state"
	fi

	# ---- 查询接口映射 ----
	config_get API_URL api url "$D_API_URL"
	config_get API_METHOD api method "$D_API_METHOD"
	config_get API_CONTENT_TYPE api content_type "$D_API_CONTENT_TYPE"
	config_get API_BODY api body "$D_API_BODY"
	config_get API_TIMEOUT api timeout "$D_API_TIMEOUT"
	config_get API_DNS_SERVERS api dns_servers "$D_API_DNS_SERVERS"
	config_get API_ROOMS_PATH api rooms_path "$D_API_ROOMS_PATH"
	config_get API_OK_PATH api ok_path "$D_API_OK_PATH"
	config_get API_OK_VALUE api ok_value "$D_API_OK_VALUE"
	config_get API_MSG_PATH api msg_path "$D_API_MSG_PATH"
	config_get API_FIELD_ID api field_id "$D_API_FIELD_ID"
	config_get API_FIELD_NAME api field_name "$D_API_FIELD_NAME"
	config_get API_FIELD_BUILDING api field_building "$D_API_FIELD_BUILDING"
	config_get API_FIELD_CAMPUS api field_campus "$D_API_FIELD_CAMPUS"
	config_get API_FIELD_BALANCE api field_balance "$D_API_FIELD_BALANCE"
	config_get API_UNIT api unit "$D_API_UNIT"
	config_get API_UNIT_FIELD api unit_field "$D_API_UNIT_FIELD"

	# ---- 逐日用量接口映射 ----
	config_get DAILY_URL api daily_url "$D_DAILY_URL"
	config_get DAILY_BODY api daily_body "$D_DAILY_BODY"
	config_get DAILY_METHOD api daily_method "$D_DAILY_METHOD"
	config_get DAILY_CONTENT_TYPE api daily_content_type "$D_DAILY_CONTENT_TYPE"
	config_get DAILY_TIMEOUT api daily_timeout "$D_DAILY_TIMEOUT"
	config_get DAILY_PAGE_SIZE api daily_page_size "$D_DAILY_PAGE_SIZE"
	config_get DAILY_PATH api daily_path "$D_DAILY_PATH"
	config_get DAILY_OK_PATH api daily_ok_path "$D_DAILY_OK_PATH"
	config_get DAILY_OK_VALUE api daily_ok_value "$D_DAILY_OK_VALUE"
	config_get DAILY_MSG_PATH api daily_msg_path "$D_DAILY_MSG_PATH"
	config_get DAILY_DATE_FIELD api daily_date_field "$D_DAILY_DATE_FIELD"
	config_get DAILY_USED_FIELD api daily_used_field "$D_DAILY_USED_FIELD"
	config_get DAILY_TOTAL_FIELD api daily_total_field "$D_DAILY_TOTAL_FIELD"
	config_get DAILY_UNIT_FIELD api daily_unit_field "$D_DAILY_UNIT_FIELD"
	case "$DAILY_PAGE_SIZE" in '' | *[!0-9]*) DAILY_PAGE_SIZE="$D_DAILY_PAGE_SIZE" ;; esac

	# 兼容旧配置：老版本把接口写在 main.api_host / main.api_path 里
	if [ -z "$API_URL" ]; then
		config_get _old_host main api_host ""
		config_get _old_path main api_path ""
		[ -n "$_old_host" ] && API_URL="https://$_old_host$_old_path"
		config_get API_DNS_SERVERS main dns_servers "$API_DNS_SERVERS"
		config_get API_TIMEOUT main timeout "$API_TIMEOUT"
	fi
	API_HOST=$(echo "$API_URL" | sed -e 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##' -e 's#/.*$##' -e 's#:.*$##')

	config_get MAIL_ENABLED mail enabled "$D_MAIL_ENABLED"
	config_get MAIL_TRANSPORT mail transport "$D_MAIL_TRANSPORT"
	config_get MAIL_HOST mail host "$D_MAIL_HOST"
	config_get MAIL_PORT mail port "$D_MAIL_PORT"
	config_get MAIL_SECURITY mail security "$D_MAIL_SECURITY"
	config_get MAIL_USER mail user "$D_MAIL_USER"
	config_get MAIL_PASSWORD mail password "$D_MAIL_PASSWORD"
	config_get MAIL_FROM mail from "$D_MAIL_FROM"
	config_get MAIL_FROM_NAME mail from_name "$D_MAIL_FROM_NAME"
	config_get MAIL_TO mail to "$D_MAIL_TO"
	config_get MAIL_TLS_VERIFY mail tls_verify "$D_MAIL_TLS_VERIFY"

	config_get NOTIFY_ENABLED notify enabled "$D_NOTIFY_ENABLED"
	config_get NOTIFY_URL notify url "$D_NOTIFY_URL"
	config_get NOTIFY_METHOD notify method "$D_NOTIFY_METHOD"
	config_get NOTIFY_CONTENT_TYPE notify content_type "$D_NOTIFY_CONTENT_TYPE"
	config_get NOTIFY_BODY notify body "$D_NOTIFY_BODY"
	config_get NOTIFY_TOKEN notify token "$D_NOTIFY_TOKEN"
	config_get NOTIFY_TOKEN_HEADER notify token_header "$D_NOTIFY_TOKEN_HEADER"
	config_get NOTIFY_TIMEOUT notify timeout "$D_NOTIFY_TIMEOUT"
	config_get NOTIFY_HTTP_ENABLED notify http_enabled "$D_NOTIFY_HTTP_ENABLED"
	config_get NOTIFY_HTTP_TOKEN notify http_token "$D_NOTIFY_HTTP_TOKEN"

	# ---- 命名账号（1.2.0）----
	# mail / notify 段的原始值留一份「基底」：账号段里留空的字段从它继承
	# （所以下面这些 _BASE_ 变量在解析完成前不许被覆盖）。
	MAIL_BASE_TRANSPORT="$MAIL_TRANSPORT"
	MAIL_BASE_HOST="$MAIL_HOST"
	MAIL_BASE_PORT="$MAIL_PORT"
	MAIL_BASE_SECURITY="$MAIL_SECURITY"
	MAIL_BASE_USER="$MAIL_USER"
	MAIL_BASE_PASSWORD="$MAIL_PASSWORD"
	MAIL_BASE_FROM="$MAIL_FROM"
	MAIL_BASE_FROM_NAME="$MAIL_FROM_NAME"
	MAIL_BASE_TLS_VERIFY="$MAIL_TLS_VERIFY"
	NOTIFY_BASE_URL="$NOTIFY_URL"
	NOTIFY_BASE_METHOD="$NOTIFY_METHOD"
	NOTIFY_BASE_CONTENT_TYPE="$NOTIFY_CONTENT_TYPE"
	NOTIFY_BASE_BODY="$NOTIFY_BODY"
	NOTIFY_BASE_TOKEN="$NOTIFY_TOKEN"
	NOTIFY_BASE_TOKEN_HEADER="$NOTIFY_TOKEN_HEADER"
	NOTIFY_BASE_TIMEOUT="$NOTIFY_TIMEOUT"
	# 当前房间的账号解析结果与「账号问题」清单（status / json 用）
	MAIL_ACCOUNT_EFFECTIVE=""
	MAIL_ACCT_ISSUE=""
	NOTIFY_ACCOUNT_EFFECTIVE=""
	NOTIFY_ACCT_ISSUE=""
	NOTIFY_CHANNEL=""
	ACCT_ISSUES=""
	ACCT_ISSUE_MSGS=""
	ACCT_ISSUE_LOGGED=""
	MAIL_ACCT_IDS=""
	MAIL_ACCT_COUNT=0
	PUSH_ACCT_IDS=""
	PUSH_ACCT_COUNT=0

	ROOM_DISPLAY="$ROOM"
	[ -n "$BUILDING" ] && ROOM_DISPLAY="$BUILDING $ROOM"
	[ -z "$ROOM_DISPLAY" ] && ROOM_DISPLAY="宿舍"

	# ---- 房间集合 ----
	# MAIN_* 保存 main 段里的「默认房间」：多房间模式下 room_apply_env 会覆盖
	# 当前房间上下文（ROOM_NUM/THRESHOLD/MAIL_TO/NOTIFY_*/STATE_FILE…），
	# main.room_num 仍要留作兜底（没有 config room 段时的唯一来源）。
	MAIN_ROOM_NUM="$ROOM_NUM"
	MAIN_CAMPUS="$CAMPUS"
	MAIN_BUILDING="$BUILDING"
	MAIN_ROOM="$ROOM"
	MAIN_ROOM_DISPLAY="$ROOM_DISPLAY"
	MAIN_THRESHOLD="$THRESHOLD"
	MAIN_MAIL_TO="$MAIL_TO"
	MAIN_NOTIFY_URL="$NOTIFY_URL"
	MAIN_NOTIFY_TOKEN="$NOTIFY_TOKEN"
	MAIN_NOTIFY_ENABLED="$NOTIFY_ENABLED"

	rooms_scan
	accounts_scan
	acct_issues_scan
	rooms_select_default
}

# ============================================================================
# 状态读写（键值文件，权限 600，放在持久化的 /etc 下，重启不丢）
# ============================================================================

state_cache_load() {
	# 把当前 STATE_FILE 整个读进 STATE_CACHE（纯 shell，不起进程）。
	# 房间切换会改 STATE_FILE —— 缓存按文件路径失效，换房间会自动重读；
	# state_set 写完会显式作废缓存，所以「写完再读」拿到的也是新值。
	[ "$STATE_CACHE_FILE" = "$STATE_FILE" ] && return 0
	STATE_CACHE_FILE="$STATE_FILE"
	STATE_CACHE=""
	[ -f "$STATE_FILE" ] || return 0
	local _l
	while IFS= read -r _l || [ -n "$_l" ]; do
		STATE_CACHE="${STATE_CACHE}${_l}"$'\n'
	done <"$STATE_FILE"
	return 0
}

state_get() {
	# 状态文件里取一个键（没有则输出空）。取第一个匹配（与原 sed|head 一致）。
	# 纯 shell 逐行匹配：原来每个键要起 sed + head 两个进程，而 status / room-list
	# 一次要读几十个键 —— 那几百个进程就是这么来的。
	[ -f "$STATE_FILE" ] || return 0
	state_cache_load
	local _rest="$STATE_CACHE" _line
	while [ -n "$_rest" ]; do
		_line="${_rest%%$'\n'*}"
		case "$_line" in
		"$1"=*) printf '%s' "${_line#*=}"; return 0 ;;
		esac
		[ "$_rest" = "$_line" ] && break
		_rest="${_rest#*$'\n'}"
	done
	return 0
}

state_set() {
	# state_set key value [key value ...]：与已有状态合并后整体落盘
	local _kv _new
	[ -d "$CONF_DIR" ] || mkdir -p "$CONF_DIR"
	_kv="$STATE_FILE.kv.$$"
	: >"$_kv"
	while [ $# -ge 2 ]; do
		printf '%s=%s\n' "$1" "$2" >>"$_kv"
		shift 2
	done
	_new="$STATE_FILE.new.$$"
	if [ -f "$STATE_FILE" ]; then
		awk 'NR==FNR{k=$0; sub(/=.*/,"",k); seen[k]=1; next}
		     {k=$0; sub(/=.*/,"",k); if (!(k in seen)) print}' "$_kv" "$STATE_FILE" >"$_new"
	else
		: >"$_new"
	fi
	cat "$_kv" >>"$_new"
	chmod 600 "$_new" 2>/dev/null
	mv -f "$_new" "$STATE_FILE"
	rm -f "$_kv"
	STATE_CACHE_FILE="__stale__"   # 作废 state_get 的内存缓存（刚写进去的键要能立刻读到）
}

state_clear() { rm -f "$STATE_FILE" "$HISTORY_FILE"; }

# ============================================================================
# 查询时段（main.active_hours）
#
# 只在指定时段内请求接口，减少夜间请求。格式：HH:MM-HH:MM，多段用空格分隔；
# 起 > 止 表示跨越午夜（22:00-06:00）；起 == 止 表示全天；留空 = 全天查询
# （默认行为，与 1.0.x 完全一致）。时段边界是「含起点、不含终点」，
# 例如 07:00-23:00 表示 07:00 开始查、23:00 起停止查。
#
# 配置写错时按「全天」处理（宁可多查，不能让监控因为一个笔误静默失效），
# status / json 里会标出「格式无效」。
#
# 与「监控失效告警」的协调：窗口外不查，但窗口外的时长不算作监控失效
# （否则设了 07:00-23:00、stale_hours=6 的用户每天早上都会被误报一次）。
# 实现：进入窗口外时把暂停起点写进 window.state；回到窗口内时把这段时长
# 加到 last_ok_at 上（即失效判定基准顺延），再清掉暂停记录。
# ============================================================================

active_window_check() {
	# active_window_check <时段配置> <HH:MM>：输出 in / out / invalid
	# 纯函数（不读时钟、不读配置），自检里逐条验证边界/跨天/多段/非法输入。
	awk -v spec="$1" -v t="$2" '
	function tomin(s,   p, n) {
		n = split(s, p, ":")
		if (n != 2) return -1
		if (p[1] !~ /^[0-9][0-9]?$/ || p[2] !~ /^[0-9][0-9]$/) return -1
		if (p[1] + 0 > 23 || p[2] + 0 > 59) return -1
		return (p[1] + 0) * 60 + (p[2] + 0)
	}
	BEGIN {
		if (spec == "") { print "in"; exit }
		now = tomin(t)
		if (now < 0) { print "invalid"; exit }
		cnt = split(spec, segs, /[ \t]+/)
		ok = 0
		for (i = 1; i <= cnt; i++) {
			seg = segs[i]
			if (seg == "") continue
			m = split(seg, ab, "-")
			if (m != 2) { print "invalid"; exit }
			a = tomin(ab[1]); b = tomin(ab[2])
			if (a < 0 || b < 0) { print "invalid"; exit }
			if (a == b) { ok = 1; continue }
			if (a < b) { if (now >= a && now < b) ok = 1 }
			else { if (now >= a || now < b) ok = 1 }
		}
		print (ok ? "in" : "out")
	}'
}

in_active_window() {
	# in_active_window [HH:MM]：0 = 在查询时段内（active_hours 为空或无效时按全天）
	local _r
	_r=$(active_window_check "$ACTIVE_HOURS" "${1:-$(date +%H:%M)}")
	[ "$_r" != "out" ]
}

active_window_text() {
	# 人类可读的时段说明（status 用）
	local _r
	if [ -z "$ACTIVE_HOURS" ]; then
		echo "全天（active_hours 未设置）"
		return 0
	fi
	_r=$(active_window_check "$ACTIVE_HOURS" "$(date +%H:%M)")
	case "$_r" in
	invalid) echo "$ACTIVE_HOURS（格式无效，已按全天处理）" ;;
	in) echo "$ACTIVE_HOURS（现在在时段内）" ;;
	*) echo "$ACTIVE_HOURS（现在不在时段内，暂停查询）" ;;
	esac
}

active_hours_valid() {
	[ "$(active_window_check "$ACTIVE_HOURS" "12:00")" != "invalid" ]
}

# ---- 窗口外暂停记账（window.state，与房间无关的全局状态）---------------------

window_state_get() {
	local _sf="$STATE_FILE" _v
	STATE_FILE="$WINDOW_STATE_FILE"
	_v=$(state_get "$1")
	STATE_FILE="$_sf"
	printf '%s' "$_v"
}

window_state_set() {
	local _sf="$STATE_FILE"
	STATE_FILE="$WINDOW_STATE_FILE"
	state_set "$@"
	STATE_FILE="$_sf"
}

window_shift_last_ok() {
	# window_shift_last_ok <state 文件> <gap 秒> <now>：把该状态文件里的 last_ok_at 顺延 gap
	# （即「窗口外的时长不计入失效判定」）。真的顺延了返回 0，没动返回 1。
	local _f="$1" _gap="$2" _now="$3" _l _new _sf
	_sf="$STATE_FILE"
	STATE_FILE="$_f"
	_l=$(state_get last_ok_at)
	STATE_FILE="$_sf"
	[ -n "$_l" ] && [ "$_l" != "0" ] && [ "$_gap" -gt 0 ] || return 1
	_new=$((_l + _gap))
	# 窗口外可能有强制查询（check --force）刷新过 last_ok_at，别顺延到未来
	[ "$_new" -gt "$_now" ] && _new="$_now"
	[ "$_new" != "$_l" ] || return 1
	_sf="$STATE_FILE"
	STATE_FILE="$_f"
	state_set last_ok_at "$_new"
	STATE_FILE="$_sf"
	return 0
}

active_pause_mark() {
	# 进入窗口外：记下暂停起点（只记第一次）
	local _p
	_p=$(window_state_get pause_started_at)
	if [ -z "$_p" ] || [ "$_p" = "0" ]; then
		window_state_set pause_started_at "$(now_epoch)"
	fi
}

active_pause_resume() {
	# 回到窗口内：把窗口外的时长从失效判定基准里扣掉（每个房间的 last_ok_at 都顺延），
	# 再清掉暂停记录。没有暂停记录时是空操作。
	local _p _gap _now _id _n=0
	_p=$(window_state_get pause_started_at)
	[ -n "$_p" ] && [ "$_p" != "0" ] || return 0
	_now=$(now_epoch)
	_gap=$((_now - _p))
	[ "$_gap" -gt 0 ] || _gap=0
	if [ "$ROOM_COUNT" -gt 0 ]; then
		# 多房间：每个房间一份状态，都要顺延（否则除第一个房间外，早上第一次
		# 查询失败就会误报「监控失效」）
		for _id in $ROOM_IDS; do
			room_load "$_id" || continue
			window_shift_last_ok "$R_STATE_FILE" "$_gap" "$_now" && _n=$((_n + 1))
		done
		rooms_select_default
	else
		window_shift_last_ok "$STATE_FILE" "$_gap" "$_now" && _n=$((_n + 1))
	fi
	if [ "$_gap" -gt 0 ] && [ "$_n" -gt 0 ]; then
		log "回到查询时段：窗口外的 $_gap 秒不计入监控失效判定（已顺延 $_n 个房间的状态）"
	fi
	window_state_set pause_started_at ""
}

# ============================================================================
# 命名账号（1.2.0）：发件账号 mail_account / 推送账号 push_account
#
# 账号段只描述「发件方」（mail_account）与「推送通道」（push_account），
# 收件人仍由房间的 mail_to 决定。任何字段留空 = 继承 mail / notify 段的同名字段。
#
# 取值优先级（冻结契约，LuCI 与文档按同一份实现）：
#   邮件：发件方 = 房间 mail_account 指定的账号（未指定 → mail 段）；
#         收件人 = 房间 mail_to（空 → mail.to）；
#         mail.enabled=0 时整条邮件通道关闭（账号段不能绕过总开关）。
#   推送：基底 = 房间 notify_account 指定的账号（未指定 → notify 段）；
#         然后房间级 notify_url / notify_token 覆盖基底的同名字段；
#         notify_enabled（房间级，空则继承 notify.enabled）为 0 则该房间不推。
#   引用了不存在的账号名：写日志 + 在 status/json 里标出来（account_issues），
#   并回退到默认段继续工作 —— 不能让提醒因为一个写错的账号名就静默消失。
#
# 通道特例（与 python 助手 push.py 同一套规则）：
#   * channel=clawbot 且账号自己的 url 为空 → 用本机 ClawBot API
#     （http://127.0.0.1:<port>/bots/<bot_id>/messages，token 取 auth.json 里的 api_token）
#   * channel=serverchan 且最终地址仍为空、token 已填 → 按 SendKey 拼出推送地址
# ============================================================================

pf_sections_of() {
	# 列出某类型的所有命名段；匿名段（@xxx[n]）无法按名读配置，剔除并告警
	# （不剔除的话「配了却不生效」会让人完全摸不着头脑）
	local _type="$1" _ids _anon
	_ids=$(pf_uci -q show powerfee 2>/dev/null | sed -n "s/^powerfee\.\([^.]*\)=$_type\$/\1/p" | tr '\n' ' ')
	_anon=$(printf '%s\n' $_ids | sed -n '/^@/p' | tr '\n' ' ')
	if [ -n "${_anon# }" ]; then
		echo "警告：忽略了匿名 $_type 段（${_anon% }）—— 匿名段无法按名读取配置。" >&2
		echo "      请用 powerfee mail-account add <名> / push-account add <名> 建命名段。" >&2
		_ids=$(printf '%s\n' $_ids | sed '/^@/d' | tr '\n' ' ')
	fi
	printf '%s' "$_ids"
}

accounts_scan() {
	# 扫描命名账号段（load_config 调用）
	local _a
	MAIL_ACCT_IDS=$(pf_sections_of mail_account)
	MAIL_ACCT_COUNT=0
	for _a in $MAIL_ACCT_IDS; do MAIL_ACCT_COUNT=$((MAIL_ACCT_COUNT + 1)); done
	PUSH_ACCT_IDS=$(pf_sections_of push_account)
	PUSH_ACCT_COUNT=0
	for _a in $PUSH_ACCT_IDS; do PUSH_ACCT_COUNT=$((PUSH_ACCT_COUNT + 1)); done
	return 0
}

acct_name_valid() {
	# 账号名要能安全地拼进 uci 键路径（powerfee.<名>.<键>），只允许 [A-Za-z0-9_]
	case "$1" in
	'' | *[!A-Za-z0-9_]*) return 1 ;;
	esac
	return 0
}

acct_section_exists() {
	# acct_section_exists <mail_account|push_account> <段名>
	# 按段名清单判断（accounts_scan 填的），不额外 fork uci；
	# 调用点都在 load_config 之后（配置改了都会重新 load_config）。
	case "$1" in
	mail_account)
		case " $MAIL_ACCT_IDS " in
		*" $2 "*) return 0 ;;
		esac
		;;
	push_account)
		case " $PUSH_ACCT_IDS " in
		*" $2 "*) return 0 ;;
		esac
		;;
	esac
	return 1
}

acct_issues_scan() {
	# 把每个房间的账号解析先跑一遍，只为收集「账号问题」：
	# 这样引用了不存在的账号名在 load_config 阶段就进日志与问题清单
	# （status / json status 的 account_issues），不用等 room_apply_env。
	# 解析结果会被随后的 rooms_select_default 覆盖，所以这里不需要保存。
	local _id
	[ "$ROOM_COUNT" -gt 0 ] || return 0
	for _id in $ROOM_IDS; do
		room_load "$_id" || continue
		mail_env_apply "$R_MAIL_ACCOUNT"
		notify_env_apply "$R_NOTIFY_ACCOUNT" "$R_NOTIFY_URL" "$R_NOTIFY_TOKEN"
	done
	return 0
}

acct_pick3() {
	# 三级取值：房间级 > 账号级 > 默认段（空串 = 没写，逐级下沉）
	if [ -n "$1" ]; then printf '%s' "$1"
	elif [ -n "$2" ]; then printf '%s' "$2"
	else printf '%s' "$3"; fi
}

acct_keys() {
	# 各类型的可写键（白名单；也用作 set 的用法提示）
	case "$1" in
	mail_account) printf '%s' "enabled transport host port security user password from from_name tls_verify" ;;
	push_account) printf '%s' "enabled channel url method content_type body token token_header timeout bot_id" ;;
	esac
}

acct_key_ok() {
	# acct_key_ok <类型> <键>
	local _k
	for _k in $(acct_keys "$1"); do
		[ "$_k" = "$2" ] && return 0
	done
	return 1
}

acct_issue_add() {
	# acct_issue_add <mail|push> <账号名> <描述>：去重记录（status/json 用），只写一次日志
	local _kind="$1" _name="$2" _msg="$3" _key
	_key="$_kind:$_name"
	case "$ACCT_ISSUES" in
	*" $_key "*) return 0 ;;
	esac
	ACCT_ISSUES="$ACCT_ISSUES $_key "
	ACCT_ISSUE_MSGS="$ACCT_ISSUE_MSGS$_kind|$_name|$_msg$TAB"
	case "$ACCT_ISSUE_LOGGED" in
	*" $_key "*) ;;
	*)
		ACCT_ISSUE_LOGGED="$ACCT_ISSUE_LOGGED $_key "
		log "$_msg（已回退到默认段继续工作）"
		;;
	esac
	return 0
}

# ---- 推送通道识别（与 push.py 的 detect_channel 同一套判定）------------------

notify_channel_of() {
	# 由推送地址判断通道：serverchan|wecom|clawbot|custom|none
	# （push.py 把 custom 叫 webhook，这里按配置契约统一叫 custom，两种写法都接受）
	local _u="$1" _host
	[ -n "$_u" ] || { printf 'none'; return 0; }
	case "$_u" in
	http://127.0.0.1:*/bots/*/messages | https://127.0.0.1:*/bots/*/messages) printf 'clawbot'; return 0 ;;
	esac
	_host=$(printf '%s' "$_u" | sed -e 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##' -e 's#/.*$##' -e 's#^[^@]*@##' -e 's#:.*$##' | tr 'A-Z' 'a-z')
	case "$_host" in
	'') printf 'none' ;;
	sctapi.ftqq.com | *.push.ft07.com) printf 'serverchan' ;;
	qyapi.weixin.qq.com) printf 'wecom' ;;
	*) printf 'custom' ;;
	esac
}

notify_channel_name() {
	case "$1" in
	serverchan) printf 'Server酱' ;;
	wecom) printf '企业微信' ;;
	clawbot) printf 'ClawBot' ;;
	custom) printf '自定义' ;;
	*) printf '未配置' ;;
	esac
}

push_body_default() {
	# 各通道的默认请求体（与 push.py 的 SERVERCHAN_BODY / WECOM_BODY / WEBHOOK_BODY 一致）
	case "$1" in
	serverchan) printf '%s' '{"title":"{title}","desp":"{text}"}' ;;
	wecom) printf '%s' '{"msgtype":"text","text":{"content":"{text}"}}' ;;
	*) printf '%s' '{"text":"{text}"}' ;;
	esac
}

serverchan_url_of() {
	# SendKey -> 推送地址（与 push.py 的 serverchan_url 同一规则）
	local _k="$1" _num
	case "$_k" in
	'') : ;;
	sctp*)
		_num=$(printf '%s' "$_k" | sed -n 's/^sctp\([0-9][0-9]*\).*$/\1/p')
		[ -n "$_num" ] && printf 'https://%s.push.ft07.com/send/%s.send' "$_num" "$_k"
		;;
	*) printf 'https://sctapi.ftqq.com/%s.send' "$_k" ;;
	esac
}

clawbot_url_of() {
	# clawbot_url_of <bot_id> [端口]：本机 ClawBot API 的推送地址
	local _bot="$1" _port="$2"
	[ -n "$_bot" ] || return 0
	[ -n "$_port" ] || _port="$D_CLAWBOT_PORT"
	printf 'http://127.0.0.1:%s/bots/%s/messages' "$_port" "$_bot"
}

clawbot_port() {
	# ClawBot 服务端口：优先 uci weclawbot-api，其次它的配置文件，最后默认 26322
	local _p=""
	_p=$(pf_uci -q get weclawbot-api.main.port 2>/dev/null)
	[ -n "$_p" ] || _p=$(pf_uci -q get 'weclawbot-api.@server[0].port' 2>/dev/null)
	[ -n "$_p" ] || _p=$(sed -n 's/^[[:space:]]*option[[:space:]]*port[[:space:]]*//p' /etc/config/weclawbot-api 2>/dev/null | tr -d "\"'" | head -1)
	case "$_p" in
	'' | *[!0-9]*) _p="$D_CLAWBOT_PORT" ;;
	esac
	printf '%s' "$_p"
}

clawbot_token_of() {
	# 从 ClawBot 的 auth.json 里取某个 bot 的 api_token（只用于拼 Authorization 头，绝不打印）
	# 路径可用 PF_CLAWBOT_AUTH 覆盖（隔离测试用；生产不用设置）。
	local _bot="$1" _f="" _p
	[ -n "$_bot" ] || return 0
	if [ -n "$PF_CLAWBOT_AUTH" ]; then
		_f="$PF_CLAWBOT_AUTH"
	else
		for _p in /etc/weclawbot/config/auth.json /opt/weclawbot/config/auth.json; do
			if [ -f "$_p" ]; then _f="$_p"; break; fi
		done
	fi
	[ -n "$_f" ] && [ -f "$_f" ] || return 0
	awk -v want="$_bot" '
	{
		text = text $0 "\n"
	}
	END {
		# 先定位 "bot_id" 这个键，再花括号配对取出它的对象，最后在对象里找 api_token。
		# 字符串里的花括号/引号要跳过（auth.json 是普通 JSON，够用）。
		key = "\"" want "\""
		i = index(text, key)
		if (i == 0) exit
		rest = substr(text, i + length(key))
		b = index(rest, "{")
		if (b == 0) exit
		depth = 0; obj = ""; inq = 0; esc = 0
		for (k = b; k <= length(rest); k++) {
			c = substr(rest, k, 1)
			if (esc) { esc = 0; obj = obj c; continue }
			if (c == "\\") { esc = 1; obj = obj c; continue }
			if (c == "\"") { inq = 1 - inq; obj = obj c; continue }
			if (!inq) {
				if (c == "{") depth++
				else if (c == "}") {
					depth--
					if (depth == 0) { obj = obj c; break }
				}
			}
			obj = obj c
		}
		p = index(obj, "\"api_token\"")
		if (p == 0) exit
		q = index(substr(obj, p), ":")
		if (q == 0) exit
		v = substr(obj, p + q - 1)
		d = index(v, "\"")
		if (d == 0) exit
		v = substr(v, d + 1)
		out = ""; e = 1
		while (e <= length(v)) {
			c = substr(v, e, 1)
			if (c == "\\") { e++; out = out substr(v, e, 1) }
			else if (c == "\"") break
			else out = out c
			e++
		}
		print out
	}
	' "$_f"
}

# ---- 有效发件方 / 推送通道（room_apply_env 调用）-----------------------------

mail_env_base() {
	# 回到默认（mail 段）发件方：没有账号、账号不可用（回退）都走这里
	MAIL_TRANSPORT="$MAIL_BASE_TRANSPORT"
	MAIL_HOST="$MAIL_BASE_HOST"
	MAIL_PORT="$MAIL_BASE_PORT"
	MAIL_SECURITY="$MAIL_BASE_SECURITY"
	MAIL_USER="$MAIL_BASE_USER"
	MAIL_PASSWORD="$MAIL_BASE_PASSWORD"
	MAIL_FROM="$MAIL_BASE_FROM"
	MAIL_FROM_NAME="$MAIL_BASE_FROM_NAME"
	MAIL_TLS_VERIFY="$MAIL_BASE_TLS_VERIFY"
	MAIL_ACCOUNT_EFFECTIVE=""
	MAIL_ACCT_ISSUE=""
	return 0
}

mail_env_apply() {
	# mail_env_apply <账号名>：把「当前房间」的有效发件方写进 MAIL_* 全局。
	# 账号名留空 = 默认 mail 段；账号不存在 / 已停用 / 缺 host·user·password
	# → 记问题（日志 + status/json）并回退到 mail 段（提醒不能因此静默消失）。
	# 注意：故意不动 MAIL_ENABLED —— 邮件总开关只认 mail.enabled，账号段绕不过去。
	local _name="$1" _en _miss
	mail_env_base
	[ -n "$_name" ] || return 0
	if ! acct_section_exists mail_account "$_name"; then
		MAIL_ACCT_ISSUE="发件账号「$_name」不存在"
		acct_issue_add mail "$_name" "$MAIL_ACCT_ISSUE"
		return 0
	fi
	_en=$(room_get "$_name" enabled "$D_MAIL_ACCT_ENABLED")
	if [ "$_en" != "1" ]; then
		MAIL_ACCT_ISSUE="发件账号「$_name」已停用（enabled=0）"
		acct_issue_add mail "$_name" "$MAIL_ACCT_ISSUE"
		return 0
	fi
	MAIL_TRANSPORT=$(room_get "$_name" transport "$MAIL_BASE_TRANSPORT")
	MAIL_HOST=$(room_get "$_name" host "$MAIL_BASE_HOST")
	MAIL_PORT=$(room_get "$_name" port "$MAIL_BASE_PORT")
	MAIL_SECURITY=$(room_get "$_name" security "$MAIL_BASE_SECURITY")
	MAIL_USER=$(room_get "$_name" user "$MAIL_BASE_USER")
	MAIL_PASSWORD=$(room_get "$_name" password "$MAIL_BASE_PASSWORD")
	MAIL_FROM=$(room_get "$_name" from "$MAIL_BASE_FROM")
	MAIL_FROM_NAME=$(room_get "$_name" from_name "$MAIL_BASE_FROM_NAME")
	MAIL_TLS_VERIFY=$(room_get "$_name" tls_verify "$MAIL_BASE_TLS_VERIFY")
	_miss=""
	[ -n "$MAIL_HOST" ] || _miss="host"
	[ -n "$MAIL_USER" ] || _miss="${_miss:+$_miss、}user"
	[ -n "$MAIL_PASSWORD" ] || _miss="${_miss:+$_miss、}password"
	if [ -n "$_miss" ]; then
		_miss="发件账号「$_name」缺少 $_miss（该账号不可用）"
		mail_env_base
		MAIL_ACCT_ISSUE="$_miss"
		acct_issue_add mail "$_name" "$_miss"
		return 0
	fi
	MAIL_ACCOUNT_EFFECTIVE="$_name"
	return 0
}

notify_env_base() {
	# 回到默认（notify 段）推送通道
	NOTIFY_URL="$NOTIFY_BASE_URL"
	NOTIFY_METHOD="$NOTIFY_BASE_METHOD"
	NOTIFY_CONTENT_TYPE="$NOTIFY_BASE_CONTENT_TYPE"
	NOTIFY_BODY="$NOTIFY_BASE_BODY"
	NOTIFY_TOKEN="$NOTIFY_BASE_TOKEN"
	NOTIFY_TOKEN_HEADER="$NOTIFY_BASE_TOKEN_HEADER"
	NOTIFY_TIMEOUT="$NOTIFY_BASE_TIMEOUT"
	NOTIFY_ACCOUNT_EFFECTIVE=""
	NOTIFY_ACCT_ISSUE=""
	NOTIFY_CHANNEL=$(notify_channel_of "$NOTIFY_URL")
	return 0
}

notify_env_apply() {
	# notify_env_apply <账号名> <房间级 url> <房间级 token>
	# 基底 = 账号（留空 = notify 段），随后房间级 url/token 覆盖基底的同名字段。
	# 只写 NOTIFY_*，不动 NOTIFY_ENABLED（它由房间层的 notify_enabled 决定）。
	local _name="$1" _rurl="$2" _rtok="$3" _en _ch="" _ownurl _bot
	notify_env_base
	if [ -n "$_name" ]; then
		if ! acct_section_exists push_account "$_name"; then
			NOTIFY_ACCT_ISSUE="推送账号「$_name」不存在"
		else
			_en=$(room_get "$_name" enabled "$D_PUSH_ACCT_ENABLED")
			if [ "$_en" != "1" ]; then
				NOTIFY_ACCT_ISSUE="推送账号「$_name」已停用（enabled=0）"
			else
				_ch=$(room_get "$_name" channel "")
				_ownurl=$(room_get "$_name" url "")
				NOTIFY_METHOD=$(room_get "$_name" method "$NOTIFY_BASE_METHOD")
				NOTIFY_CONTENT_TYPE=$(room_get "$_name" content_type "$NOTIFY_BASE_CONTENT_TYPE")
				NOTIFY_BODY=$(room_get "$_name" body "$NOTIFY_BASE_BODY")
				NOTIFY_TOKEN_HEADER=$(room_get "$_name" token_header "$NOTIFY_BASE_TOKEN_HEADER")
				NOTIFY_TIMEOUT=$(room_get "$_name" timeout "$NOTIFY_BASE_TIMEOUT")
				NOTIFY_TOKEN=$(room_get "$_name" token "$NOTIFY_BASE_TOKEN")
				NOTIFY_URL=$(acct_pick3 "" "$_ownurl" "$NOTIFY_BASE_URL")
				_bot=$(room_get "$_name" bot_id "")
				case "$_ch" in
				webhook) _ch="custom" ;;
				esac
				[ -n "$_ch" ] || _ch=$(notify_channel_of "$NOTIFY_URL")
				case "$_ch" in
				clawbot)
					# 契约：channel=clawbot 且账号自己的 url 为空时用本机 ClawBot API
					# （不继承 notify.url —— 继承来的多半是别的通道的地址）
					if [ -z "$_ownurl" ]; then
						if [ -z "$_bot" ]; then
							NOTIFY_ACCT_ISSUE="推送账号「$_name」是 clawbot 通道但没写 bot_id"
						else
							NOTIFY_URL=$(clawbot_url_of "$_bot" "$(clawbot_port)")
							[ -n "$NOTIFY_TOKEN" ] || NOTIFY_TOKEN="Bearer $(clawbot_token_of "$_bot")"
						fi
					fi
					;;
				serverchan)
					# 地址为空时允许只填 token（SendKey）：按 push.py 的规则拼出地址
					if [ -z "$NOTIFY_URL" ] && [ -n "$NOTIFY_TOKEN" ]; then
						NOTIFY_URL=$(serverchan_url_of "$NOTIFY_TOKEN")
					fi
					;;
				esac
				[ -n "$NOTIFY_ACCT_ISSUE" ] || NOTIFY_ACCOUNT_EFFECTIVE="$_name"
			fi
		fi
		[ -n "$NOTIFY_ACCT_ISSUE" ] && acct_issue_add push "$_name" "$NOTIFY_ACCT_ISSUE"
	fi
	# 房间级覆盖（契约：房间 notify_url / notify_token 覆盖基底同名字段）
	[ -n "$_rurl" ] && NOTIFY_URL="$_rurl"
	[ -n "$_rtok" ] && NOTIFY_TOKEN="$_rtok"
	# 通道：账号自己写了就用它，否则按最终地址判断
	if [ -n "$_ch" ]; then
		NOTIFY_CHANNEL="$_ch"
	else
		NOTIFY_CHANNEL=$(notify_channel_of "$NOTIFY_URL")
	fi
	return 0
}

room_reapply_current() {
	# 账号解析 / 账号列表会改 MAIL_*/NOTIFY_* 全局，用完恢复「当前房间」的上下文
	if [ "$ROOM_COUNT" -gt 0 ]; then
		rooms_select_default
	else
		room_legacy_prepare
		room_apply_env
	fi
	return 0
}

# ============================================================================
# 房间集合（多房间支持）
#
# 老配置（没有任何 config room 段）：沿用 main.room_num/campus/building/room
# 的单房间模式，状态与历史仍写在 state / history.csv —— 行为与 1.0.x 完全一致。
#
# 多房间（存在 config room 段）：每个房间一份状态 state.<段名> 与历史
# history.<段名>.csv，判定、冷却、收件人、推送通道全部独立；接口一次返回全校房间，
# 所以只请求一次，再按编号把结果分发给各房间。
#
# 每个房间可覆盖的字段（留空即继承 main / mail / notify 的默认值）：
#   num（接口里的房间编号，必填）label（展示名）campus/building/room（展示用）
#   threshold（阈值）mail_to（收件人）mail_account（发件账号，1.2.0）
#   notify_account（推送账号，1.2.0）notify_url/notify_token（推送通道覆盖）
#   notify_enabled（是否推送）enabled（是否监控）
#
# 迁移：把第一个房间的编号设成 main.room_num（老用户的老房间）时，check 或
# room-add 会自动把老的 state / history.csv 复制给它（state.<段名> / history.<段名>.csv），
# 老文件保留不动 —— 升级后不丢历史、也不会重复发提醒（状态里有 last_alert_at）。
# ============================================================================

rooms_scan() {
	# 列出 config room 段名；没有则 ROOM_IDS 为空 → 单房间（老）模式
	ROOM_IDS=""
	ROOM_COUNT=0
	[ -f /lib/functions.sh ] || return 0
	ROOM_IDS=$(pf_uci -q show powerfee 2>/dev/null | sed -n 's/^powerfee\.\([^.]*\)=room$/\1/p')
	# 匿名段（`uci add powerfee room` 产生的 @room[0]）要显式剔除并告警：
	# config_get 只认段名，而匿名段的实际段名是 config_load 内部生成的，拿 @room[0]
	# 取不到任何值 —— 不剔除的话房间会被静默忽略，用户只会看到「配了却没生效」。
	# 要加房间请用 powerfee room-add（它建的是命名段），或手写 config room 'room1'。
	_anon=$(printf '%s\n' $ROOM_IDS | sed -n '/^@/p' | tr '\n' ' ')
	if [ -n "${_anon# }" ]; then
		echo "警告：忽略了匿名 room 段（${_anon% }）—— 匿名段无法按名读取配置。" >&2
		echo "      请用 powerfee room-add 添加房间，或把配置写成 config room 'room1' 这样的命名段。" >&2
		ROOM_IDS=$(printf '%s\n' $ROOM_IDS | sed '/^@/d' | tr '\n' ' ')
	fi
	for _r in $ROOM_IDS; do
		ROOM_COUNT=$((ROOM_COUNT + 1))
	done
}

room_get() {
	# room_get <段名> <选项> [默认值]：从已加载的 UCI 配置里取值（config_load 由 load_config 做）
	local _v=""
	config_get _v "$1" "$2" ""
	[ -n "$_v" ] || _v="$3"
	printf '%s' "$_v"
}

room_display_of() {
	# 由 R_LABEL / R_BUILDING / R_NAME / R_NUM 算出展示名（label 优先，其次「楼栋 房间」）
	local _d="$R_LABEL"
	if [ -z "$_d" ]; then
		_d="$R_NAME"
		[ -n "$R_BUILDING" ] && _d="$R_BUILDING $R_NAME"
	fi
	[ -n "$_d" ] || _d="$R_NUM"
	printf '%s' "$_d"
}

room_campus_suffix_set() {
	# 展示用的校区后缀：自定义 label 时不再追加（label 已经是完整的展示名，
	# 否则会显示成「2号楼 B202（西区）（西区）」）
	if [ -n "$R_LABEL" ]; then
		R_CAMPUS_SUFFIX=""
	else
		R_CAMPUS_SUFFIX="$R_CAMPUS"
	fi
}

room_load() {
	# room_load <段名>：把该房间的有效配置读进 R_* 全局（继承 main/mail/notify 的默认值）
	# 返回 1 = 房间无效（没有 num），调用方应跳过
	R_SECTION="$1"
	R_ID=$(printf '%s' "$1" | sed 's/[^A-Za-z0-9_.-]//g')
	[ -n "$R_ID" ] || R_ID="room"
	R_ENABLED=$(room_get "$1" enabled "1")
	R_NUM=$(room_get "$1" num "")
	[ -n "$R_NUM" ] || return 1
	R_LABEL=$(room_get "$1" label "")
	R_CAMPUS=$(room_get "$1" campus "")
	R_BUILDING=$(room_get "$1" building "")
	R_NAME=$(room_get "$1" room "")
	R_THRESHOLD=$(room_get "$1" threshold "$MAIN_THRESHOLD")
	R_MAIL_TO=$(room_get "$1" mail_to "$MAIN_MAIL_TO")
	# 账号引用（1.2.0）：留空 = 用 mail / notify 段
	R_MAIL_ACCOUNT=$(room_get "$1" mail_account "")
	R_NOTIFY_ACCOUNT=$(room_get "$1" notify_account "")
	# 注意：notify_url / notify_token 存的是「房间自己写的值」（空 = 没写），
	# 继承链是 房间 → 推送账号 → notify 段，由 notify_env_apply 统一算。
	R_NOTIFY_URL=$(room_get "$1" notify_url "")
	R_NOTIFY_TOKEN=$(room_get "$1" notify_token "")
	R_NOTIFY_ENABLED=$(room_get "$1" notify_enabled "$MAIN_NOTIFY_ENABLED")
	R_STATE_FILE="$CONF_DIR/state.$R_ID"
	R_HISTORY_FILE="$CONF_DIR/history.$R_ID.csv"
	R_DISPLAY=$(room_display_of)
	room_campus_suffix_set
	return 0
}

room_apply_env() {
	# 把 R_* 应用到「当前房间」全局：邮件/推送模板、状态文件路径都用这些全局，
	# 所以换房间 = 换一组全局值（ash 单线程，切换是安全的）。
	# 故意不用 local：这些就是要让 mail_alert / notify_send / state_* 看到的。
	ROOM_NUM="$R_NUM"
	ROOM_DISPLAY="$R_DISPLAY"
	CAMPUS="$R_CAMPUS"
	CAMPUS_SUFFIX="$R_CAMPUS_SUFFIX"
	BUILDING="$R_BUILDING"
	ROOM="$R_NAME"
	THRESHOLD="$R_THRESHOLD"
	MAIL_TO="$R_MAIL_TO"
	# 发件方与推送通道：按账号引用解析出有效值（1.2.0；没有账号段时结果与 1.1.0 相同）
	mail_env_apply "$R_MAIL_ACCOUNT"
	notify_env_apply "$R_NOTIFY_ACCOUNT" "$R_NOTIFY_URL" "$R_NOTIFY_TOKEN"
	NOTIFY_ENABLED="$R_NOTIFY_ENABLED"
	STATE_FILE="$R_STATE_FILE"
	HISTORY_FILE="$R_HISTORY_FILE"
}

rooms_select_default() {
	# 多房间模式：把第一个启用的房间（没有启用的就用第一个）设为「当前房间」，
	# 供 status / brief / history / test-mail 这类不带房间参数的命令使用。
	# 单房间（老）模式：什么都不做（main.* 已经在当前房间里）。
	local _id
	[ "$ROOM_COUNT" -gt 0 ] || return 0
	for _id in $ROOM_IDS; do
		room_load "$_id" || continue
		if [ "$R_ENABLED" = "1" ]; then
			room_apply_env
			return 0
		fi
	done
	for _id in $ROOM_IDS; do
		room_load "$_id" || continue
		room_apply_env
		return 0
	done
	return 0
}

room_resolve_id() {
	# 把「段名或房间编号」解析成段名打到 stdout（room-set / room-remove / history 用）
	local _want="$1" _r
	[ -n "$_want" ] || return 1
	for _r in $ROOM_IDS; do
		[ "$_r" = "$_want" ] && { printf '%s' "$_r"; return 0; }
	done
	for _r in $ROOM_IDS; do
		room_load "$_r" || continue
		[ "$R_NUM" = "$_want" ] && { printf '%s' "$_r"; return 0; }
	done
	return 1
}

room_num_owner() {
	# room_num_owner <编号>：某个 config room 段的 num 等于它时打印段名（没找到打印空）
	# 批量添加用它去重：已经在监控里的房间不重复建段。
	local _want="$1" _r
	[ -n "$_want" ] || return 0
	for _r in $ROOM_IDS; do
		room_load "$_r" || continue
		[ "$R_NUM" = "$_want" ] && { printf '%s' "$_r"; return 0; }
	done
	return 0
}

room_nums_taken() {
	# room_nums_taken：所有 config room 段的编号，空格分隔（批量添加一次性取出，逐个目标比对用）
	local _r _out=""
	for _r in $ROOM_IDS; do
		room_load "$_r" || continue
		[ -n "$R_NUM" ] && _out="$_out $R_NUM"
	done
	printf '%s' "$_out"
}

room_num_taken() {
	# room_num_taken <编号> <编号列表（空格分隔）>：命中打印 1，否则打印空
	# 纯函数（不读 uci / 接口），selftest 直接测 —— 这是批量添加「去重跳过」的判定。
	[ -n "$1" ] || return 0
	case " $2 " in
	*" $1 "*) printf '1' ;;
	esac
	return 0
}

rooms_migrate_legacy() {
	# 老用户升级：把单房间模式的 state / history.csv 平滑继承给第一个房间。
	# 仅当「第一个房间的编号 == main.room_num」且它还没有自己的状态文件时执行。
	# 老文件保留（万一以后又删掉全部 config room 段，单房间模式还能接着用）。
	local _first _num
	[ "$ROOM_COUNT" -gt 0 ] || return 0
	_first=${ROOM_IDS%% *}
	[ -n "$_first" ] || return 0
	room_load "$_first" || return 0
	_num="$R_NUM"
	[ -n "$MAIN_ROOM_NUM" ] && [ "$_num" = "$MAIN_ROOM_NUM" ] || return 0
	if [ -f "$R_STATE_FILE" ] || [ -f "$R_HISTORY_FILE" ]; then
		return 0
	fi
	[ -f "$CONF_DIR/state" ] || [ -f "$CONF_DIR/history.csv" ] || return 0
	[ -f "$CONF_DIR/state" ] && cp -p "$CONF_DIR/state" "$R_STATE_FILE"
	[ -f "$CONF_DIR/history.csv" ] && cp -p "$CONF_DIR/history.csv" "$R_HISTORY_FILE"
	log "已把原单房间的状态与历史继承给第一个监控房间 $_first（$R_DISPLAY）：state.$R_ID / history.$R_ID.csv"
	return 0
}

room_legacy_prepare() {
	# 单房间（老）模式：把 main.* 合成「当前房间」（状态/历史路径沿用 state / history.csv）
	R_SECTION="main"
	R_ID="legacy"
	R_ENABLED="$MAIN_ENABLED"
	R_NUM="$MAIN_ROOM_NUM"
	R_LABEL=""
	R_CAMPUS="$MAIN_CAMPUS"
	R_BUILDING="$MAIN_BUILDING"
	R_NAME="$MAIN_ROOM"
	R_THRESHOLD="$MAIN_THRESHOLD"
	R_MAIL_TO="$MAIN_MAIL_TO"
	R_MAIL_ACCOUNT=""
	R_NOTIFY_ACCOUNT=""
	R_NOTIFY_URL=""
	R_NOTIFY_TOKEN=""
	R_NOTIFY_ENABLED="$MAIN_NOTIFY_ENABLED"
	R_DISPLAY="$MAIN_ROOM_DISPLAY"
	R_CAMPUS_SUFFIX="$MAIN_CAMPUS"
	R_STATE_FILE="$STATE_FILE"
	R_HISTORY_FILE="$HISTORY_FILE"
}

rooms_each() {
	# rooms_each <回调> <force> <now> <fetch_ok>：对每个「要检查的房间」调用一次回调
	# 单房间（老）模式：合成一个房间（main.* 的值 + 老的状态文件路径），
	# 多房间模式：逐个 config room 段（缺 num 的跳过并记日志）。
	local _fn="$1"
	[ "$ROOM_COUNT" -gt 0 ] || {
		room_legacy_prepare
		room_apply_env
		"$_fn" "$2" "$3" "$4"
		return 0
	}
	for _r in $ROOM_IDS; do
		if ! room_load "$_r"; then
			log "房间配置 $_r 没有设置 num（编号），已跳过；用 powerfee room-set $_r num <编号> 补上"
			continue
		fi
		room_apply_env
		"$_fn" "$2" "$3" "$4"
	done
}

log_room() {
	# 多房间模式下给日志加房间前缀（单房间保持老格式，老日志断言不受影响）
	if [ "$ROOM_COUNT" -gt 0 ]; then
		log "[$ROOM_DISPLAY] $1"
	else
		log "$1"
	fi
}

room_state_load() {
	# 把「当前房间」的状态读进 RS_* 全局（status / room-list / json status 共用）。
	# 调用前先 room_apply_env，让 STATE_FILE / HISTORY_FILE 指向该房间。
	RS_BALANCE=$(state_get last_balance)
	RS_LEVEL=$(state_get last_level)
	[ -n "$RS_LEVEL" ] || RS_LEVEL=unknown
	RS_OK_AT=$(state_get last_ok_at)
	RS_ERR=$(state_get last_error)
	RS_ALERT_AT=$(state_get last_alert_at)
	RS_ALERT_REASON=$(state_get last_alert_reason)
	RS_POLL=$(state_get poll_count)
	RS_DAILY="-"
	RS_DAYS="-"
	if [ -f "$HISTORY_FILE" ]; then
		RS_STATS=$(compute_stats "$HISTORY_FILE" "${RS_BALANCE:-0}" "$(now_epoch)")
		RS_DAILY=$(echo "$RS_STATS" | awk '{print $1}')
		RS_DAYS=$(echo "$RS_STATS" | awk '{print $2}')
	fi
	# 「算不出」在 JSON 里要输出 null（"-" 会被 json_num 当成数字原样输出），
	# 这里统一转成空串，人类可读输出用 [ -n ] 判断
	[ "$RS_DAILY" = "-" ] && RS_DAILY=""
	[ "$RS_DAYS" = "-" ] && RS_DAYS=""
}

# ============================================================================
# 接口访问（通用：适配任意学校的电费查询接口）
#
# 请求形状与返回结构全部由 UCI 的 api 段描述：
#   api.url / api.method / api.content_type / api.body   —— 怎么请求
#   api.rooms_path / api.ok_path / api.msg_path          —— 怎么找到房间数组与成功标志
#   api.field_*                                          —— 房间对象的字段名映射
# 所以本脚本不含任何具体学校的地址或字段名，换学校只改配置。
#
# 两个常见注意点（写在这里是因为踩过）：
#   * 有些学校的 WAF 见到 Origin 头就 403 —— curl 默认不发 Origin，别自己加
#   * 接口一次返回全校房间时响应可能很大（几百 KB ~ 1 MB），查询间隔别设太短
#
# 实测坑：路由器自带 dnsmasq 可能把接口域名整域指到不通的校内 DNS，
# 导致域名解析失败（curl 退出码 6）。因此解析失败时自动改用 api.dns_servers 里的
# 公共 DNS 解析，再用 curl --resolve 直连，保证监控不受路由器 DNS 配置影响。
# ============================================================================

resolve_via_dns() {
	local _host="$1" _srv _ip
	for _srv in $API_DNS_SERVERS; do
		_ip=$(nslookup "$_host" "$_srv" 2>/dev/null | awk '/^Address: /{print $2}' | grep -v ':' | tail -1)
		[ -n "$_ip" ] && { echo "$_ip"; return 0; }
	done
	return 1
}

api_request() {
	# api_request <输出文件> [resolve 用的 IP]；按配置发一次请求，回显 HTTP 码
	local _out="$1" _ip="$2" _url="$API_URL"
	if [ "$API_METHOD" = "GET" ]; then
		if [ -n "$_ip" ]; then
			curl -s -m "$API_TIMEOUT" --resolve "$API_HOST:443:$_ip" \
				-o "$_out" -w '%{http_code}' "$_url" 2>/dev/null
		else
			curl -s -m "$API_TIMEOUT" -o "$_out" -w '%{http_code}' "$_url" 2>/dev/null
		fi
	elif [ -n "$_ip" ]; then
		curl -s -m "$API_TIMEOUT" --resolve "$API_HOST:443:$_ip" \
			-o "$_out" -w '%{http_code}' \
			-X POST -H "Content-Type: $API_CONTENT_TYPE" \
			--data "$API_BODY" "$_url" 2>/dev/null
	else
		curl -s -m "$API_TIMEOUT" \
			-o "$_out" -w '%{http_code}' \
			-X POST -H "Content-Type: $API_CONTENT_TYPE" \
			--data "$API_BODY" "$_url" 2>/dev/null
	fi
}

fetch_rooms() {
	# 拉取房间列表到 $API_TMP，成功返回 0，失败把原因写 $ERR_TMP
	local _code _rc _ip _msg _got
	: >"$ERR_TMP"
	if [ -z "$API_URL" ]; then
		echo "尚未配置学校接口。先建 section 再填地址（URL 里的 & 一定要加引号）：uci set powerfee.api=api && uci set 'powerfee.api.url=https://你的学校/接口地址' && uci commit powerfee —— 详见 README「适配你的学校」" >"$ERR_TMP"
		return 1
	fi
	_code=$(api_request "$API_TMP")
	_rc=$?
	if [ "$_rc" = "6" ]; then
		# 域名解析失败：换备用 DNS 解析后重试
		_ip=$(resolve_via_dns "$API_HOST")
		if [ -z "$_ip" ]; then
			echo "域名解析失败：$API_HOST 在本机 DNS 与 $API_DNS_SERVERS 上都查不到" >"$ERR_TMP"
			return 1
		fi
		log "本机 DNS 解析 $API_HOST 失败，改用 $_ip 直连"
		_code=$(api_request "$API_TMP" "$_ip")
		_rc=$?
	fi
	if [ "$_rc" != "0" ]; then
		echo "请求失败：curl 退出码 $_rc" >"$ERR_TMP"
		return 1
	fi
	if [ "$_code" != "200" ]; then
		if [ "$_code" = "403" ]; then
			echo "HTTP 403：请求被拒绝（有些学校的 WAF 会因为多了 Origin 等请求头而拒绝）" >"$ERR_TMP"
		else
			echo "HTTP $_code" >"$ERR_TMP"
		fi
		return 1
	fi
	# 成功标志（可选，配置了才检查）
	if [ -n "$API_OK_PATH" ]; then
		_got=$(jsonfilter -i "$API_TMP" -e "$API_OK_PATH" 2>/dev/null | head -1)
		if [ "$_got" != "$API_OK_VALUE" ]; then
			_msg=""
			[ -n "$API_MSG_PATH" ] && _msg=$(jsonfilter -i "$API_TMP" -e "$API_MSG_PATH" 2>/dev/null | head -1)
			echo "接口返回失败：${_msg:-（$API_OK_PATH=$_got，期望 $API_OK_VALUE）}" >"$ERR_TMP"
			return 1
		fi
	fi
	# 单位以接口返回的为准（如 api.unit_field='du' 恒为「度」），拿不到再用配置值
	api_unit_refresh
	return 0
}

api_unit_refresh() {
	# 从房间列表里取单位字段（第一个非空值）；取不到就保持 api.unit 不变。
	# 只在 fetch_rooms 成功后调用（$API_TMP 里是本次响应）。
	local _u
	[ -n "$API_UNIT_FIELD" ] || return 0
	_u=$(jsonfilter -i "$API_TMP" -e "$API_ROOMS_PATH" 2>/dev/null |
		awk -v f="$API_UNIT_FIELD" "$AWK_JGET"' { v = jget($0, f); if (v != "") { print v; exit } }')
	[ -n "$_u" ] && API_UNIT="$_u"
	return 0
}

room_obj() {
	# room_obj <房间标识> [按哪个字段匹配，默认 field_id]
	# 房间列表每个元素一行 JSON，这里挑出匹配的那一行
	local _want="$1" _field="${2:-$API_FIELD_ID}"
	jsonfilter -i "$API_TMP" -e "$API_ROOMS_PATH" 2>/dev/null |
		awk -v want="$_want" -v f="$_field" "$AWK_JGET"'
			jget($0, f) == want { print; exit }'
}

room_field_of() {
	# room_field_of <一行 JSON> <逻辑字段名>
	# 逻辑字段名 -> 用户配置的实际字段名
	local _line="$1" _f
	case "$2" in
	id) _f="$API_FIELD_ID" ;;
	name) _f="$API_FIELD_NAME" ;;
	building) _f="$API_FIELD_BUILDING" ;;
	campus) _f="$API_FIELD_CAMPUS" ;;
	balance) _f="$API_FIELD_BALANCE" ;;
	*) _f="$2" ;;
	esac
	printf '%s' "$_line" | awk -v f="$_f" "$AWK_JGET"' { print jget($0, f); exit }'
}

room_field() {
	# room_field <房间标识> <逻辑字段名>
	room_field_of "$(room_obj "$1")" "$2"
}

room_fields_line() {
	# room_fields_line <房间标识>：一次遍历取出该房间的全部字段，输出一行
	# campus<TAB>building<TAB>name<TAB>balance<TAB>匹配到的编号（没找到时各字段为空）。
	# 多房间时每个房间调用一次，避免同一份响应反复解析（响应可能有几百 KB）。
	local _want="$1"
	jsonfilter -i "$API_TMP" -e "$API_ROOMS_PATH" 2>/dev/null |
		awk -v want="$_want" -v fi="$API_FIELD_ID" -v fr="$API_FIELD_NAME" \
			-v fb="$API_FIELD_BUILDING" -v fc="$API_FIELD_CAMPUS" -v fv="$API_FIELD_BALANCE" "$AWK_JGET"'
			jget($0, fi) == want {
				printf "%s\t%s\t%s\t%s\t%s\n", jget($0, fc), jget($0, fb), jget($0, fr), jget($0, fv), jget($0, fi)
				found = 1
				exit
			}
			END { if (!found) printf "\t\t\t\t\n" }'
}

# ============================================================================
# 每日用电量（1.2.0）
#
# 两个数据来源，优先逐日接口、取不到自动退回本地采样：
#   1) 逐日接口（api.daily_*）：按「房间 + 月份」取，历史月缓存、当月每次重取。
#      已知坑：每个历史月的最后一天不返回 —— 用下个月首日的数据恢复
#      （公式见 usage.py 的注释），下个月拿不到就把该日标成缺值，不瞎补。
#   2) 本地采样（history.<房间>.csv）：按「午夜前最后一点 / 午夜后第一点」归日，
#      充值跳变（余额上升）不参与当日累加。
# 取数 / 缓存 / 编排在这里（shell），解析 / 补齐 / 估算 / 绘图在 python3 助手
# usage.py。所有中间文件都落在 $USAGE_TMP（mktemp -d）里，用完整体删掉。
# ============================================================================

usage_py() {
	# 调用逐日助手；缺 python3 / 助手文件时明确失败（绝不静默）
	command -v python3 >/dev/null 2>&1 || { log "每日用电量需要 python3（apk add python3）"; return 1; }
	[ -f "$USAGE_PY" ] || { log "缺少 $USAGE_PY（随主程序一起安装）"; return 1; }
	[ -f "$CHART_PY" ] || { log "缺少 $CHART_PY（随主程序一起安装）"; return 1; }
	python3 "$USAGE_PY" "$@"
}

usage_tmp_init() {
	[ -n "$USAGE_TMP" ] && [ -d "$USAGE_TMP" ] && return 0
	USAGE_TMP=$(mktemp -d /tmp/powerfee.usage.XXXXXX) || return 1
	[ -d "$USAGE_TMP" ] || return 1
	return 0
}

usage_tmp_clean() {
	[ -n "$USAGE_TMP" ] && rm -rf "$USAGE_TMP"
	USAGE_TMP=""
	return 0
}

# ---- 日期/月份小工具（busybox date 的 -d 只认 @epoch，别拿它解析字符串）------

dec_of() {
	# '08' -> '8'（$((08)) 在 ash 里会被当八进制，先去掉前导零再用）
	local _v="$1"
	while :; do
		case "$_v" in
		0[0-9]*) _v="${_v#0}" ;;
		*) break ;;
		esac
	done
	printf '%s' "${_v:-0}"
}

month_of_date() { printf '%s' "${1%-*}"; }

month_num() {
	# 'YYYY-MM' -> 202610（月份比较用数字，避免依赖 shell 的字符串 < 运算）
	printf '%s' "$1" | tr -d '-'
}

month_prev() {
	local _y="${1%-*}" _m="${1#*-}"
	_m=$(dec_of "$_m")
	_m=$((_m - 1))
	if [ "$_m" -lt 1 ]; then _m=12; _y=$((_y - 1)); fi
	printf '%04d-%02d' "$_y" "$_m"
}

month_next() {
	local _y="${1%-*}" _m="${1#*-}"
	_m=$(dec_of "$_m")
	_m=$((_m + 1))
	if [ "$_m" -gt 12 ]; then _m=1; _y=$((_y + 1)); fi
	printf '%04d-%02d' "$_y" "$_m"
}

date_days_ago() {
	# date_days_ago <天数>：回显 N 天前（含今天算第 1 天）的 YYYY-MM-DD
	local _n="$1"
	printf '%s' "$(date -d "@$(( $(now_epoch) - (_n - 1) * 86400 ))" +%Y-%m-%d 2>/dev/null || date +%Y-%m-%d)"
}

usage_months_between() {
	# usage_months_between <起 YYYY-MM> <止 YYYY-MM>：逐月回显（含两端；最多 12 个月）
	local _m="$1" _end="$2" _n=0
	while [ "$(month_num "$_m")" -le "$(month_num "$_end")" ]; do
		printf '%s\n' "$_m"
		_n=$((_n + 1))
		[ "$_n" -ge 12 ] && break
		_m=$(month_next "$_m")
	done
}

# ---- 逐日接口取数 ------------------------------------------------------------

daily_body_render() {
	# daily_body_render <房间号> <YYYY-MM> <页> <每页天数>：把 api.daily_body 的
	# {room} {month} {page} {page_size} 单遍替换（逐字符拼，避免 gsub 吃反斜杠）
	printf '%s\n' "$DAILY_BODY" | awk -v room="$1" -v month="$2" -v page="$3" -v psize="$4" '
	{
		line = $0
		out = ""
		while ((i = index(line, "{")) > 0) {
			out = out substr(line, 1, i - 1)
			rest = substr(line, i)
			if (rest ~ /^\{room\}/) { out = out room; line = substr(rest, 7) }
			else if (rest ~ /^\{month\}/) { out = out month; line = substr(rest, 8) }
			else if (rest ~ /^\{page\}/) { out = out page; line = substr(rest, 7) }
			else if (rest ~ /^\{page_size\}/) { out = out psize; line = substr(rest, 12) }
			else { out = out "{"; line = substr(rest, 2) }
		}
		printf "%s", out line
	}'
}

daily_request() {
	# daily_request <输出文件> <请求体> [resolve 用的 IP]；回显 HTTP 码
	# 请求头纪律与 api_request 一致：只带 Content-Type，绝不加 Origin（WAF 会 403）
	local _out="$1" _body="$2" _ip="$3" _url="$DAILY_URL" _tmo="$DAILY_TIMEOUT"
	if [ -n "$DAILY_TIMEOUT_CAP" ] && [ "$_tmo" -gt "$DAILY_TIMEOUT_CAP" ] 2>/dev/null; then
		_tmo="$DAILY_TIMEOUT_CAP"
	fi
	if [ "$DAILY_METHOD" = "GET" ]; then
		if [ -n "$_body" ]; then
			case "$_url" in
			*\?*) _url="$_url&$_body" ;;
			*) _url="$_url?$_body" ;;
			esac
		fi
		# -g（--globoff）：地址/请求体里可能出现 { } [ ]，curl 默认会把它们当通配符
		if [ -n "$_ip" ]; then
			curl -g -s -m "$_tmo" --resolve "$DAILY_HOST:443:$_ip" \
				-o "$_out" -w '%{http_code}' "$_url" 2>/dev/null
		else
			curl -g -s -m "$_tmo" -o "$_out" -w '%{http_code}' "$_url" 2>/dev/null
		fi
	elif [ -n "$_ip" ]; then
		curl -s -m "$_tmo" --resolve "$DAILY_HOST:443:$_ip" \
			-o "$_out" -w '%{http_code}' \
			-X POST -H "Content-Type: $DAILY_CONTENT_TYPE" \
			--data "$_body" "$_url" 2>/dev/null
	else
		curl -s -m "$_tmo" \
			-o "$_out" -w '%{http_code}' \
			-X POST -H "Content-Type: $DAILY_CONTENT_TYPE" \
			--data "$_body" "$_url" 2>/dev/null
	fi
}

daily_fetch() {
	# daily_fetch <房间号> <YYYY-MM> <输出文件>：拉某房间某月的逐日数据
	# 成功返回 0；失败把原因写 $ERR_TMP（判断与提示照 fetch_rooms）
	local _room="$1" _month="$2" _out="$3"
	local _body _code _rc _ip _msg _got
	: >"$ERR_TMP"
	if [ -z "$DAILY_URL" ]; then
		echo "未配置逐日接口（api.daily_url 为空）" >"$ERR_TMP"
		return 1
	fi
	_body=$(daily_body_render "$_room" "$_month" 1 "$DAILY_PAGE_SIZE")
	_code=$(daily_request "$_out" "$_body")
	_rc=$?
	if [ "$_rc" = "6" ]; then
		# 域名解析失败：换备用 DNS 解析后重试（与 fetch_rooms 同一条降级路径）
		_ip=$(resolve_via_dns "$DAILY_HOST")
		if [ -z "$_ip" ]; then
			echo "域名解析失败：$DAILY_HOST 在本机 DNS 与 $API_DNS_SERVERS 上都查不到" >"$ERR_TMP"
			return 1
		fi
		log "本机 DNS 解析 $DAILY_HOST 失败，改用 $_ip 直连"
		_code=$(daily_request "$_out" "$_body" "$_ip")
		_rc=$?
	fi
	if [ "$_rc" != "0" ]; then
		echo "请求失败：curl 退出码 $_rc" >"$ERR_TMP"
		return 1
	fi
	if [ "$_code" != "200" ]; then
		if [ "$_code" = "403" ]; then
			echo "HTTP 403：请求被拒绝（有些学校的 WAF 会因为多了 Origin 等请求头而拒绝）" >"$ERR_TMP"
		else
			echo "HTTP $_code" >"$ERR_TMP"
		fi
		return 1
	fi
	if [ -n "$DAILY_OK_PATH" ]; then
		_got=$(jsonfilter -i "$_out" -e "$DAILY_OK_PATH" 2>/dev/null | head -1)
		if [ "$_got" != "$DAILY_OK_VALUE" ]; then
			_msg=""
			[ -n "$DAILY_MSG_PATH" ] && _msg=$(jsonfilter -i "$_out" -e "$DAILY_MSG_PATH" 2>/dev/null | head -1)
			echo "接口返回失败：${_msg:-（$DAILY_OK_PATH=$_got，期望 $DAILY_OK_VALUE）}" >"$ERR_TMP"
			return 1
		fi
	fi
	return 0
}

usage_parse_days() {
	# usage_parse_days <原始响应> <输出规整 JSON> <YYYY-MM|->：成功回 0 并回显状态行
	# 逐日数组交给 jsonfilter 按 api.daily_path 拆行（与 rooms_path 同一套写法）；
	# 字段提取、单位识别与「月末缺日」判断在 python 助手里。
	local _raw="$1" _out="$2" _month="$3" _daysf _marg="" _line _rc
	_daysf="$USAGE_TMP/days.$R_ID.$_month.jsonl"
	jsonfilter -i "$_raw" -e "$DAILY_PATH" >"$_daysf" 2>/dev/null
	if [ ! -s "$_daysf" ]; then
		echo "逐日数据为空（检查 api.daily_path=$DAILY_PATH 是否指向每日明细数组）" >"$ERR_TMP"
		return 1
	fi
	[ "$_month" = "-" ] || _marg="--month $_month"
	_line=$(usage_py parse --days-file "$_daysf" --raw-file "$_raw" --out "$_out" $_marg \
		--date-field "$DAILY_DATE_FIELD" --used-field "$DAILY_USED_FIELD" \
		--total-field "$DAILY_TOTAL_FIELD" --unit-field "$DAILY_UNIT_FIELD" \
		--unit-fallback "$API_UNIT" 2>"$ERR_TMP")
	_rc=$?
	[ "$_rc" = "0" ] || return 1
	printf '%s\n' "$_line"
	return 0
}

usage_cache_path() { printf '%s/usage.%s.%s.json' "$CONF_DIR" "$1" "$2"; }

usage_cache_ok() {
	# 缓存可用性：存在、是 JSON 对象、有 days 数组。坏缓存直接忽略并重取（不报错退出）
	local _f="$1"
	[ -f "$_f" ] && [ -s "$_f" ] || return 1
	head -c 1 "$_f" 2>/dev/null | grep -q '{' || return 1
	grep -q '"days"' "$_f" 2>/dev/null || return 1
	return 0
}

usage_month_get() {
	# usage_month_get <房间段id> <房间号> <YYYY-MM>：回显规整 JSON 的路径
	# 历史月（早于当月）：命中缓存直接回；缺「最后一天」时用下个月首日恢复后再缓存。
	# 当月：每次重取（数据每天在长，缓存没意义；一次约 3 KB）。
	local _rid="$1" _num="$2" _month="$3"
	local _cur _cache _raw _parsed _line _missing _final _nmonth _nraw _nparsed _nline
	_cur=$(date +%Y-%m)
	_cache=$(usage_cache_path "$_rid" "$_month")
	if [ "$(month_num "$_month")" -lt "$(month_num "$_cur")" ] && usage_cache_ok "$_cache"; then
		printf '%s' "$_cache"
		return 0
	fi
	_raw="$USAGE_TMP/raw.$_rid.$_month.json"
	_parsed="$USAGE_TMP/parsed.$_rid.$_month.json"
	if ! daily_fetch "$_num" "$_month" "$_raw"; then
		log_room "逐日数据取失败（$_month）：$(head -1 "$ERR_TMP" 2>/dev/null)"
		return 1
	fi
	_line=$(usage_parse_days "$_raw" "$_parsed" "$_month") || return 1
	_missing=$(printf '%s\n' "$_line" | sed -n 's/.*last_missing=1.*/1/p')
	_final="$_parsed"
	if [ "$(month_num "$_month")" -lt "$(month_num "$_cur")" ] && [ "$_missing" = "1" ]; then
		# 历史月缺最后一天：拿下一个月的首日数据补（下个月拿不到 -> 标缺值）
		_nmonth=$(month_next "$_month")
		_nraw="$USAGE_TMP/raw.$_rid.$_nmonth.json"
		_nparsed="$USAGE_TMP/parsed.$_rid.$_nmonth.json"
		_final="$USAGE_TMP/fixed.$_rid.$_month.json"
		if daily_fetch "$_num" "$_nmonth" "$_nraw" &&
			_nline=$(usage_parse_days "$_nraw" "$_nparsed" "$_nmonth"); then
			usage_py fix --month "$_month" --in "$_parsed" --out "$_final" \
				--next "$_nparsed" >/dev/null 2>"$ERR_TMP" || _final="$_parsed"
		else
			log_room "逐日数据：$_month 缺最后一天，$_nmonth 也取不到，该日标为缺值"
			usage_py fix --month "$_month" --in "$_parsed" --out "$_final" \
				>/dev/null 2>"$ERR_TMP" || _final="$_parsed"
		fi
	fi
	if [ "$(month_num "$_month")" -lt "$(month_num "$_cur")" ]; then
		# 历史月落缓存（原子替换；写不进去也不影响本次使用）
		if cp "$_final" "$_cache.new.$$" 2>/dev/null; then
			chmod 600 "$_cache.new.$$" 2>/dev/null
			mv -f "$_cache.new.$$" "$_cache" 2>/dev/null
		fi
		printf '%s' "$_cache"
		return 0
	fi
	printf '%s' "$_final"
	return 0
}

usage_estimate_file() {
	# usage_estimate_file <房间段id>：用当前房间的本地采样估算，回显规整 JSON 路径
	local _rid="$1" _out
	_out="$USAGE_TMP/estimate.$_rid.json"
	if [ ! -f "$HISTORY_FILE" ]; then
		log_room "没有本地采样（$(basename "$HISTORY_FILE")），估算不了每日用量"
		return 1
	fi
	if ! usage_py estimate --history "$HISTORY_FILE" --interval "$INTERVAL" \
		--unit "$API_UNIT" --out "$_out" >/dev/null 2>"$ERR_TMP"; then
		log_room "本地采样估算失败：$(head -1 "$ERR_TMP" 2>/dev/null)"
		return 1
	fi
	printf '%s' "$_out"
	return 0
}

usage_files_have_values() {
	local _f
	for _f in $USAGE_FILES; do
		grep -q '"used":[0-9-]' "$_f" 2>/dev/null && return 0
	done
	return 1
}

usage_inputs_file() {
	# 把输入文件清单写进一个文件（render 用 --in-list 读，避免路径里的空格问题）
	local _f
	: >"$USAGE_TMP/inputs.txt"
	for _f in $USAGE_FILES; do printf '%s\n' "$_f" >>"$USAGE_TMP/inputs.txt"; done
}

usage_prepare() {
	# usage_prepare <days|month|date> <值> [quick]
	# 备好渲染输入：USAGE_FILES（规整 JSON 路径列表）、USAGE_SOURCE（api|estimate）
	# 逐日接口优先；没配 / 取不到 / 该房间在接口里没数据 -> 退回本地采样估算。
	# quick=1 时把逐日接口超时压到 10 秒（告警邮件里现画曲线用，别拖慢发信）。
	local _mode="$1" _val="$2" _quick="$3" _months="" _m _f _ok=0 _save_cap="$DAILY_TIMEOUT_CAP"
	USAGE_FILES=""
	USAGE_SOURCE=""
	[ "$_quick" = "1" ] && DAILY_TIMEOUT_CAP=10
	case "$_mode" in
	month) _months="$_val" ;;
	date) _months=$(month_of_date "$_val") ;;
	*) _months=$(usage_months_between "$(month_of_date "$(date_days_ago "$_val")")" "$(date +%Y-%m)") ;;
	esac
	if [ -n "$DAILY_URL" ] && [ -n "$ROOM_NUM" ]; then
		# 多房间时逐房间取数（接口按房间号查），失败的月份跳过（别的月份还有数据）
		for _m in $_months; do
			_f=$(usage_month_get "$R_ID" "$ROOM_NUM" "$_m") || continue
			[ -n "$_f" ] || continue
			USAGE_FILES="$USAGE_FILES $_f"
		done
		usage_files_have_values && _ok=1
	fi
	if [ "$_ok" != "1" ]; then
		# 兜底：本地采样估算（接口没配、取不到、或这个房间在接口里没有逐日数据）
		if [ -n "$USAGE_FILES" ]; then
			log_room "逐日接口没有可用数据，改用本地采样估算"
		elif [ -n "$DAILY_URL" ]; then
			log_room "逐日接口取不到数据，改用本地采样估算"
		fi
		USAGE_FILES=""
		_f=$(usage_estimate_file "$R_ID") || { DAILY_TIMEOUT_CAP="$_save_cap"; return 1; }
		USAGE_FILES="$_f"
		USAGE_SOURCE="estimate"
	else
		USAGE_SOURCE="api"
	fi
	usage_inputs_file
	DAILY_TIMEOUT_CAP="$_save_cap"
	return 0
}

usage_window_args() {
	# usage_window_args <days|month|date> <值>：给 usage.py render 的窗口参数
	case "$1" in
	month) printf '%s %s' "--month" "$2" ;;
	date) printf '%s %s' "--date" "$2" ;;
	*) printf '%s %s' "--days" "$2" ;;
	esac
}

usage_render() {
	# usage_render <text|png|html|json> <days|month|date> <值> [usage.py render 的其它参数…]
	local _kind="$1" _mode="$2" _val="$3"
	shift 3
	usage_py render --kind "$_kind" --in-list "$USAGE_TMP/inputs.txt" \
		$(usage_window_args "$_mode" "$_val") --source "$USAGE_SOURCE" --unit "$API_UNIT" \
		"$@" 2>/dev/null
}

png_unit_of() {
	# PNG 里的点阵字体只有 ASCII：非 ASCII 单位（如「度」）换成 kWh，ASCII 原样用
	case "$1" in
	'' | *[!a-zA-Z0-9]*)
		printf 'kWh'
		;;
	*)
		printf '%s' "$1"
		;;
	esac
}

png_path_like() {
	# png_path_like <参数>：这个参数像不像一个「PNG 输出路径」？
	# 只认「以 / 开头」或「以 .png 结尾」—— 房间段名（room1）与编号（1234）都不会命中，
	# 所以 `--png` 后面那一个参数是不是路径可以安全判断（不吞房间参数）。
	case "$1" in
	/* | *.png) return 0 ;;
	esac
	return 1
}

usage_png_write() {
	# usage_png_write <days|month|date> <值> <输出文件> [宽度] [高度]
	local _mode="$1" _val="$2" _out="$3" _w="${4:-640}" _h="${5:-240}"
	usage_py render --kind png --in-list "$USAGE_TMP/inputs.txt" \
		$(usage_window_args "$_mode" "$_val") --source "$USAGE_SOURCE" \
		--width "$_w" --height "$_h" --title "Daily usage" \
		--unit "$(png_unit_of "$API_UNIT")" --out "$_out" >/dev/null 2>"$ERR_TMP"
}

usage_window_label() {
	# 窗口的中文名（邮件标题/图表标题用）
	case "$1" in
	month) printf '%s 月每日用电量' "$2" ;;
	date) printf '%s 用电量' "$2" ;;
	*) printf '近 %s 天用电量' "$2" ;;
	esac
}

usage_validate_window() {
	# usage_validate_window <days|month|date> <值>：格式不对就报错（不猜）
	case "$1" in
	month)
		case "$2" in
		[0-9][0-9][0-9][0-9]-[0-9][0-9]) ;;
		*) echo "月份格式不对：$2（要 YYYY-MM，如 2026-10）" >&2; return 1 ;;
		esac
		;;
	date)
		case "$2" in
		[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
		*) echo "日期格式不对：$2（要 YYYY-MM-DD，如 2026-10-05）" >&2; return 1 ;;
		esac
		;;
	*)
		case "$2" in
		'' | *[!0-9]*) echo "天数不对：$2（--days 要正整数）" >&2; return 1 ;;
		esac
		[ "$2" -ge 1 ] && [ "$2" -le 92 ] || { echo "--days 要在 1~92 之间（再多就直接 --month 看整月）" >&2; return 1; }
		;;
	esac
	return 0
}

# ---- 定时报告（1.2.0）-------------------------------------------------------
# main.report_time 到点给每个房间发一份「今日用量 + 最近 N 天曲线」的报告
# （邮件 + 推送，走各房间自己的账号与收件人）。报告是独立事件：
# 不改告警档位、不动冷却与去重（报告失败也不会影响正常告警）。
# 与查询时段（active_hours）的协调：曲线来自逐日接口（与查询时段无关），
# 「今日用量」来自本地采样 —— 窗口外的报告时间点用当天已有采样，不会发空报告。

report_state_get() {
	local _sf="$STATE_FILE" _v
	STATE_FILE="$REPORT_STATE_FILE"
	_v=$(state_get "$1")
	STATE_FILE="$_sf"
	printf '%s' "$_v"
}

report_state_set() {
	local _sf="$STATE_FILE"
	STATE_FILE="$REPORT_STATE_FILE"
	state_set "$@"
	STATE_FILE="$_sf"
}

report_time_norm() {
	# '9:00' / '09:00' -> '09:00'；留空或非法 -> 空串（调用方按「不发」处理）
	local _h _m
	case "$1" in
	*:*) _h="${1%%:*}"; _m="${1#*:}" ;;
	*) return 0 ;;
	esac
	case "$_h" in '' | *[!0-9]*) return 0 ;; esac
	case "$_m" in '' | *[!0-9]*) return 0 ;; esac
	_h=$(dec_of "$_h")
	_m=$(dec_of "$_m")
	[ "$_h" -le 23 ] 2>/dev/null || return 0
	[ "$_m" -le 59 ] 2>/dev/null || return 0
	printf '%02d:%02d' "$_h" "$_m"
}

report_due() {
	# 1 = 该发了（已过点且今天还没发）；0 = 不发
	# 比较用「当天第几分钟」（字符串比较在不同 busybox 上行为不一致，不赌它）
	local _t _now
	_t=$(report_time_norm "$REPORT_TIME")
	[ -n "$_t" ] || { printf '0'; return 0; }
	_now=$(( $(dec_of "$(date +%H)") * 60 + $(dec_of "$(date +%M)") ))
	_t=$(( $(dec_of "${_t%%:*}") * 60 + $(dec_of "${_t#*:}") ))
	[ "$_now" -ge "$_t" ] || { printf '0'; return 0; }
	if [ "$(report_state_get last_report_date)" = "$(date +%Y-%m-%d)" ]; then
		printf '0'
		return 0
	fi
	printf '1'
	return 0
}

report_sleep_cap() {
	# 距下一次报告时刻的秒数（没设报告时间 / 今天已发 -> 86400，等于不截短睡眠）
	local _t _secs _nows
	_t=$(report_time_norm "$REPORT_TIME")
	[ -n "$_t" ] || { printf '86400'; return 0; }
	if [ "$(report_state_get last_report_date)" = "$(date +%Y-%m-%d)" ]; then
		printf '86400'
		return 0
	fi
	_nows=$(( $(dec_of "$(date +%H)") * 3600 + $(dec_of "$(date +%M)") * 60 + $(dec_of "$(date +%S)") ))
	_secs=$(( ( $(dec_of "${_t%%:*}") * 3600 + $(dec_of "${_t#*:}") * 60 ) - _nows ))
	[ "$_secs" -lt 15 ] && _secs=15
	printf '%s' "$_secs"
}

sleep_with_report_cap() {
	# sleep_with_report_cap <基准秒数>：把守护进程的睡眠截短到「不晚于下一次报告」
	local _base="$1" _cap
	_cap=$(report_sleep_cap)
	[ "$_cap" -lt "$_base" ] 2>/dev/null && _base="$_cap"
	[ "$_base" -lt 5 ] 2>/dev/null && _base=5
	printf '%s' "$_base"
}

report_maybe_send() {
	# 到点发报告（守护进程每轮调用；不在点上时是空操作）
	local _fail _fdate
	[ "$(report_due)" = "1" ] || return 0
	_fdate=$(report_state_get fail_date)
	[ "$_fdate" = "$(date +%Y-%m-%d)" ] || report_state_set fail_count 0 fail_date "$(date +%Y-%m-%d)"
	log "定时报告时间到（main.report_time=$REPORT_TIME）：给每个房间发「今日用量 + 近 ${REPORT_DAYS} 天曲线」"
	if cmd_report_all "$REPORT_DAYS"; then
		report_state_set last_report_date "$(date +%Y-%m-%d)" fail_count 0
		return 0
	fi
	# 全都没发出去：最多重试 3 次，免得每分钟重试刷屏（失败原因看日志）
	_fail=$(report_state_get fail_count)
	case "$_fail" in '' | *[!0-9]*) _fail=0 ;; esac
	_fail=$((_fail + 1))
	if [ "$_fail" -ge 3 ]; then
		log "定时报告连续 $_fail 次发送失败，今天不再重试"
		report_state_set last_report_date "$(date +%Y-%m-%d)" fail_count 0
	else
		report_state_set fail_count "$_fail" fail_date "$(date +%Y-%m-%d)"
	fi
	return 0
}


# ============================================================================
# 判定逻辑（与托盘版 C# / 安卓版 Level.kt 同构）
# ============================================================================

level_of() {
	awk -v b="$1" -v t="$2" -v r="$3" 'BEGIN{
		if (b+0 < t+0) print "low";
		else if (b+0 < t*r) print "warn";
		else print "ok";
	}'
}

level_rank() {
	case "$1" in
	low) echo 2 ;;
	warn) echo 1 ;;
	*) echo 0 ;;   # ok / unknown 同级
	esac
}

level_text() {
	case "$1" in
	low) echo "电费不足" ;;
	warn) echo "接近阈值" ;;
	ok) echo "充足" ;;
	*) echo "未知" ;;
	esac
}

level_icon() {
	case "$1" in
	low) echo "⚠️" ;;
	warn) echo "🔔" ;;
	ok) echo "✅" ;;
	*) echo "❔" ;;
	esac
}

level_color() {
	case "$1" in
	low) echo "#d93025" ;;
	warn) echo "#e8710a" ;;
	ok) echo "#188038" ;;
	*) echo "#5f6368" ;;
	esac
}

decide_notify() {
	# 返回提醒原因，不需要提醒时输出空串。规则与两个客户端完全一致：
	#   1) 等级变差 -> 立即提醒（预警档可按配置静音）
	#   2) 持续低电量 -> 每隔 cooldown 分钟重复提醒
	#   3) 充值恢复 -> 提醒一次
	# 参数：prev_level prev_alert_at level now cooldown notify_warn notify_recovery
	local _prev="$1" _prev_at="$2" _cur="$3" _now="$4" _cd="$5" _nw="$6" _nr="$7"

	if [ "$(level_rank "$_cur")" -gt "$(level_rank "$_prev")" ]; then
		if [ "$_cur" = "warn" ] && [ "$_nw" != "1" ]; then
			echo ""
			return 0
		fi
		echo "${_prev}->${_cur}"
		return 0
	fi
	if [ "$_cur" = "low" ] && [ $((_now - ${_prev_at:-0})) -ge $((_cd * 60)) ]; then
		echo "repeat-low"
		return 0
	fi
	if [ "$_nr" = "1" ] && [ "$_prev" = "low" ] && [ "$_cur" != "low" ]; then
		echo "recovered"
		return 0
	fi
	echo ""
}

compute_stats() {
	# 用最近 72 小时采样估算日均用量与可用天数（与两个客户端同思路）
	# 参数：<历史文件> <当前余额> <now>；输出 "日均 天数"（算不出时 "- -"）
	awk -F, -v bal="$2" -v now="$3" '
		NF>=2 && $1 ~ /^[0-9]+$/ && $2 ~ /^-?[0-9.]+$/ { n++; t[n]=$1; v[n]=$2+0 }
		END {
			if (n < 2) { print "- -"; exit }
			cut = now - 72*3600
			m = 0
			for (i=1; i<=n; i++) if (t[i] >= cut) { m++; wt[m]=t[i]; wv[m]=v[i] }
			if (m < 2) {
				m = (n < 8 ? n : 8)
				for (i=1; i<=m; i++) { wt[i]=t[n-m+i]; wv[i]=v[n-m+i] }
			}
			hours = (wt[m] - wt[1]) / 3600.0
			if (hours < 3) { print "- -"; exit }
			used = wv[1] - wv[m]
			if (used <= 0) { printf "0.00 -\n"; exit }
			daily = used / hours * 24.0
			days = (bal+0 > 0 ? bal+0 : 0) / daily
			printf "%.2f %.1f\n", daily, days
		}
	' "$1"
}

history_append() {
	# 保留最近 7 天、最多 600 个采样点
	local _cut
	[ -d "$CONF_DIR" ] || mkdir -p "$CONF_DIR"
	printf '%s,%s\n' "$1" "$2" >>"$HISTORY_FILE"
	_cut=$(( $1 - 7 * 86400 ))
	awk -F, -v cut="$_cut" 'NF>=2 && $1+0 >= cut' "$HISTORY_FILE" | tail -600 >"$HISTORY_FILE.tmp"
	mv -f "$HISTORY_FILE.tmp" "$HISTORY_FILE"
	chmod 600 "$HISTORY_FILE" 2>/dev/null
}

# ============================================================================
# 邮件
#
# 正文在 shell 里拼成标准 RFC822（multipart/alternative：纯文本 + HTML），
# 两种投递方式共用同一封 .eml：
#   python3 —— smtplib 投递（路由器装了 python3 就能用）
#   msmtp   —— OpenWrt 最常见的小型 SMTP 客户端（apk add msmtp）
# 中文主题用 RFC2047 (=?UTF-8?B?...?=)；正文 base64，避免 8bit 乱码。
#
# 带曲线时（报告 / 余额告警）再套一层 multipart/related：
#   multipart/related（root = 里面的 alternative）
#     ├─ multipart/alternative [text/plain, text/html（<img src="cid:...">）]
#     └─ image/png（Content-ID 与 HTML 里的 cid 对应）—— 直接显示，不是附件
# 图是纯标准库手写的 PNG（chart.py），约 3 KB，不会把邮件撑大。
# ============================================================================

b64() {
	# stdin -> base64（busybox 无 base64，用 openssl；再退到 python3）
	if command -v openssl >/dev/null 2>&1; then
		openssl base64
	elif command -v python3 >/dev/null 2>&1; then
		python3 -c 'import sys,base64; sys.stdout.write(base64.encodebytes(sys.stdin.buffer.read()).decode())'
	else
		die "缺少 base64 编码工具（需要 openssl 或 python3）"
	fi
}

crlf() { awk '{printf "%s\r\n", $0}'; }

enc_word() { printf '%s' "$1" | b64 | tr -d '\n'; }

mailer_available() {
	case "$MAIL_TRANSPORT" in
	python3)
		python3 -c 'import smtplib, ssl, email' 2>/dev/null && echo python3
		;;
	msmtp)
		command -v msmtp >/dev/null 2>&1 && echo msmtp
		;;
	*)
		if python3 -c 'import smtplib, ssl, email' 2>/dev/null; then
			echo python3
		elif command -v msmtp >/dev/null 2>&1; then
			echo msmtp
		fi
		;;
	esac
}

mail_headers() {
	# 公共邮件头（mail_build 的两条分支共用；参数：<主题>）
	local _subject="$1" _from_addr="$MAIL_FROM"
	[ -n "$_from_addr" ] || _from_addr="$MAIL_USER"
	printf 'From: =?UTF-8?B?%s?= <%s>\r\n' "$(enc_word "$MAIL_FROM_NAME")" "$_from_addr"
	printf 'To: %s\r\n' "$(echo "$MAIL_TO" | tr -d ' ')"
	printf 'Subject: =?UTF-8?B?%s?=\r\n' "$(enc_word "$_subject")"
	printf 'Date: %s\r\n' "$(date -R 2>/dev/null || date '+%a, %d %b %Y %H:%M:%S %z')"
	printf 'Message-ID: <powerfee.%s.%s@%s>\r\n' "$(date +%s)" "$$" "$(dev_name)"
	printf 'X-Mailer: PowerFeeSentry-WRT/%s\r\n' "$VERSION"
	printf 'MIME-Version: 1.0\r\n'
}

mail_build() {
	# mail_build <eml 输出文件> <主题> <纯文本> <HTML> [内联 PNG 文件]
	# 不带 PNG：multipart/alternative（纯文本 + HTML）—— 与老版本完全一致。
	# 带 PNG：multipart/related（root = alternative，图用 Content-ID 内联）。
	local _out="$1" _subject="$2" _text="$3" _html="$4" _png="$5" _boundary
	local _rel _alt _altcid _cid
	if [ -n "$_png" ] && [ -f "$_png" ]; then
		_rel="----powerfee-rel-$(date +%s)-$$"
		_alt="----powerfee-alt-$(date +%s)-$$"
		_altcid="powerfee-alt-$(date +%s)-$$@powerfee"
		_cid="${MAIL_CHART_CID:-powerfee-chart-$(date +%s)-$$@powerfee}"
		{
			mail_headers "$_subject"
			printf 'Content-Type: multipart/related; boundary="%s"; start="<%s>"; type="multipart/alternative"\r\n' "$_rel" "$_altcid"
			printf '\r\n'
			printf '%s\r\n' "--$_rel"
			printf 'Content-Type: multipart/alternative; boundary="%s"\r\n' "$_alt"
			printf 'Content-ID: <%s>\r\n' "$_altcid"
			printf '\r\n'
			printf '%s\r\n' "--$_alt"
			printf 'Content-Type: text/plain; charset=UTF-8\r\n'
			printf 'Content-Transfer-Encoding: base64\r\n'
			printf '\r\n'
			printf '%s' "$_text" | b64 | crlf
			printf '\r\n'
			printf '%s\r\n' "--$_alt"
			printf 'Content-Type: text/html; charset=UTF-8\r\n'
			printf 'Content-Transfer-Encoding: base64\r\n'
			printf '\r\n'
			printf '%s' "$_html" | b64 | crlf
			printf '\r\n'
			printf '%s\r\n' "--$_alt--"
			printf '\r\n'
			printf '%s\r\n' "--$_rel"
			printf 'Content-Type: image/png; name="chart.png"\r\n'
			printf 'Content-Transfer-Encoding: base64\r\n'
			printf 'Content-ID: <%s>\r\n' "$_cid"
			printf 'Content-Disposition: inline; filename="chart.png"\r\n'
			printf '\r\n'
			b64 <"$_png" | crlf
			printf '\r\n'
			printf '%s\r\n' "--$_rel--"
		} >"$_out"
		return 0
	fi
	_boundary="----powerfee-$(date +%s)-$$"
	{
		mail_headers "$_subject"
		printf 'Content-Type: multipart/alternative; boundary="%s"\r\n' "$_boundary"
		printf '\r\n'
		printf '%s\r\n' "--$_boundary"
		printf 'Content-Type: text/plain; charset=UTF-8\r\n'
		printf 'Content-Transfer-Encoding: base64\r\n'
		printf '\r\n'
		printf '%s' "$_text" | b64 | crlf
		printf '\r\n'
		printf '%s\r\n' "--$_boundary"
		printf 'Content-Type: text/html; charset=UTF-8\r\n'
		printf 'Content-Transfer-Encoding: base64\r\n'
		printf '\r\n'
		printf '%s' "$_html" | b64 | crlf
		printf '\r\n'
		printf '%s\r\n' "--$_boundary--"
	} >"$_out"
}

mail_send() {
	# mail_send <eml 文件>；成功返回 0
	local _eml="$1" _kind _out _rc _rcfile
	_kind=$(mailer_available)
	if [ -z "$_kind" ]; then
		log "邮件未发送：找不到投递方式（需要 python3 或 msmtp，可 apk add msmtp）"
		return 1
	fi
	if [ "$_kind" = "python3" ]; then
		[ -f "$MAIL_PY" ] || { log "邮件未发送：缺少 $MAIL_PY"; return 1; }
		_out=$(python3 "$MAIL_PY" \
			--host "$MAIL_HOST" --port "$MAIL_PORT" --security "$MAIL_SECURITY" \
			--user "$MAIL_USER" --password "$MAIL_PASSWORD" \
			--from "${MAIL_FROM:-$MAIL_USER}" --to "$MAIL_TO" \
			--tls-verify "$MAIL_TLS_VERIFY" <"$_eml" 2>&1)
		_rc=$?
	else
		_rcfile=$(mktemp /tmp/powerfee.msmtprc.XXXXXX)
		chmod 600 "$_rcfile"
		{
			printf 'account powerfee\n'
			printf 'host %s\n' "$MAIL_HOST"
			printf 'port %s\n' "$MAIL_PORT"
			# 没配用户名就按无认证服务器处理（否则 msmtp 会因为空 user 报错）
			if [ -n "$MAIL_USER" ]; then
				printf 'auth on\n'
				printf 'user %s\n' "$MAIL_USER"
				printf 'password %s\n' "$MAIL_PASSWORD"
			else
				printf 'auth off\n'
			fi
			printf 'from %s\n' "${MAIL_FROM:-$MAIL_USER}"
			case "$MAIL_SECURITY" in
			ssl) printf 'tls on\ntls_starttls off\n' ;;
			starttls) printf 'tls on\ntls_starttls on\n' ;;
			*) printf 'tls off\n' ;;
			esac
			# 注意：msmtp 默认就是 tls_trust_file=system + tls_certcheck=on，
			# 所以「不写 trust file」并不能关掉校验，必须显式 tls_certcheck off
			if [ "$MAIL_TLS_VERIFY" = "1" ]; then
				printf 'tls_trust_file system\n'
			else
				printf 'tls_certcheck off\n'
			fi
			printf 'account default : powerfee\n'
		} >"$_rcfile"
		_out=$(msmtp -C "$_rcfile" -t <"$_eml" 2>&1)
		_rc=$?
		rm -f "$_rcfile"
	fi
	if [ "$_rc" != "0" ]; then
		log "邮件发送失败（$_kind）：$_out"
		return 1
	fi
	# 用了命名发件账号时把账号名写进日志（默认段时不加后缀，老日志格式不变）
	log "邮件已发送（$_kind）：$MAIL_TO$([ -n "$MAIL_ACCOUNT_EFFECTIVE" ] && echo "（发件账号 $MAIL_ACCOUNT_EFFECTIVE）")"
	return 0
}

# ---- 正文模板 --------------------------------------------------------------

mail_subject() {
	# mail_subject <reason> <level> <余额> <失效小时数>
	local _reason="$1" _level="$2" _bal="$3" _hours="$4"
	case "$_reason" in
	recovered) echo "✅ 宿舍电量已恢复：$ROOM_DISPLAY 剩余 $_bal $API_UNIT" ;;
	stale) echo "❗ 宿舍电量监控异常：已 $_hours 小时未取到数据" ;;
	stale-ok) echo "✅ 宿舍电量监控已恢复" ;;
	test)
		# 测试邮件标题也带上当前状态（正文里本来就有房间/余额/阈值，标题保持一致更好认）；
		# 没房间或没数据时保持原样，不让标题出现半截信息。
		if [ -n "$ROOM_NUM" ] && [ -n "$_bal" ] && [ "$_bal" != "—" ] && [ "$_bal" != "-" ]; then
			echo "测试邮件：宿舍电量哨兵（OpenWrt 版）｜$ROOM_DISPLAY 剩余 $_bal $API_UNIT"
		else
			echo "测试邮件：宿舍电量哨兵（OpenWrt 版）"
		fi
		;;
	force) echo "$(level_icon "$_level") 宿舍电量当前状态：$ROOM_DISPLAY 剩余 $_bal $API_UNIT" ;;
	report)
		# 每日用电报告（powerfee report / main.report_time）
		if [ -n "$REPORT_TODAY" ]; then
			echo "📊 每日用电报告：$ROOM_DISPLAY 今日 $REPORT_TODAY $API_UNIT"
		else
			echo "📊 每日用电报告：$ROOM_DISPLAY"
		fi
		;;
	*)
		case "$_level" in
		low) echo "⚠️ 宿舍电费不足：$ROOM_DISPLAY 仅剩 $_bal $API_UNIT" ;;
		warn) echo "🔔 宿舍电量接近阈值：$ROOM_DISPLAY 剩余 $_bal $API_UNIT" ;;
		*) echo "宿舍电量：$ROOM_DISPLAY 剩余 $_bal $API_UNIT" ;;
		esac
		;;
	esac
}

mail_note() {
	# 给出「该做什么」的一句话；参数：<reason> <level> <余额> <失效小时数>
	case "$1" in
	stale) echo "路由器已连续 $4 小时无法从学校接口取到数据，请检查网络或接口是否变更。" ;;
	stale-ok) echo "路由器已重新取到数据，监控恢复正常。" ;;
	test) echo "这是一封测试邮件。收到它说明路由器的邮件通道已打通，余额不足时会收到同样格式的提醒。" ;;
	force) echo "这是一封手动触发的状态邮件（powerfee check --force）。" ;;
	report) echo "这是每日用电报告：今日用量 + 最近 ${REPORT_DAYS_N:-$REPORT_DAYS} 天曲线（main.report_time 定时发送，也可用 powerfee report 手动发）。" ;;
	recovered) echo "余额已回到阈值以上，感谢充值。" ;;
	warn | *-\>*warn) echo "余额已进入预警区（低于阈值 ${THRESHOLD}${API_UNIT} 的 ${WARN_RATIO} 倍），可以提前充值。" ;;
	*) echo "请尽快充值，避免余额耗尽停电。" ;;
	esac
}

mail_text_body() {
	# mail_text_body <level> <余额> <日均> <天数> <时间> <补充说明>
	local _level="$1" _bal="$2" _daily="$3" _days="$4" _ts="$5" _note="$6"
	echo "宿舍电量提醒"
	echo "============"
	echo ""
	echo "房间：$ROOM_DISPLAY${CAMPUS_SUFFIX:+（$CAMPUS_SUFFIX）}"
	echo "状态：$(level_icon "$_level") $(level_text "$_level")"
	echo "当前余额：$_bal $API_UNIT"
	echo "告警阈值：$THRESHOLD $API_UNIT"
	[ "$_daily" != "-" ] && echo "日均用量：约 $_daily $API_UNIT/天（近 72 小时估算）"
	[ "$_days" != "-" ] && echo "预计可用：约 $_days 天"
	echo ""
	[ -n "$_note" ] && { echo "$_note"; echo ""; }
	echo "查询时间：$_ts"
	echo "监控设备：$(dev_name)（宿舍电量哨兵 OpenWrt 版 v$VERSION）"
	echo ""
	echo "本邮件由路由器自动发送，请勿回复。"
}

mail_html_body() {
	# mail_html_body <level> <余额> <日均> <天数> <时间> <补充说明>
	local _level="$1" _bal="$2" _daily="$3" _days="$4" _ts="$5" _note="$6"
	local _color _icon _status _rows _note_html _chart_html
	_color=$(level_color "$_level")
	_icon=$(level_icon "$_level")
	_status=$(level_text "$_level")

	_rows="<tr><td style=\"padding:6px 12px 6px 0;color:#5f6368;white-space:nowrap\">房间</td><td style=\"padding:6px 0;color:#202124;font-weight:600\">$ROOM_DISPLAY${CAMPUS_SUFFIX:+（$CAMPUS_SUFFIX）}</td></tr>"
	_rows="$_rows<tr><td style=\"padding:6px 12px 6px 0;color:#5f6368;white-space:nowrap\">告警阈值</td><td style=\"padding:6px 0;color:#202124;font-weight:600\">$THRESHOLD $API_UNIT</td></tr>"
	[ "$_daily" != "-" ] && _rows="$_rows<tr><td style=\"padding:6px 12px 6px 0;color:#5f6368;white-space:nowrap\">日均用量</td><td style=\"padding:6px 0;color:#202124;font-weight:600\">约 $_daily $API_UNIT/天</td></tr>"
	[ "$_days" != "-" ] && _rows="$_rows<tr><td style=\"padding:6px 12px 6px 0;color:#5f6368;white-space:nowrap\">预计可用</td><td style=\"padding:6px 0;color:#202124;font-weight:600\">约 $_days 天</td></tr>"
	_rows="$_rows<tr><td style=\"padding:6px 12px 6px 0;color:#5f6368;white-space:nowrap\">查询时间</td><td style=\"padding:6px 0;color:#202124;font-weight:600\">$_ts</td></tr>"

	_note_html=""
	[ -n "$_note" ] && _note_html="<div style=\"margin-top:14px;padding:12px;background:#f8f9fa;border-left:3px solid $_color;border-radius:4px;color:#3c4043;font-size:14px\">$_note</div>"
	# 用量曲线（报告/告警邮件）：有 PNG 就内联显示，否则退回 render_html 的表格图
	_chart_html=$(mail_chart_block_html "最近 ${REPORT_DAYS} 天用电量")

	printf '%s' "<!DOCTYPE html><html><head><meta charset=\"utf-8\"></head>
<body style=\"margin:0;padding:16px;background:#f1f3f4;font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif\">
<div style=\"max-width:520px;margin:0 auto;background:#fff;border-radius:12px;overflow:hidden;border:1px solid #dadce0\">
<div style=\"background:$_color;padding:18px 20px;color:#fff\">
<div style=\"font-size:15px;opacity:.92\">$_icon $_status</div>
<div style=\"font-size:19px;font-weight:700;margin-top:6px\">$ROOM_DISPLAY</div>
</div>
<div style=\"padding:18px 20px\">
<div style=\"font-size:40px;font-weight:700;color:$_color;line-height:1.1\">$_bal<span style=\"font-size:16px;font-weight:400;color:#5f6368\"> $API_UNIT</span></div>
<table style=\"border-collapse:collapse;margin-top:14px;font-size:14px\">$_rows</table>
$_chart_html
$_note_html
</div>
<div style=\"padding:12px 20px;background:#f8f9fa;border-top:1px solid #dadce0;color:#80868b;font-size:12px\">
由 $(dev_name) 自动发送 · 宿舍电量哨兵 OpenWrt 版 v$VERSION<br>数据来自学校电费查询接口（只读查询，不做任何写操作）
</div></div></body></html>"
}

# ---- 曲线（报告与告警邮件 / 报告推送用）-------------------------------------
# 全局约定（report_chart_prepare 设置、mail_chart_reset 清空）：
#   MAIL_CHART_HTML  render_html 的表格图（HTML 片段，纯 ASCII）
#   MAIL_CHART_IMG   非空 = 有 PNG 内联图；MAIL_CHART_PNG 是文件路径
#   MAIL_CHART_CID   PNG 的 Content-ID（HTML 里的 <img src="cid:..."> 与它对应）
#   REPORT_TEXT_CHART / REPORT_SUMMARY_LINE / REPORT_TODAY / REPORT_SOURCE

mail_chart_reset() {
	MAIL_CHART_HTML=""
	MAIL_CHART_IMG=""
	MAIL_CHART_PNG=""
	MAIL_CHART_CID=""
	REPORT_TEXT_CHART=""
	REPORT_SUMMARY_LINE=""
	REPORT_TODAY=""
	REPORT_SOURCE=""
	return 0
}

mail_chart_block_html() {
	# mail_chart_block_html <标题>：曲线区块（有内联 PNG 优先，否则用表格图）
	local _title="$1"
	if [ -n "$MAIL_CHART_IMG" ]; then
		printf '<div style="margin-top:16px"><div style="font-size:13px;font-weight:bold;color:#2d3237;padding:0 0 6px 0">%s</div><img src="cid:%s" alt="每日用电量" width="600" style="max-width:100%%;border:1px solid #e9ecf0;border-radius:6px"></div>' "$_title" "$MAIL_CHART_CID"
	elif [ -n "$MAIL_CHART_HTML" ]; then
		printf '<div style="margin-top:16px"><div style="font-size:13px;font-weight:bold;color:#2d3237;padding:0 0 6px 0">%s</div>%s</div>' "$_title" "$MAIL_CHART_HTML"
	fi
	return 0
}

mail_chart_wanted() {
	# 哪些邮件带曲线：报告与余额告警带；test / stale 这类不带（别把每封邮件都撑大）
	case "$1" in
	test | stale | stale-ok) return 1 ;;
	esac
	return 0
}

report_chart_prepare() {
	# report_chart_prepare <天数> [quick]：给「当前房间」备好曲线（文本/HTML/PNG）
	# 任何一步失败都只记日志、不阻断（报告宁可少张图，也不能发不出去）。
	# quick=1：逐日接口超时压到 10 秒（告警邮件里现画，别拖慢发信）。
	local _days="$1" _quick="$2" _line
	mail_chart_reset
	[ -n "$_days" ] || _days="$REPORT_DAYS"
	usage_tmp_init || return 1
	if ! usage_prepare days "$_days" "$_quick"; then
		log_room "曲线未生成：没取到逐日用量（接口与本地采样都不可用）"
		return 1
	fi
	REPORT_SOURCE="$USAGE_SOURCE"
	case "$USAGE_SOURCE" in
	estimate) REPORT_SOURCE_TEXT="本地采样估算" ;;
	api) REPORT_SOURCE_TEXT="学校接口逐日数据" ;;
	*) REPORT_SOURCE_TEXT="—" ;;
	esac
	# 今日用量（本地采样；接口的逐日数据只到昨天）
	_line=$(usage_py today --history "$HISTORY_FILE" --interval "$INTERVAL" 2>/dev/null)
	REPORT_TODAY=$(printf '%s\n' "$_line" | sed -n 's/.*status=ok used=\([0-9.]*\).*/\1/p')
	REPORT_TEXT_CHART=$(usage_render text days "$_days" --width 48 --height 10 \
		--title "每日用电量" 2>/dev/null)
	REPORT_SUMMARY_LINE=$(printf '%s\n' "$REPORT_TEXT_CHART" | tail -2 | head -1)
	MAIL_CHART_HTML=$(usage_render html days "$_days" --width 600 --height 180 \
		--title "每日用电量" 2>/dev/null)
	if usage_png_write days "$_days" "$USAGE_TMP/chart.png" 640 240; then
		MAIL_CHART_PNG="$USAGE_TMP/chart.png"
		MAIL_CHART_IMG=1
		MAIL_CHART_CID="powerfee-chart-$(date +%s)-$$@powerfee"
	fi
	return 0
}

report_text_body() {
	# report_text_body <天数> <level> <余额>
	local _days="$1" _level="$2" _bal="$3" _ts
	_ts=$(date '+%Y-%m-%d %H:%M:%S %Z')
	echo "宿舍用电日报"
	echo "============"
	echo ""
	echo "房间：$ROOM_DISPLAY${CAMPUS_SUFFIX:+（$CAMPUS_SUFFIX）}"
	if [ -n "$REPORT_TODAY" ]; then
		echo "今日用量：$REPORT_TODAY $API_UNIT（截至 $(date +%H:%M)，本地采样估算）"
	else
		echo "今日用量：—（今天还没有采样点）"
	fi
	[ -n "$REPORT_SUMMARY_LINE" ] && echo "近 $_days 天：$REPORT_SUMMARY_LINE"
	echo "当前余额：${_bal:-—} $API_UNIT（$(level_icon "$_level") $(level_text "$_level")，阈值 $THRESHOLD $API_UNIT）"
	echo ""
	if [ -n "$REPORT_TEXT_CHART" ]; then
		printf '%s\n' "$REPORT_TEXT_CHART"
		echo ""
	fi
	echo "查询时间：$_ts"
	echo "监控设备：$(dev_name)（宿舍电量哨兵 OpenWrt 版 v$VERSION）"
	echo ""
	echo "本邮件由路由器自动发送，请勿回复。"
}

