#!/bin/sh /etc/rc.common
# ClawBot(微信) 推送服务 weclawbot-api —— procd 服务脚本
#
# 上游二进制把配置固定读作「相对当前目录的 ./config/auth.json」，
# 所以必须先 cd 到 /etc/weclawbot 再启动（凭据在 /etc/weclawbot/config/auth.json）。
#
# 扫码绑定 / 查看机器人列表：
#   cd /etc/weclawbot && weclawbot-api bot      # 控制台里 /login 扫码、/bots 列表
#
# 改端口：uci set weclawbot-api.main.port=26322 && uci commit weclawbot-api
#         /etc/init.d/weclawbot-api restart

START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled port

	config_load weclawbot-api
	config_get_bool enabled main enabled 1
	config_get port main port 26322

	[ "$enabled" = "1" ] || {
		logger -t weclawbot-api "配置 enabled=0，不启动（uci set weclawbot-api.main.enabled=1 后重启服务）"
		return 0
	}

	mkdir -p /etc/weclawbot/config

	procd_open_instance
	# 必须 cd 到 /etc/weclawbot：二进制按相对路径 ./config/auth.json 读凭据
	procd_set_param command /bin/sh -c "cd /etc/weclawbot && exec /usr/bin/weclawbot-api -port $port"
	# 进程意外退出时自动拉起（1 小时内崩 5 次则放弃，避免刷日志）
	procd_set_param respawn 3600 5 5
	# stdout/stderr 进 syslog：logread -e weclawbot-api 查看
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	logger -t weclawbot-api "启动：端口 $port，配置目录 /etc/weclawbot"
}

stop_service() {
	logger -t weclawbot-api "服务停止"
}

reload_service() {
	logger -t weclawbot-api "配置重载：重启服务"
	stop
	start
}
